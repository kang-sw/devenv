# Normalize line endings to LF on checkout for all platforms.
#
# The ws plugin ships text docs (skills, rsrc payloads, mental models) whose
# content is asserted byte-for-byte by the Go test suite. Without this, a
# Windows checkout under core.autocrlf converts them to CRLF, and shipped-doc
# content assertions (e.g. internal/mcp playbook tests) fail on Windows CI while
# passing on Linux/macOS. `text=auto` still lets git auto-detect and leave
# binary files untouched.
* text=auto eol=lf

# Generated single-file Pi extension bundle (scripts/bundle.mjs); review src/ instead.
agents-plugin-pi/dist/** linguist-generated=true -diff

# Producer-built native Pi closures; review the canonical Pi sources instead.
agents-plugin/native-pi/closure-manifest.json linguist-generated=true -diff
agents-plugin-wsflow/native-pi/closure-manifest.json linguist-generated=true -diff
agents-plugin/native-pi/closure.zip binary linguist-generated=true
agents-plugin-wsflow/native-pi/closure.zip binary linguist-generated=true
# Small generated first-party text keeps ordinary text diff/delta behavior.
agents-plugin*/native-pi/first-party/** linguist-generated=true
agents-plugin*/native-pi/first-party-manifest.json linguist-generated=true
# Owner (1209)=c 2026-11-16: byte-identical launcher copies are exempt from the size guard.
/agents-plugin/bin/ws-mcp-launcher.py -ws-size-guard
/agents-plugin-pi/bin/ws-mcp-launcher.py -ws-size-guard
/agents-plugin-wsflow/bin/ws-mcp-launcher.py -ws-size-guard
# Owner (1223)=a 2026-11-16: the rail script grew past 1000 lines; raise its own soft limit.
/agents-plugin-tool/internal/wsdashboard/assets/dashboard-rail.js ws-size-guard=1300
# Owner (130)=a 2026-11-18: one cohesive tool file at 1048 lines; raise its own soft limit.
/agents-plugin-tool/internal/mcp/whiteboard_tools.go ws-size-guard=1300

# Third-party minified bundle; not project source (not split, not counted).
agents-plugin-tool/internal/wswhiteboard/assets/mermaid/mermaid.min.js linguist-vendored
