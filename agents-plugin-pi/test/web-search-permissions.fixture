import assert from 'node:assert/strict';
import { writeFileSync, mkdtempSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { join } from 'node:path';
const { createReadOnlyRegistry } = await import(process.argv[2]);
assert.equal(process.permission.has('fs.write'), false);
assert.equal(process.permission.has('child'), false);
assert.throws(() => writeFileSync(join(process.env.TMPDIR, 'forbidden'), 'raw body'), { code: 'ERR_ACCESS_DENIED' });
assert.throws(() => mkdtempSync(join(process.env.TMPDIR, 'pi-web-access-proxy-')), { code: 'ERR_ACCESS_DENIED' });
assert.throws(() => spawnSync('curl', ['https://example.com']), { code: 'ERR_ACCESS_DENIED' });
const registry = await createReadOnlyRegistry();
const model = registry.getAll().find(model => model.provider === 'openai');
assert.ok(model);
const resolved = await registry.getApiKeyAndHeaders(model);
assert.equal(resolved.ok, true);
assert.equal(resolved.apiKey, 'owner-static-fixture-key');
const codex = registry.getAll().find(model => model.provider === 'openai-codex');
assert.ok(codex);
const codexAuth = await registry.getApiKeyAndHeaders(codex);
assert.equal(codexAuth.ok, true);
assert.equal(codexAuth.apiKey, 'owner-codex-fixture-token');
console.log('read-only-auth-ok');
