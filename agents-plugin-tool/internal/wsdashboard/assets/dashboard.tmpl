{{define "session"}}<!DOCTYPE html>
<html data-mode="{{.Mode}}" data-rid="{{.ReplyID}}" data-assets="{{.Assets.ID}}" data-wb-titlehost data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .SysOpen}} data-sysopen="1"{{end}}{{if .Hosted}} data-hosted="1"{{end}}{{if .HandedOff}} data-handed="1"{{end}}{{with .Terminal}} data-term="{{.}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{pwa .Theme}}
<title>{{template "stitle" .}}</title>
<style>{{.Assets.WhiteboardCSS}}</style>{{if .Terminal}}
<style>{{.Assets.XtermCSS}}</style>{{end}}
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.TrackerCSS}}</style></head>
<body class="dash {{.Mode}}">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}{{.Assets.LucideSprite}}<div class="dwrap">
<div class="top"><a class="back" id="railbtn" href="/" title="{{t "nav.sessions"}} (Ctrl+`)" aria-label="{{t "nav.sessions"}} (Ctrl+`)" aria-controls="rail" aria-expanded="false">{{icon "back"}}</a>{{region . "head"}}{{template "sse"}}{{template "qsslot"}}</div>
{{template "drawer" .}}
<div class="banner" id="dash-banner" hidden></div>
<div class="dbody"><aside id="rail" class="rail" aria-label="{{t "rail.title"}}">{{region . "rail"}}</aside><div class="rscrim" id="rscrim"></div>
<main id="grid" class="dgrid {{.Mode}}">
{{if .Adapter}}<nav id="tabbar" class="tabbar"><button data-tab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button data-tab="board" aria-pressed="false">{{icon "board"}}{{t "tab.board"}}<span class="tdot"></span></button></nav>
<section id="files" class="fpane" aria-label="{{t "tab.files"}}"></section>
{{region . "tree"}}
<div id="splitter" class="splitter" role="separator" aria-orientation="horizontal" aria-label="{{t "splitter.label"}}" tabindex="0" title="{{t "splitter.title"}}"></div>
<div id="chead" class="thead chead"><nav id="ctabs" class="ctabs" aria-label="{{t "tab.column"}}"><button type="button" data-ctab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button type="button" data-ctab="files" aria-pressed="false">{{icon "folder"}}{{t "tab.files"}}</button></nav><span class="csum"></span><span class="fsum"></span></div>
<div id="convo" class="convo">{{region . "entries"}}{{region . "convlive"}}{{if .Hosted}}<div class="apbox" id="apbox" hidden></div>{{end}}</div>
<div id="composer" class="composer"><div class="cbadges"><button type="button" class="ibadge" id="ibadge" title="{{t "js.interrupt.title"}}" hidden><span class="istop"></span><span class="ilabel">{{t "js.interrupt"}}</span></button>{{template "subbadge"}}</div>{{region . "ctx"}}{{if .SysOpen}}{{region . "cmds"}}{{end}}<div class="cimgs" id="cimgs"></div><div class="cchips" id="cchips"></div><div class="crow"><span class="ccmd" id="ccmd" title="{{t "composer.cmd.title"}}" hidden><b class="ccmd-name"></b><span class="ccmd-args" hidden></span><button type="button" class="unchip" data-uncmd title="{{t "composer.cmd.remove"}}" aria-label="{{t "composer.cmd.remove"}}">×</button></span><div class="cfield"><div class="chl" id="chl" aria-hidden="true"></div><textarea id="ctext" rows="1" aria-description="{{t "composer.aria"}}" placeholder="{{t "js.hint.enter"}}"></textarea></div><button type="button" class="csend" id="csend" title="{{t "composer.send"}}" aria-label="{{t "composer.send"}}">{{icon "send"}}</button></div><div class="cfoot">{{region . "sline"}}{{if .Terminal}}<span class="tslot" id="tslot"></span>{{end}}</div></div>
{{end}}<div id="bcol" class="bcol">{{region . "board"}}</div>
</main></div></div>
<script>{{i18n}}</script>
<script>{{.Assets.AnswersScript}}</script>
<script>window.wbForm = function () {
{{.Assets.FormScript}}};
window.wbMermaid = function () {
{{.Assets.MermaidInit}}};
window.wbMermaidFile = {{.Assets.MermaidFile}};</script>
<script>{{.Assets.ViewerScript}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.TrackerScript}}</script>
<script>{{.Assets.MentionScript}}</script>
<script>{{.Assets.RailScript}}</script>
<script>{{.Assets.CardsScript}}</script>
<script>{{.Assets.PreviewScript}}</script>
<script>{{.Assets.FilesScript}}</script>{{if .Terminal}}
<script>{{.Assets.TerminalScript}}</script>{{end}}
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{/* The tracker's quick-switcher slot: the tracker renderer puts its
search button and popup here when the page mounts it (dashboard.js). */}}
{{define "qsslot"}}<span class="qsslot" id="qsslot"></span>{{end}}

{{/* The stream indicator: a bare dot the page script turns off while the
stream is down. A session page whose head has a harness badge lights the
dot inside the badge instead (r-head), and the stylesheet hides this one. */}}
{{define "sse"}}<span class="sse" id="sse" title="{{t "js.sse.title.on"}}"><span class="dot"></span></span>{{end}}

{{/* The gear menu, the index page's settings popover. Its items
(gearitems) always hold the theme and language; full says the page has a
live adapter, which adds the layout and input items. The language options
come from the embedded tables, so a new table file adds one. A session page
shows the same items as the drawer's settings card (drcards). */}}
{{define "gear"}}<span class="gearwrap"><button class="btn gear" id="gear" title="{{if .}}{{t "gear.title"}}{{else}}{{t "gear.title.lang"}}{{end}}">{{icon "gear"}}</button><span class="gmenu" id="gmenu" hidden>{{template "gearitems" .}}</span></span>{{end}}

{{define "gearitems"}}{{if .}}<span class="gt">{{t "gear.layout"}}</span><button data-layout="auto" aria-pressed="false"><span class="gk">-</span><span>{{t "gear.layout.auto"}}<span class="gs">{{t "gear.layout.auto.sub"}}</span></span></button><button data-layout="split" aria-pressed="false"><span class="gk">A</span><span>{{t "gear.layout.split"}}<span class="gs">{{t "gear.layout.split.sub"}}</span></span></button><button data-layout="tabs" aria-pressed="false"><span class="gk">B</span><span>{{t "gear.layout.tabs"}}<span class="gs">{{t "gear.layout.tabs.sub"}}</span></span></button><span class="gt gt2">{{t "gear.input"}}</span><button data-input="enter" aria-pressed="false"><span class="gk">&crarr;</span><span>{{t "gear.input.enter"}}<span class="gs">{{t "gear.input.enter.sub"}}</span></span></button><button data-input="mod" aria-pressed="false"><span class="gk">^&crarr;</span><span>{{t "gear.input.mod"}}<span class="gs">{{t "gear.input.mod.sub"}}</span></span></button>{{end}}<span class="gt{{if .}} gt2{{end}}">{{t "gear.theme"}}</span><button data-theme-set="" aria-pressed="false"><span class="gk">&#9680;</span><span>{{t "gear.theme.auto"}}<span class="gs">{{t "gear.theme.auto.sub"}}</span></span></button><button data-theme-set="light" aria-pressed="false"><span class="gk">&#9675;</span><span>{{t "gear.theme.light"}}</span></button><button data-theme-set="dark" aria-pressed="false"><span class="gk">&#9679;</span><span>{{t "gear.theme.dark"}}</span></button><span class="gt gt2">{{t "gear.language"}}</span><select id="glang" aria-label="{{t "gear.language"}}"><option value="">{{t "gear.lang.auto"}}</option>{{range langs}}<option value="{{.Code}}">{{.Name}}</option>{{end}}</select><span class="gs gh">{{t "gear.lang.auto.sub"}}</span><span class="gn">{{t "gear.saved"}}</span>{{end}}

{{/* The drawer: the side panels pulled down from the top, over the page.
The panels region keeps arriving whole; the page script registers an entry per
panel it shows, and the sheet shows every present panel at once as a card. The
handle hangs from the top edge at the header's right end (the header pads its
right side clear of it), holds one icon per present panel, and rides the
sheet's bottom edge while open. The git handle (the git region) hangs left of
it and opens the same frame on the git drawer's sheet (gitbody) instead. */}}
{{define "drawer"}}<div class="drawer" id="drawer"><div class="dr-in"><div class="dr-clip" id="drclip"><div class="dr-sheet" id="drsheet" role="region" aria-label="{{t "drawer.panels"}}"><div class="dr-body" id="drbody">{{region . "panels"}}{{template "drcards" .}}</div>{{if .Git}}{{template "gitbody"}}{{end}}</div></div><button type="button" class="dr-handle" id="drhandle" aria-controls="drsheet" aria-expanded="false" title="{{t "js.drawer.open"}}" hidden><span class="dr-wait" title="{{t "js.drawer.waiting"}}">{{icon "lock"}}</span>{{icon "menu"}}<span class="tdot"></span></button>{{region . "git"}}</div></div>{{end}}

{{/* The git drawer's sheet (gitdrawer.go, gitlog.go, gitpush.go): the
commit graph, whose rows dashboard.js draws from the git log route, and the
action panel, whose standing line and changed-file list it fills from the git
status route; both each time the drawer opens on it and after each action. A
row opens the commit window (dashboard.js). Fetch, pull (fast-forward only),
and push; no commit action, and the graph is read-only. */}}
{{define "gitbody"}}<div class="dr-body gbody" id="gbody" hidden><section class="glog" id="glog" aria-label="{{t "git.graph"}}"><div class="ghead">{{icon "branch"}}<span class="gtitle">{{t "git.graph.title"}}</span><span class="gsub">{{t "git.graph.sub"}}</span><span class="chip" id="glcount" hidden></span></div><div class="glscroll" id="glscroll"><div class="glcols"><span>{{t "git.graph.col.graph"}}</span><span>{{t "git.graph.col.subject"}}</span><span>{{t "git.graph.col.author"}}</span><span class="r">{{t "git.graph.col.when"}}</span><span class="r">{{t "git.graph.col.commit"}}</span></div><div class="glrows" id="glrows"></div></div></section><section class="gpanel" aria-label="{{t "git.drawer"}}"><div class="ghead">{{icon "branch"}}<span class="gref" id="gref"></span></div><div class="gacts"><button type="button" class="btn gact" data-git="fetch" data-busy="{{t "git.fetch.busy"}}" title="{{t "git.fetch.title"}}">{{icon "fetch"}}<span>{{t "git.fetch"}}</span></button><button type="button" class="btn gact" data-git="pull" data-busy="{{t "git.pull.busy"}}" title="{{t "git.pull.title"}}">{{icon "pull"}}<span>{{t "git.pull"}}</span></button><button type="button" class="btn gact" data-git="push" data-busy="{{t "git.push.busy"}}" title="{{t "git.push.title"}}">{{icon "push"}}<span>{{t "git.push.go"}}</span></button></div><div class="gmsg" id="gmsg" role="status" data-lost="{{t "git.lost"}}" hidden></div><div class="gfiles" id="gfiles"></div></section></div>{{end}}

{{/* The drawer's own cards after the panels: the pooled worktrees, when
the daemon reads pools, the session holders, when the daemon runs them, and
the settings. They are no region: the page script fills the worktrees card
from the worktrees route each time the drawer opens, and the cleanup button
asks the session to clean the pool up (worktrees.go), which needs a live
adapter. It fills the holders card from the holders route (holders.go) on
the same openings: the holders no daemon is attached to, the ones not
restart-safe, and the failed holder starts; a stop button on an unattached
row, for a viewer the route lets stop one. */}}
{{define "drcards"}}{{if .Worktrees}}<details class="panel drcard wtcard" id="p-worktrees" open><summary>{{icon "branch"}}{{t "wt.title"}}<span class="chip" id="wtcount" hidden></span></summary><div class="body"><div class="wtlist" id="wtlist" aria-live="polite"></div><div class="wtfoot"><span class="wtnote" id="wtnote" role="status"></span><button type="button" class="btn wtclean" id="wtclean"{{if .Adapter}} title="{{t "wt.cleanup.title"}}"{{else}} disabled title="{{t "wt.cleanup.noadapter"}}"{{end}}>{{t "wt.cleanup"}}</button></div></div></details>{{end}}{{if .Holders}}<details class="panel drcard hdcard" id="p-holders" open><summary>{{icon "agents"}}{{t "hd.title"}}<span class="chip" id="hdcount" hidden></span></summary><div class="body"><div class="wtlist" id="hdlist" aria-live="polite"></div><div class="wtfoot"><span class="wtnote" id="hdnote" role="status"></span></div></div></details>{{end}}<details class="panel drcard setcard" id="p-settings" open><summary>{{icon "gear"}}{{t "drawer.settings"}}</summary><div class="body"><div class="gmenu gcard">{{template "gearitems" .Adapter}}</div></div></details>{{end}}

{{/* stitle is a session page's tab title: its display label, or its
reply-id when it has none. The head's name carries it too (data-title), so
the page script retitles the tab when a head swap brings a new label. */}}
{{define "stitle"}}{{or .Label .ReplyID}} - ws dashboard{{end}}

{{/* The head's session name (sname): the display label, or the reply-id
when the session has none, as a button whose click copies the session's
mailbox address (MailboxRef); its tooltip keeps the reply-id. A label
marks the name lbl, the body face (dashboard.css), as the rail and index
rows mark theirs. The pencil
beside it opens the page script's inline rename (dashboard.js labelStart),
which posts to the label route (label_route.go). */}}
{{define "sname"}}<span class="meta sname" data-label="{{.Label}}" data-max="{{.LabelMax}}" data-title="{{template "stitle" .}}"><button type="button" class="snm{{if .Label}} lbl{{end}}" data-copy="{{.MailboxRef}}" title="{{.ReplyID}}&#10;{{t "head.name.copy"}}">{{or .Label .ReplyID}}</button><button type="button" class="sren" title="{{t "head.rename"}}" aria-label="{{t "head.rename"}}">{{icon "pencil"}}</button>{{if .HasBoard}}<span class="sseq"> · #{{.Seq}}</span>{{end}}</span>{{end}}

{{define "r-head"}}<span class="meta">{{.ProjectName}}</span>{{template "sname" .}}{{with .Harness}}<span class="host sse{{if not $.ProcessRunning}} stopped{{end}}{{with $.Host}}{{if .Failure}} err{{end}}{{end}}" title="{{if $.ProcessRunning}}{{t "head.process.running"}}{{else}}{{t "head.process.stopped"}}{{end}}"><span class="dot"></span>{{.}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}{{with .Host}}{{with .Failure}}<span class="chip fail" title="{{.Text}}">{{template "noticeword" .Kind}}</span>{{end}}{{with .MCPBroken}}<span class="chip mcpbad" title="{{t "head.mcp.title"}} {{range $i, $s := .}}{{if $i}}, {{end}}{{$s}}{{end}}">{{t "head.mcp"}}</span>{{end}}{{end}}{{if not .Live}}<span class="ended-chip" title="{{t "head.ended.title"}}">{{t "head.ended"}}</span>{{end}}{{if not .Adapter}}<span class="nolive" title="{{t "head.stores.title"}}">{{t "head.stores"}}</span>{{end}}<span class="counts">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}</span>{{end}}

{{define "r-board"}}{{if .HasBoard}}{{.ThemedBoard}}{{else}}<div class="empty">{{t "board.empty"}}</div>{{end}}{{end}}

{{define "r-panels"}}{{.Panels}}{{end}}

{{define "phase"}}{{if eq . "permission"}}<span class="phase permission">{{icon "lock"}}{{t "phase.approval"}}</span>{{else if eq . "thinking"}}<span class="phase thinking"><span class="spin"></span>{{t "phase.thinking"}}</span>{{else if eq . "replying"}}<span class="phase replying"><span class="spin"></span>{{t "phase.replying"}}</span>{{else if eq . "tool"}}<span class="phase tool"><span class="spin"></span>{{t "phase.tool"}}</span>{{else if eq . "compacting"}}<span class="phase compacting"><span class="spin"></span>{{t "phase.compacting"}}</span>{{else}}<span class="phase idle"><span class="idle-dot"></span>{{t "phase.idle"}}</span>{{end}}{{end}}

{{define "dur"}}<time class="t" data-ms="{{.}}" data-f="since">{{clock .}}</time>{{end}}
{{define "ago"}}<time class="t" data-ms="{{.}}" data-f="ago">{{clock .}}</time>{{end}}
{{define "clock"}}<time class="t" data-ms="{{.}}" data-f="clock">{{clock .}}</time>{{end}}
{{define "span"}}<span class="t" data-span="{{.}}">{{spanText .}}</span>{{end}}

{{define "batch"}}{{if .Failed}}<li class="brow fail"><span class="mk">✗</span>{{else}}<li class="brow done"><span class="mk">✓</span>{{end}}<span class="bp">{{range .ToolNames}}<span class="tool" title="{{.}}">{{toolName .}}</span>{{end}}</span><span class="bm">{{tn "batch.calls" .CallCount}}{{with .Failed}} · {{t "count.failed" .}}{{end}} · {{template "ago" .EndedAt}}</span></li>{{end}}

{{/* The live rows: permrow a pending permission prompt, runrow the running
call, genrow a tool call streaming its arguments. liverows is a lead's
variable list (the expanded peer tree); slots a running agent's fixed rows
(AgentNode.Slots), where a slot with nothing set is a dim placeholder. */}}
{{define "permrow"}}<li class="brow live perm"><span class="mk">{{icon "lock"}}</span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.approval"}}{{with .ArgsPreview}} · {{.}}{{end}}</span></span><span class="bm">{{template "dur" .StartedAt}}</span></li>{{end}}

{{define "runrow"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{.ArgsPreview}}</span></span><span class="bm">{{with .OthersRunning}}+{{.}} · {{end}}{{template "dur" .StartedAt}}</span></li>{{end}}

{{define "genrow"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.args"}}</span></span><span class="bm">{{t "live.chars" .Chars}} · {{template "dur" .PhaseStartedAt}}</span></li>{{end}}

{{define "liverows"}}{{with .Permission}}{{template "permrow" .}}{{end}}{{with .Running}}{{template "runrow" .}}{{end}}{{with .Generating}}{{if eq .Kind "tool"}}{{template "genrow" .}}{{end}}{{end}}{{end}}

{{define "slots"}}{{range .}}{{if .Permission}}{{template "permrow" .Permission}}{{else if .Finished}}{{template "batch" .Finished}}{{else if .Running}}{{template "runrow" .Running}}{{else if .Generating}}{{template "genrow" .Generating}}{{else}}<li class="brow ph"><span class="mk">-</span></li>{{end}}{{end}}{{end}}

{{/* tphase is the agents panel's phase pill: phase without the spinner, since
in the panel only a live tool row spins and an agent's mark is a pulsing dot.
The session index row keeps phase. */}}
{{define "tphase"}}{{if or (eq . "thinking") (eq . "replying") (eq . "tool") (eq . "compacting")}}<span class="phase {{.}}">{{t (printf "phase.%s" .)}}</span>{{else}}{{template "phase" .}}{{end}}{{end}}

{{define "r-tree"}}<div class="thead">{{icon "agents"}}{{t "tree.agents"}}<span class="sum"><span class="chip">{{t "tree.running" .Tree.Running}}</span><span class="chip">{{t "tree.done" .Tree.Finished}}</span><span class="chip">{{t "tree.failed" .Tree.Failed}}</span><span class="chip">{{icon "mail"}}{{len .Tree.Peers.Live}}</span>{{with .Host}}{{with .BackgroundTasks}}<span class="chip bgt" title="{{t "tree.bg.title"}}">{{tn "tree.bg" .}}</span>{{end}}{{end}}</span></div><div class="tree"><div class="agent root {{.Lead.Phase}}"><details data-key="agent-lead"><summary class="ahead"><span class="amk">{{template "mark" .Lead.Phase}}</span><span class="aname">{{t "tree.lead"}}</span>{{template "tphase" .Lead.Phase}}<span class="ldet">{{if .Lead.Permission}}<span class="tn" title="{{.Lead.Permission.ToolName}}">{{toolName .Lead.Permission.ToolName}}</span> <span class="args">{{.Lead.Permission.ArgsPreview}}</span>{{else if .Lead.Running}}<span class="tn" title="{{.Lead.Running.ToolName}}">{{toolName .Lead.Running.ToolName}}</span> <span class="args">{{.Lead.Running.ArgsPreview}}</span>{{else if and .Lead.Generating (eq .Lead.Generating.Kind "tool")}}<span class="tn" title="{{.Lead.Generating.ToolName}}">{{toolName .Lead.Generating.ToolName}}</span> <span class="args">{{t "live.args"}}</span>{{end}}</span><span class="am">{{if .Lead.Permission}}{{template "dur" .Lead.Permission.StartedAt}}{{else if .Lead.Running}}{{template "dur" .Lead.Running.StartedAt}}{{else if and .Lead.PhaseStartedAt (or (eq .Lead.Phase "thinking") (eq .Lead.Phase "replying") (eq .Lead.Phase "tool") (eq .Lead.Phase "compacting"))}}{{template "dur" .Lead.PhaseStartedAt}}{{end}}<span title="{{t "tree.batches.title"}}">{{tn "tree.batches" (len .Lead.Finished)}}</span>{{icon "chev"}}</span></summary><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}</ol></details><div class="kids">{{range .Tree.Agents}}{{template "agent" .}}{{end}}{{template "peers" .Tree.Peers}}</div></div></div>{{end}}

{{define "mark"}}{{if eq . "permission"}}{{icon "lock"}}{{else if or (eq . "idle") (eq . "")}}<span class="idle-dot"></span>{{else}}<span class="pulse"></span>{{end}}{{end}}

{{define "agent"}}<div class="agent {{.Status}}"><details data-key="agent-{{.ID}}"><summary class="ahead"><span class="aline"><span class="amk">{{if .IsRunning}}{{if eq .AgentKind "pi"}}<span class="pibadge" title="{{t "agent.pi"}}">pi</span>{{else}}<span class="pulse"></span>{{end}}{{else if eq .Status "failed"}}✗{{else}}✓{{end}}</span><span class="aname" title="{{or .Label .ID}}">{{if .Label}}{{.Label}}{{else}}{{t "agent.name" (shortID .ID)}}{{end}}</span>{{with .ReplyID}}{{if $.Linked}}<a class="arid" href="/s/{{.}}" title="{{t "agent.open" .}}">{{shortID .}}</a>{{else}}<span class="arid nob" title="{{.}}">{{shortID .}}</span>{{end}}{{end}}{{if .IsRunning}}{{template "tphase" .Phase}}{{end}}{{with .Caption}}<span class="acap" title="{{.}}">{{.}}</span>{{end}}</span>{{template "astat" .}}<span class="am"><span class="ok" title="{{t "agent.done"}}">✓ {{.Done}}</span><span class="{{if .Failed}}f{{end}}" title="{{t "agent.failed"}}">✗ {{.Failed}}</span>{{if .IsRunning}}{{with .StartedAt}}<span>{{template "dur" .}}</span>{{end}}{{else}}{{with .EndedAt}}<span>{{template "ago" .}}</span>{{end}}{{end}}{{icon "chev"}}</span></summary><ol class="brows">{{range .Finished}}{{template "batch" .}}{{end}}</ol></details>{{if .IsRunning}}<ol class="brows live bguide">{{template "slots" .Slots}}</ol>{{end}}{{with .Children}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}</div>{{end}}

{{/* astat is a subagent row's telemetry: model and effort, context size,
and (while it runs) output rate, each left out while unknown. On a narrow
agents panel a container query moves it to a second line under the row
name; aline wraps the leading items so that line can sit below them. */}}
{{define "astat"}}{{if .HasStats}}<span class="astat">{{with .ModelText}}<span class="amodel" title="{{t "agent.model" .}}">{{.}}</span>{{end}}{{with .ContextText}}<span class="actx" title="{{t "agent.context" $.ContextTokens}}">{{.}}</span>{{end}}{{with .Rate}}<span class="atps" title="{{t "agent.rate" .}}">{{.}} t/s</span>{{end}}</span>{{end}}{{end}}

{{define "peers"}}<div class="pgroup"><div class="pghead">{{icon "mail"}}{{t "peers.title"}}<span class="chip">{{len .Live}}</span>{{with .Ended}}<span class="chip">{{t "peers.ended" (len .)}}</span>{{end}}</div>{{range .Rows}}{{template "peer" .}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "peers.hidden" .}}</div>{{end}}</div>{{end}}

{{define "pfolder"}}{{with .Folder}}<span class="pfolder">{{.}}/</span>{{end}}{{end}}

{{/* pbranch is a served peer's branch chip, drawn as the session page's git
handle draws a branch: goal and impl branches by their last segment with
their marks, a detached HEAD by its commit with the detached title, and no
chip for a root that is no repository. */}}
{{define "pbranch"}}{{with .BranchHandle}}{{if .Text}}<span class="pbr" title="{{if $.Detached}}{{t "git.detached" $.Branch}}{{else}}{{$.Branch}}{{end}}">{{if .Goal}}<span class="gh-goal">{{icon "trophy"}}</span>{{end}}{{if .Impl}}<span class="gh-impl">{{icon "hammer"}}</span>{{end}}{{if not (or .Goal .Impl)}}{{icon "branch"}}{{end}}<span class="pbt">{{.Text}}</span></span>{{end}}{{end}}{{end}}

{{/* peerrow is a peer's one-line row. A row whose name is a manual label
(PeerRow.Label) carries the labeled class on its peer element, and the
stylesheet then gives way in a fixed order as the row narrows: the harness
badge (phost, which wraps it so the badge's padding collapses too), the tool
text, the phase pill, the branch chip, and the name last. */}}
{{define "peerrow"}}<span class="amk">{{if and .Live .Adapter}}{{template "mark" .Lead.Phase}}{{else}}<span class="pdot"></span>{{end}}</span>{{if .Served}}<a class="pname" href="/s/{{.ReplyID}}"{{with .Title}} title="{{.}}"{{end}}>{{template "pfolder" .}}{{.Name}}</a>{{else}}<span class="pname"{{with .Title}} title="{{.}}"{{end}}>{{template "pfolder" .}}{{.Name}}</span>{{end}}{{template "pbranch" .}}{{if and .Harness .Live}}<span class="phost"><span class="host sm">{{.Harness}}</span></span>{{end}}{{if not .Compact}}<span class="pline">{{if not .Live}}<span class="pstate">{{t "head.ended"}}</span>{{else if not .Served}}<span class="pstate">{{t "peer.unserved"}}</span>{{else if .Adapter}}{{template "tphase" .Lead.Phase}}{{with .Lead.Running}}<span class="ptool" title="{{.ToolName}}">{{toolName .ToolName}}</span>{{end}}{{end}}</span>{{end}}<span class="am">{{if .RunningAgents}}<span class="prun" title="{{tn "peer.running" .RunningAgents}}">{{icon "agents"}}{{.RunningAgents}}</span>{{end}}{{if and .Adapter (not .Compact)}}<span title="{{t "peer.subagents"}}">{{icon "agents"}}{{.AgentCount}}</span>{{end}}<span title="{{t "peer.lastmail"}}">{{icon "mail"}}{{template "ago" .LastExchange}}</span></span>{{end}}

{{/* subbadge is the running-subagent badge on the composer's top border,
beside the interrupt badge: the page script fills its label from a convlive
region's data-sub and data-subdeep and hides it while nothing runs. Any
composer that shows a session's conversation may carry it; the tracker's
support chat card builds the same markup, without the id, in script
(supChat). */}}
{{define "subbadge"}}<span class="sbwrap"><span class="sbadge" id="sbadge" title="{{t "js.subagents.title"}}" hidden><span class="spin"></span>{{icon "agents"}}<span class="slabel"></span></span><span class="bgbadge" id="bgbadge" title="{{t "tree.bg.title"}}" hidden>{{icon "clock"}}<span class="blabel"></span></span><span class="bgbadge" id="monbadge" title="{{t "tasks.monitors.title"}}" hidden>{{icon "clock"}}<span class="blabel"></span></span></span>{{end}}

{{define "peer"}}{{if and .Served .Adapter (not .Compact)}}<details class="peer {{if .Live}}live{{else}}ended{{end}}{{if .Label}} labeled{{end}}" data-peer="{{.ReplyID}}"><summary>{{template "peerrow" .}}</summary><div class="ptree"><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}{{template "liverows" .Lead}}</ol>{{with .Agents}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}</div></details>{{else}}<div class="peer {{if .Live}}{{if .Compact}}live compact{{if not .Adapter}} nophase{{end}}{{else if .Served}}live nophase{{else}}unserved{{end}}{{else}}ended{{end}}{{if .Label}} labeled{{end}}">{{template "peerrow" .}}</div>{{end}}{{end}}

{{/* The conversation's two regions share the #convo scroll wrapper. entries
holds the finished messages, each keyed by data-entry (its ring entry name);
the page merges it by key and never re-renders an entry it shows. convlive is
the rest, swapped whole: a streaming tick changes it alone. Its data-phase is
the lead's phase, which shows or hides the composer's interrupt badge;
data-turn, present while a turn runs, is that turn's start stamp, which
re-enables the badge when a new turn starts right after an interrupted one;
and data-sub and data-subdeep the running subagents (SubagentCount), which
drive the subagent badge beside it. */}}
{{define "r-entries"}}<div class="thead">{{icon "chat"}}{{t "tab.conversation"}}<span class="sum"><span class="chip">{{t "convo.user" .Conversation.Users}}</span><span class="chip">{{icon "mail"}}{{.Conversation.Mails}}</span></span></div><div class="conv centries">{{range .Conversation.Entries}}{{.Rendered}}{{end}}</div>{{end}}

{{define "r-convlive"}}<div class="conv clive" data-phase="{{.Conversation.Phase}}" data-sub="{{.Conversation.Subagents.Direct}}" data-subdeep="{{.Conversation.Subagents.Deep}}"{{with .Lead.TurnStartedAt}} data-turn="{{.}}"{{end}} data-bg="{{.Background}}" data-monitors="{{.Monitors}}">{{with .Conversation}}{{with .ToolGap}}<details class="toolsline live" data-key="tools-live"><summary>{{icon "chev"}}{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{with .Reply}}<div class="msg fromlead streaming"><div class="mh"><b>{{t "tree.lead"}}</b>{{template "clock" .StartedAt}}</div><div class="bub md">{{$.Conversation.ReplyHTML}}{{if .Truncated}} …{{end}}<span class="caret"></span></div></div>{{end}}{{if .Permission}}<div class="permwait{{if $.Hosted}} apslot{{end}}">{{icon "lock"}}<span><b>{{if $.Hosted}}{{t "convo.approval"}}{{else}}{{t "convo.perm"}}{{end}}</b> · <code title="{{.Permission.ToolName}}">{{toolName .Permission.ToolName}}</code> <span class="args">{{.Permission.ArgsPreview}}</span></span>{{template "dur" .Permission.StartedAt}}</div>{{else if eq .Phase "compacting"}}<div class="sysline compaction running"><span class="mk"><span class="spin"></span></span>{{t "convo.compacting"}}{{with $.Lead.PhaseStartedAt}}{{template "dur" .}}{{end}}</div>{{else if and .Phase (ne .Phase "idle") (ne .Phase "replying")}}<div class="activity"><span class="spin"></span>{{t "convo.activity" (phaseWord .Phase)}}{{with .Running}} · {{toolName .ToolName}}{{else}}{{with .Generating}}{{with .ToolName}} · {{toolName .}}{{end}}{{end}}{{end}}</div>{{end}}{{with $.Host}}{{with .Retry}}<div class="sysline retry running"><span class="mk"><span class="spin"></span></span><span class="nt">{{if .MaxRetries}}{{t "convo.retry" .Attempt .MaxRetries}}{{else}}{{t "convo.retry.n" .Attempt}}{{end}}{{with .Error}}: {{.}}{{end}}</span></div>{{end}}{{end}}{{range .Held}}{{template "held" .}}{{end}}<div class="sentdata" hidden>{{range .Sent}}<i data-id="{{.ID}}" data-answer="{{.Answer}}" data-note="{{.Note}}" data-state="{{if .Held}}held{{else}}sent{{end}}"></i>{{end}}</div>{{end}}</div>{{end}}

{{/* The status band (pageview_band.go): ctx is the context bar above the
message box, sline the folder, limits, and cost below it. A part with no
figure is left out; an empty region collapses. */}}
{{define "r-ctx"}}{{with .Band.Context}}<div class="sb sb-top"><span class="sb-ctx{{with .Level}} {{.}}{{end}}" role="meter" aria-label="{{t "band.ctx.aria"}}" aria-valuemin="0" aria-valuemax="100"{{if .Known}} aria-valuenow="{{.Fill}}"{{end}} title="{{if .Known}}{{t "band.ctx.title" .Percent .Tokens}}{{else}}{{t "band.ctx.unknown" .Tokens}}{{end}}"><span class="sb-pct">{{if .Known}}{{.Percent}}%{{else}}?{{end}}</span><span class="sb-bar"><i style="width: {{.Fill}}%"></i><u class="t80"></u><u class="t95"></u></span><span class="sb-tok">{{.Tokens}}</span>{{with .Flag}}<span class="sb-flag">{{flagText .}}</span>{{end}}{{with .Cache}}<span class="sb-cache" title="{{t "band.cache.title"}}">{{t "band.cache" .}}</span>{{end}}</span></div>{{end}}{{end}}

{{/* cmds: the slash commands the session's adapter runs, hidden data the
composer's command picker reads (dashboard.js commandList); empty when the
adapter reports none, and then the page offers no picker. The session page
carries it for a browser on this machine only (SysOpen), since the daemon
holds a dashboard command from no other viewer (sendCommand). */}}
{{define "r-cmds"}}{{range .Commands}}<i data-name="{{.Name}}"{{with .Description}} data-desc="{{.}}"{{end}}{{with .Source}} data-src="{{.}}"{{end}}{{with .Layer}} data-layer="{{.}}"{{end}}></i>{{end}}{{end}}

{{define "r-sline"}}{{with .Band}}{{if not .Empty}}<div class="sb sb-foot">{{with .Repo}}{{with .Folder}}<span class="sb-dir" title="{{t "band.folder" .}}">{{icon "folder"}}<span>{{.}}</span></span>{{end}}{{end}}{{if or .Limits .Cost}}<span class="sb-tail">{{range .Limits}}{{template "limit" .}}{{end}}{{with .Cost}}<span class="sb-cost" title="{{t "band.cost"}}">{{.}}</span>{{end}}</span>{{end}}</div>{{end}}{{end}}{{end}}

{{/* The git handle (gitbadge.go): the drawer handle left of the side-panel
handle, which opens the git drawer (gitbody). It shows the session root's
branch abbreviated (GitHandle: a hammer for an impl branch, a gold trophy for a
goal branch, each with the stem), the ahead and behind counts against its
upstream, and a dot for a dirty working tree; its title spells the whole
branch and the title of the ticket the stem names. A root that is no
repository has none. at carries the read's time, so every read swaps the
region. */}}
{{define "r-git"}}{{with .Git}}{{if ne .State "norepo"}}<button type="button" class="gh {{.State}}" id="ghandle" aria-controls="drsheet" aria-expanded="false" data-at="{{.At}}" title="{{if eq .State "failed"}}{{t "git.failed.title" .Err}}{{else if eq .State "pending"}}{{t "git.pending"}}{{else}}{{if .Detached}}{{t "git.detached" .Branch}}{{else}}{{.Branch}}{{end}}{{with .Ticket}}&#10;{{.}}{{end}}{{if or .Modified .Staged .Untracked}}&#10;{{t "git.dirty"}}{{end}}{{end}}">{{if eq .State "ok"}}{{with .Handle}}{{if .Goal}}<span class="gh-goal">{{icon "trophy"}}</span>{{end}}{{if .Impl}}<span class="gh-impl">{{icon "hammer"}}</span>{{end}}{{if not (or .Goal .Impl)}}{{icon "branch"}}{{end}}<span class="gh-br">{{.Text}}</span>{{end}}{{if or .Ahead .Behind}}<span class="gh-ab">{{with .Ahead}}<b class="up">↑{{.}}</b>{{end}}{{with .Behind}}<b class="dn">↓{{.}}</b>{{end}}</span>{{end}}{{if or .Modified .Staged .Untracked}}<span class="gh-dirty"></span>{{end}}{{else}}{{icon "branch"}}<span class="gh-br">{{if eq .State "failed"}}{{t "git.failed"}}{{else}}…{{end}}</span>{{end}}</button>{{end}}{{end}}{{end}}

{{define "limit"}}<span class="sb-use{{with .Level}} {{.}}{{end}}{{if .Both}} both{{end}}{{if .Hi}} hi{{end}}" data-limit="{{.Kind}}" title="{{t "band.limit" (limitName .Name) .Percent}}"><span class="u-pct">{{.Percent}}%</span>{{if .ResetsAt}}/<time class="t" data-ms="{{.ResetsAt}}" data-f="{{.ResetFormat}}">{{.ResetText}}</time><em class="u-pace" data-reset="{{.ResetsAt}}" data-win="{{.WindowSec}}" data-pct="{{.Percent}}"></em>{{end}}</span>{{end}}

{{/* held: a message the session has not received yet. A slash command's
bubble shows its typed line and no steer control, since a command waits for
the turn end. */}}
{{define "held"}}<div class="msg user held{{if .Command}} hcmd{{end}}" data-entry="{{.ID}}"><div class="mh"><span class="src wb">{{t "origin.whiteboard"}}</span>{{if .Steer}}<span class="heldtag steertag" title="{{t "held.steer.title"}}">{{t "held.steer"}}</span>{{else}}<span class="heldtag" title="{{t "held.held.title"}}">{{t "held.held"}}</span>{{end}}{{template "clock" .At}}{{if not (or .Steer .Command)}}<button class="btn mini hsteer" data-steer="{{.ID}}" title="{{t "held.steerbtn.title"}}">{{icon "arrow"}}{{t "held.steer"}}</button>{{end}}<button class="btn mini hcancel" data-cancel="{{.ID}}" title="{{t "held.cancel.title"}}">{{icon "x"}}{{t "held.cancel"}}</button></div><div class="bub">{{with .Command}}<code class="cmdtyped">/{{.Name}}{{with .Args}} {{.}}{{end}}</code>{{else}}{{template "achips" .}}{{range $i, $p := .Parts}}{{if $i}}<hr class="pdiv">{{end}}<div class="hpart">{{marked $p}}</div>{{end}}{{with .Images}}{{template "thumbs" .}}{{end}}{{end}}</div></div>{{end}}
{{/* achips: a user message's answer capsules, above its text, styled as the
composer's chips: "(ids) value" with the note beside it, a topic note as
"[topic]" and its note. A held bubble lists one per chip, a delivered one
one per line of the answer block its text started with. The message's
mentions follow as "[topic] (id)" and an excerpt of the selected text. */}}
{{define "achips"}}{{if or .Answers .Mentions}}<div class="hchips">{{range .Answers}}{{if .Topic}}<span class="achip tchip"><b>[{{.Topic}}]</b><span class="anote" title="{{.Note}}">{{.Note}}</span></span>{{else}}<span class="achip"><b>({{.IDs}})</b> {{or .Value "note"}}{{with .Note}}<span class="anote" title="{{.}}">{{.}}</span>{{end}}</span>{{end}}{{end}}{{range .Mentions}}<span class="achip mchip" title="{{.Text}}"><b>[{{.Topic}}]{{with .ID}} ({{.}}){{end}}</b><span class="anote">{{.Text}}</span></span>{{end}}</div>{{end}}{{end}}

{{define "thumbs"}}<div class="thumbs">{{range .}}{{if .Src}}<a class="thumb" href="{{.Src}}" target="_blank" rel="noopener noreferrer" title="{{.Path}}"><img src="{{.Src}}" alt="{{.Name}}" loading="lazy">{{with .Num}}<span class="tnum">#{{.}}</span>{{end}}</a>{{else}}<span class="ipath">{{if .Num}}Image #{{.Num}}: {{.Path}}{{else}}[image: {{.Path}}]{{end}}</span>{{end}}{{end}}</div>{{end}}

{{define "origin"}}{{if eq . "whiteboard"}}<span class="src wb">{{t "origin.whiteboard"}}</span>{{else if eq . "mail"}}<span class="src mail">{{t "origin.mail"}}</span>{{else if eq . "terminal"}}<span class="src">{{t "origin.terminal"}}</span>{{end}}{{end}}

{{define "entry"}}{{if eq .Kind "user"}}<div class="msg user" data-entry="{{.Key}}"><div class="mh">{{template "origin" .Origin}}{{template "clock" .At}}</div><div class="bub">{{template "achips" .}}{{marked .Text}}{{if .Truncated}} …{{end}}{{with .Images}}{{template "thumbs" .}}{{end}}</div></div>{{else if eq .Kind "reply"}}<div class="msg fromlead" data-entry="{{.Key}}"><div class="mh"><b>{{t "tree.lead"}}</b>{{template "clock" .At}}</div><div class="bub md">{{.HTML}}{{if .Truncated}} …{{end}}</div></div>{{else if eq .Kind "wake"}}{{template "wakeentry" .}}{{else if eq .Kind "turn"}}<div class="turnline{{if .WakeTurn}} wake-turn{{end}}" data-entry="{{.Key}}">{{if .WakeTurn}}↳ {{t "entry.leadturn" .Done}}{{else}}{{template "origin" .Origin}}{{t "entry.turn" .Done}}{{end}}{{with .Failed}} · {{t "count.failed" .}}{{end}}{{with .DurationMs}} · {{template "span" .}}{{end}}</div>{{else if eq .Kind "tools"}}{{with .Tools}}<details class="toolsline" data-entry="{{$.Key}}" data-key="tools-{{$.Key}}"><summary>{{icon "chev"}}{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{else if eq .Kind "compact"}}<div class="sysline compaction{{if .CompactFailed}} fail{{end}}" data-entry="{{.Key}}">{{if .CompactFailed}}<span class="mk">✗</span><span class="nt">{{t "entry.compact.failed"}}{{with .Text}}: {{.}}{{end}}</span>{{else}}<span class="mk">✓</span>{{t "entry.compact.done"}}{{if eq .Trigger "auto"}} {{t "entry.compact.auto"}}{{else if eq .Trigger "manual"}} {{t "entry.compact.manual"}}{{end}}{{end}}{{template "clock" .At}}</div>{{else if eq .Kind "mail"}}{{if .HasBody}}<details class="mailline {{.Direction}}" data-entry="{{.Key}}" data-key="mail-{{.Key}}"><summary>{{template "mailhead" .}}</summary><div class="mbody">{{.Body}}</div></details>{{else}}<div class="mailline {{.Direction}} nobody" data-entry="{{.Key}}">{{template "mailhead" .}}</div>{{end}}{{else if eq .Kind "card"}}{{with .Card}}<div class="cardref" data-entry="{{$.Key}}" data-tk-store="{{.Store}}" data-tk-alias="{{.Alias}}" title="{{t "entry.card.title" .Store}}"><span class="crk">{{t "entry.card"}}</span><b class="cra">{{.Alias}}</b>{{with .Title}}<span class="crt">{{.}}</span>{{end}}</div>{{end}}{{else if eq .Kind "notice"}}{{with .Notice}}<div class="sysline notice fail" data-entry="{{$.Key}}" data-notice="{{.Kind}}"><span class="mk">✗</span><span class="nt"><b>{{template "noticeword" .Kind}}</b>{{if and (eq .Kind "usage_limit") (gt .ResetsAt 0)}} · {{t "notice.resets"}} <time class="t" data-ms="{{.ResetsAt}}" data-f="dt">{{clock .ResetsAt}}</time>{{end}}{{with .Text}}: {{.}}{{end}}</span>{{template "clock" $.At}}</div>{{end}}{{else if eq .Kind "command"}}<div class="cmdrun" data-entry="{{.Key}}"><div class="cmdecho"><span class="mk">❯</span><code>{{.Command}}</code>{{template "clock" .At}}</div>{{if .Text}}<pre class="cmdout">{{.Text}}{{if .Truncated}} …{{end}}</pre>{{else}}<div class="cmdnote">{{t "entry.command.terminal"}}</div>{{end}}</div>{{else if eq .Kind "ui"}}{{with .UI}}<div class="sysline uiline" data-entry="{{$.Key}}" data-ui-op="{{.Op}}" data-ui-arg="{{.Arg}}"{{with .Comment}} data-ui-comment="{{.}}"{{end}} title="{{t "entry.ui"}}"><span class="mk">↗</span>{{if eq .Op "search"}}{{t "entry.ui.search" .Arg}}{{else if eq .Op "focus"}}{{with .Comment}}{{t "entry.ui.focus.comment" $.UI.Arg .}}{{else}}{{t "entry.ui.focus" .Arg}}{{end}}{{else if eq .Op "scope"}}{{t "entry.ui.scope" .Arg}}{{else}}{{t "entry.ui.view" .Arg}}{{end}}</div>{{end}}{{end}}{{end}}

{{define "wakeentry"}}{{if or (eq .Cause "subagent_done") (eq .Cause "subagent_failed") (eq .Cause "background_exit")}}<div class="wake-divider{{if eq .Cause "subagent_failed"}} fail{{end}}" data-entry="{{.Key}}"><span>{{with .Source}}<b>{{.}}</b> · {{end}}{{or .Caption .Cause}}{{template "clock" .At}}</span></div>{{else}}<details class="wake-card" data-entry="{{.Key}}" data-key="wake-{{.Key}}"><summary><span class="wake-head"><b>{{or .Source .Cause}}</b>{{template "clock" .At}}</span><span class="wake-caption">{{or .Caption .Cause}}</span></summary>{{with .Text}}<pre class="wake-body">{{.}}{{if $.Truncated}} …{{end}}</pre>{{end}}</details>{{end}}{{end}}

{{/* noticeword names a typed failure's kind (wslive.Notice): a notice
line, the head's failure chip, and a rail row's error ring title. */}}
{{define "noticeword"}}{{if eq . "login"}}{{t "notice.login"}}{{else if eq . "model"}}{{t "notice.model"}}{{else}}{{t "notice.limit"}}{{end}}{{end}}

{{/* toolsum and toolbatches draw a ToolSummary: the lead's finished tool calls between two conversation entries (a tools ring entry), or so far in the open stretch (convlive). */}}
{{define "toolsum"}}<span class="tsum"><span class="tsl">{{range $i, $t := .Tools}}{{if $i}} · {{end}}<span title="{{$t.Name}}">{{toolName $t.Name}}</span> {{$t.Calls}}{{end}}{{with .OtherCalls}}{{if $.Tools}} · {{t "tools.rest" .}}{{else}}{{t "tools.calls" .}}{{end}}{{end}}</span>{{if or .Failed .DurationMs .Usage}}<span class="tsn">{{with .Failed}}<b class="tf">{{t "count.failed" .}}</b>{{end}}{{with .DurationMs}}{{if $.Failed}} · {{end}}{{template "span" .}}{{end}}{{with .Usage}}{{if or $.Failed $.DurationMs}} · {{end}}<span class="ttok" title="{{tokenTitle (requests $) .}}">{{tokenText (requests $) .}}</span>{{end}}</span>{{end}}</span>{{end}}
{{define "toolbatches"}}<ol class="brows">{{range .Batches}}{{$args := batchArgs .}}{{$list := argsList .}}<li class="brow {{if .Failed}}fail{{else}}done{{end}}"><span class="mk">{{if .Failed}}✗{{else}}✓{{end}}</span><span class="bp{{if $args}} one{{end}}"{{with $list}} title="{{.}}"{{end}}>{{if .Tools}}{{range .Tools}}<span class="tool"{{if not $list}} title="{{.Name}}"{{end}}>{{toolName .Name}}{{if gt .Calls 1}}<b class="x">×{{.Calls}}</b>{{end}}</span>{{end}}{{else}}{{range .Names}}<span class="tool"{{if not $list}} title="{{.}}"{{end}}>{{toolName .}}</span>{{end}}{{end}}{{with $args}}<span class="ba" title="{{.}}">{{.}}</span>{{end}}</span><span class="bm">{{range batchNums .}}{{.Sep}}<span{{with .Class}} class="{{.}}"{{end}} title="{{.Title}}">{{.Text}}</span>{{end}}</span></li>{{end}}{{with .BatchesOmitted}}<li class="brow more"><span class="mk"></span><span class="bp">{{t "tools.more" .}}</span><span class="bm"></span></li>{{end}}</ol>{{end}}
{{define "mailhead"}}<span class="arr">{{if eq .Direction "sent"}}→{{else}}←{{end}}</span>{{if .PeerLinked}}<a class="mpeer" href="/s/{{.PeerReplyID}}"{{if .PeerLabel}} title="{{.Peer}}"{{end}}>{{or .PeerLabel .Peer}}</a>{{else}}<span class="mpeer">{{.Peer}}</span>{{end}}<span class="mfirst">: {{.Title}}</span>{{template "clock" .At}}{{end}}

{{define "index"}}<!DOCTYPE html>
<html data-mode="index" data-assets="{{.Assets.ID}}" data-wb-titlehost data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .Local}} data-sysopen="1"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{pwa .Theme}}
<title>ws dashboard</title>
<style>{{.Assets.WhiteboardCSS}}</style>
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.TrackerCSS}}</style></head>
<body class="dash index">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}<div class="dwrap narrow">
<div class="top"><h1>ws dashboard</h1><span class="meta">v{{.Version}}</span>{{template "sse"}}{{template "qsslot"}}{{template "gear" false}}</div>
{{with .LAN}}<div class="lanbox"><b>{{t "lan.on"}}</b> {{t "lan.open"}}{{range .URLs}}<code class="lanurl">{{.}}</code>{{end}}<span class="lannote">{{tcode "lan.note" .TokenFile}}</span></div>{{end}}
{{region . "sessions"}}
</div>
<script>{{i18n}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.TrackerScript}}</script>
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{define "r-sessions"}}<div class="totals"><span class="chip">{{t "index.live" .Live}}</span><span class="chip">{{t "index.working" .Busy}}</span></div>{{range .Projects}}<section class="project"><div class="pbar"><span class="pname">{{.Name}}</span><span class="ppath">{{.Path}}</span><span class="chip">{{len .Sessions}}</span></div>{{range .Sessions}}{{template "srow" .}}{{end}}{{if .Ended}}<div class="endedhead">{{t "head.ended"}}</div>{{range .Ended}}{{template "srow" .}}{{end}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "index.hidden" .}}</div>{{end}}</section>{{else}}<div class="empty">{{t "index.empty"}}</div>{{end}}{{end}}

{{define "hostexit"}}<span class="host-exit">{{t "hostexit.stopped"}}{{if .HasCode}} · {{t "hostexit.code" .Code}}{{end}}{{if .HasSignal}} · {{t "hostexit.signal" .Signal}}{{end}}{{with .Reason}} · {{.}}{{end}}{{with .StoppedAt}} · <time datetime="{{.}}">{{.}}</time>{{end}}</span>{{end}}

{{define "srow"}}<a class="sess{{if not .Live}} ended{{end}}" href="/s/{{.ReplyID}}" data-rid="{{.ReplyID}}"{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}><span class="who"><span class="rid{{if .Label}} lbl{{end}}"{{if .Label}} title="{{.ReplyID}}"{{end}}>{{or .Label .ReplyID}}</span><span class="sub">{{if .Tool}}<span class="tn">{{.Tool}}</span>{{end}}{{with .RunningAgents}}<span class="agents-mini">{{t "srow.agents" .}}</span>{{end}}{{if not .HasBoard}}<span class="agents-mini">{{t "srow.noboard"}}</span>{{end}}</span></span><span class="hostc">{{with .Harness}}<span class="host">{{.}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}</span>{{if .Exit}}{{template "hostexit" .Exit}}{{else if .Adapter}}{{template "phase" .Phase}}{{else}}<span class="phase none" title="{{t "srow.nolive.title"}}">{{t "srow.nolive"}}</span>{{end}}<span class="qs">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}</span><span class="when">{{template "ago" .LastSeen}}</span></a>{{end}}

{{/* The session rail (pageview_rail.go): every session page's left card,
one shared render without the viewed session (the page marks its own row,
.cur, and pins starred rows, both on the client). A workspace is a
repository, its sessions under its worktrees, or a plain folder; each row is
two lines, the star outside the row's link, and an ended row a daemon can
bring back carries the revive entry (data-revive, its move) after the link,
shown disabled with its reason when the move is blocked. A workspace bar is a container,
not a button: its collapse toggle (.wstog), the add-worktree + (a repository
on a daemon that keeps stored workspaces), and forget (a stored workspace)
are sibling buttons. */}}
{{define "r-rail"}}<div class="rhd"><b class="rtitle">{{t "rail.title"}}</b>{{if .CanAdd}}<button type="button" class="radd" data-add="ws" title="{{t "rail.ws.add"}}" aria-label="{{t "rail.ws.add"}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}<span class="rsp"></span><span class="chip" title="{{t "rail.live.title"}}">{{t "index.live" .Live}}</span>{{with .CountApproval}}<span class="chip perm" title="{{t "rail.approvals"}}">{{icon "lock"}}{{.}}</span>{{end}}{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}<button type="button" class="rref" id="railref" title="{{t "rail.refresh"}}" aria-label="{{t "rail.refresh"}}">{{icon "reload"}}</button></div><div class="rlist" id="rlist">{{range $ws := .Workspaces}}<section class="rws" data-ws="{{.Path}}"><div class="wsbar"><button type="button" class="wstog" aria-expanded="true" title="{{.Path}}">{{if .Repo}}<span class="wsi" title="{{t "rail.repo"}}">{{icon "repo"}}</span>{{else}}<span class="wsi" title="{{t "rail.folder"}}">{{icon "wsfolder"}}</span>{{end}}<span class="nm">{{.Name}}</span><span class="pp">{{.Path}}</span></button>{{if and .Repo $.CanAdd}}<button type="button" class="radd" data-add="wt" title="{{t "rail.wt.add" .Name}}" aria-label="{{t "rail.wt.add" .Name}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}{{if .Stored}}<button type="button" class="rforget" title="{{t "rail.ws.forget" .Name}}" aria-label="{{t "rail.ws.forget" .Name}}">{{icon "x"}}</button>{{end}}{{with .Approvals}}<span class="chip perm" title="{{t "rail.approvals"}}">{{icon "lock"}}{{.}}</span>{{end}}<span class="ct" title="{{t "rail.live.title"}}">{{.Live}}</span></div><div class="wsbody">{{if .Repo}}{{range .Worktrees}}<div class="rwt{{if .Empty}} empty{{end}}"><div class="wthd" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else}}{{.Branch}}{{end}}</span><span class="wf">· {{if .Root}}{{t "rail.root"}}{{else}}{{.Folder}}{{end}}</span>{{if $.CanSpawn}}{{$b := .Branch}}{{if .Detached}}{{$b = t "rail.detached"}}{{end}}<button type="button" class="rnew" data-root="{{.Path}}" data-name="{{$ws.Name}}" data-branch="{{$b}}" title="{{t "rail.new.title" $b}}" aria-label="{{t "rail.new.title" $b}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}{{if .HasChanges}}<span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span>{{end}}</div>{{template "rsessions" .}}</div>{{end}}{{else}}{{template "rsessions" .}}{{end}}</div></section>{{else}}<div class="empty">{{t "index.empty"}}</div>{{end}}</div><div class="rfoot"><a href="/">{{t "nav.sessions"}}</a></div>{{end}}

{{define "rsessions"}}{{if or .Sessions .Ended}}<div class="rsessions">{{range .Sessions}}{{template "rrow" .}}{{end}}{{with .Ended}}<details class="rended" data-key="rended:{{$.Path}}"><summary>{{t "rail.ended" (len .)}}</summary><div class="rsessions">{{range .}}{{template "rrow" .}}{{end}}</div></details>{{end}}</div>{{end}}{{end}}

{{define "rrow"}}<div class="rs{{if not .Live}} ended{{end}}" data-rid="{{.ReplyID}}"{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}><button type="button" class="star" aria-pressed="false" title="{{t "rail.star"}}" aria-label="{{t "rail.star"}}">{{icon "pin"}}</button><a class="rl" href="/s/{{.ReplyID}}"><span class="s1"><span class="host sm hb{{if .Working}} run{{else if .Approval}} perm{{else if .Failure}} err{{end}}" title="{{if .Working}}{{t "rail.working"}}{{else if .Approval}}{{t "rail.approval"}}{{else if .Failure}}{{template "noticeword" .Failure.Kind}}{{else}}{{t "rail.waiting"}}{{end}}">{{with .Harness}}{{.}}{{else}}?{{end}}{{if .Working}}<svg class="ring" aria-hidden="true"><rect class="rtrk"/></svg><span class="orb" aria-hidden="true"><i class="rrun"></i></span>{{else if or .Approval .Failure}}<svg class="ring" aria-hidden="true"><rect class="rtrk"/></svg>{{end}}</span>{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}{{with .Subagents}}<span class="bots" title="{{t "srow.agents" .}}">{{icon "robot"}}{{.}}</span>{{end}}<span class="rid{{if .Label}} lbl{{end}}"{{if .Label}} title="{{.ReplyID}}"{{end}}>{{or .Label .ReplyID}}</span><span class="rsp"></span>{{with .Approval}}<span class="chip perm" title="{{if .Tool}}{{t "rail.approve.title" (toolName .Tool)}}{{else}}{{t "rail.approval"}}{{end}}">{{icon "lock"}}{{t "rail.approve"}}</span>{{end}}{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .LastTool}}<time class="when t" data-ms="{{.}}" data-f="rel" data-tl="{{t "rail.lasttool"}}">{{clock .}}</time>{{end}}</span>{{if .Exit}}<span class="s2">{{template "hostexit" .Exit}}</span>{{else if and .Approval .Approval.Tool}}<span class="s2 ap"><b class="who">{{toolName .Approval.Tool}}</b>{{.Approval.Args}}</span>{{else}}{{with .Message}}<span class="s2">{{if $.User}}<b class="who">{{t "rail.you"}}</b>{{end}}{{.}}</span>{{end}}{{end}}</a>{{if .Revive}}<button type="button" class="rrev" data-revive="{{.Revive}}"{{if .ReviveBlocked}} aria-disabled="true" title="{{t "rail.revive.nosession"}}" aria-label="{{t "rail.revive.nosession"}}"{{else if eq .Revive "reopen"}} title="{{t "rail.reopen.title"}}"{{else}} title="{{t "rail.takeover.title"}}"{{end}}>{{if eq .Revive "reopen"}}{{t "rail.reopen"}}{{else}}{{t "rail.takeover"}}{{end}}</button>{{end}}</div>{{end}}

{{/* The file view's pages (file_route.go): a rendered markdown file, and the
"not viewable" page that offers the path copies only. Neither is a region;
both inline the board's stylesheet for its colours and markdown rules. */}}
{{define "filecss"}}.fileview .fwrap { max-width: 920px; margin: 0 auto; padding: 18px 20px 48px; }
.fileview .fhead { margin-bottom: 12px; }
.fileview code.fpath { font-size: 12.5px; color: var(--wb-muted-fg); overflow-wrap: anywhere; }
.fileview .fbody { background: var(--wb-card); border-radius: 10px; padding: 14px 18px; overflow-wrap: anywhere; }
.fileview .fbody h1, .fileview .fbody h2, .fileview .fbody h3, .fileview .fbody h4 { font-weight: 700; margin: 14px 0 6px; }
.fileview .fbody h1 { font-size: 1.5em; } .fileview .fbody h2 { font-size: 1.3em; } .fileview .fbody h3 { font-size: 1.15em; }
.fileview .fbody > :first-child { margin-top: 0; }
.fileview .fbody hr { border: 0; border-top: 1px solid var(--wb-muted); margin: 12px 0; }
.fileview .fnone { margin: 0 0 12px; }
.fileview .fcopy { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.fileview .fcopy button { font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 8px; border: 0; background: var(--wb-muted); color: var(--wb-fg); cursor: pointer; }
.fileview .fnote { font-size: 12.5px; color: var(--wb-muted-fg); }{{end}}

{{define "file-md"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div><article class="md fbody">{{.HTML}}</article></div></body></html>
{{end}}

{{define "file-none"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div>
<p class="fnone">{{t "file.none" .Reason}}</p>
<div class="fcopy"><button type="button" data-copy="{{.Rel}}">{{t "file.copyrel"}}</button><button type="button" data-copy="{{.Abs}}">{{t "file.copyabs"}}</button><span class="fnote" id="fnote" role="status" data-ok="{{t "file.copied"}}" data-fail="{{t "file.copyfail"}}"></span></div></div>
<script nonce="{{.Nonce}}">(function () {
  // A LAN page over plain http is not a secure context, where
  // navigator.clipboard is missing: copy through a selected textarea there.
  var doc = document, note = doc.getElementById("fnote");
  function done(ok) { note.textContent = note.getAttribute(ok ? "data-ok" : "data-fail"); }
  function fallback(text) {
    var t = doc.createElement("textarea");
    t.value = text;
    t.setAttribute("readonly", "");
    t.style.position = "fixed";
    t.style.opacity = "0";
    doc.body.appendChild(t);
    t.select();
    var ok = false;
    try { ok = doc.execCommand("copy"); } catch (e) { ok = false; }
    doc.body.removeChild(t);
    done(ok);
  }
  doc.addEventListener("click", function (e) {
    var b = e.target && e.target.closest && e.target.closest("[data-copy]");
    if (!b) return;
    var text = b.getAttribute("data-copy");
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { fallback(text); });
    else fallback(text);
  });
})();</script></body></html>
{{end}}

{{/* The re-mint page (fs_outside.go): what a tab on an outside HTML file
shows when its capability no longer verifies. Its script posts the mint for
the path the URL named and replaces the page with the fresh URL, at most
once in a few seconds per tab; a refused mint shows the note. */}}
{{define "file-remint"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Abs}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview" data-mint="{{.Mint}}" data-base="{{.Base}}" data-abs="{{.Abs}}" data-rel="{{.Rel}}"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Abs}}</code></div>
<p class="fnone" id="fgone" hidden>{{t "file.outside.gone"}}</p></div>
<script nonce="{{.Nonce}}">(function () {
  var b = document.body, key = "ws.outside.remint", now = Date.now();
  function gone() { document.getElementById("fgone").hidden = false; }
  try {
    if (now - (+sessionStorage.getItem(key) || 0) < 5000) { gone(); return; }
    sessionStorage.setItem(key, String(now));
  } catch (e) {}
  if (!window.fetch) { gone(); return; }
  fetch(b.getAttribute("data-mint"), {
    method: "POST", credentials: "same-origin", cache: "no-store",
    headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: b.getAttribute("data-abs") })
  }).then(function (r) {
    if (!r.ok) throw r.status;
    return r.json();
  }).then(function (v) {
    var view = v && typeof v.view === "string" ? v.view : "";
    if (view.indexOf(b.getAttribute("data-base")) !== 0) { gone(); return; }
    location.replace(view.slice(0, view.lastIndexOf("/") + 1) + b.getAttribute("data-rel"));
  }).catch(gone);
})();</script></body></html>
{{end}}
