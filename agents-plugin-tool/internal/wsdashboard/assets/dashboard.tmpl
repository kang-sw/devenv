{{define "session"}}<!DOCTYPE html>
<html data-mode="{{.Mode}}" data-rid="{{.ReplyID}}" data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .SysOpen}} data-sysopen="1"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.ReplyID}} - ws dashboard</title>
<style>{{.Assets.WhiteboardCSS}}</style>
<style>{{.Assets.CSS}}</style></head>
<body class="dash {{.Mode}}">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}<div class="dwrap">
<div class="top"><a class="back" href="/" title="{{t "nav.sessions"}}" aria-label="{{t "nav.sessions"}}">{{icon "back"}}</a>{{region . "head"}}{{template "sse"}}{{template "gear" .Adapter}}</div>
{{template "drawer" .}}
<div class="banner" id="dash-banner" hidden></div>
<main id="grid" class="dgrid {{.Mode}}">
{{if .Adapter}}<nav id="tabbar" class="tabbar"><button data-tab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button data-tab="board" aria-pressed="false">{{icon "board"}}{{t "tab.board"}}<span class="tdot"></span></button></nav>
{{region . "tree"}}
<div id="splitter" class="splitter" role="separator" aria-orientation="horizontal" aria-label="{{t "splitter.label"}}" tabindex="0" title="{{t "splitter.title"}}"></div>
<div id="convo" class="convo">{{region . "entries"}}{{region . "convlive"}}</div>
<div id="composer" class="composer"><button type="button" class="ibadge" id="ibadge" title="{{t "js.interrupt.title"}}" hidden><span class="istop"></span><span class="ilabel">{{t "js.interrupt"}}</span></button>{{region . "ctx"}}<div class="cimgs" id="cimgs"></div><div class="cchips" id="cchips"></div><div class="crow"><textarea id="ctext" rows="1" aria-description="{{t "composer.aria"}}" placeholder="{{t "js.hint.enter"}}"></textarea><button type="button" class="csend" id="csend" title="{{t "composer.send"}}" aria-label="{{t "composer.send"}}">{{icon "send"}}</button></div>{{region . "sline"}}<div class="cnote" id="cnote"></div></div>
{{end}}<div id="bcol" class="bcol">{{region . "board"}}</div>
</main></div>
<script>{{i18n}}</script>
<script>window.wbForm = function () {
{{.Assets.FormScript}}};
window.wbMermaid = function () {
{{.Assets.MermaidInit}}};
window.wbMermaidFile = {{.Assets.MermaidFile}};</script>
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{define "sse"}}<span class="sse" id="sse" title="{{t "js.sse.title.on"}}"><span class="dot"></span><span class="sse-label">{{t "js.sse.live"}}</span></span>{{end}}

{{/* The gear menu. It always holds the language item; full says the page has
a live adapter, which adds the layout and input items. The language buttons
come from the embedded tables, so a new table file adds one. */}}
{{define "gear"}}<span class="gearwrap"><button class="btn gear" id="gear" title="{{if .}}{{t "gear.title"}}{{else}}{{t "gear.title.lang"}}{{end}}">{{icon "gear"}}</button><span class="gmenu" id="gmenu" hidden>{{if .}}<span class="gt">{{t "gear.layout"}}</span><button data-layout="auto" aria-pressed="false"><span class="gk">-</span><span>{{t "gear.layout.auto"}}<span class="gs">{{t "gear.layout.auto.sub"}}</span></span></button><button data-layout="split" aria-pressed="false"><span class="gk">A</span><span>{{t "gear.layout.split"}}<span class="gs">{{t "gear.layout.split.sub"}}</span></span></button><button data-layout="tabs" aria-pressed="false"><span class="gk">B</span><span>{{t "gear.layout.tabs"}}<span class="gs">{{t "gear.layout.tabs.sub"}}</span></span></button><span class="gt gt2">{{t "gear.input"}}</span><button data-input="enter" aria-pressed="false"><span class="gk">&crarr;</span><span>{{t "gear.input.enter"}}<span class="gs">{{t "gear.input.enter.sub"}}</span></span></button><button data-input="mod" aria-pressed="false"><span class="gk">^&crarr;</span><span>{{t "gear.input.mod"}}<span class="gs">{{t "gear.input.mod.sub"}}</span></span></button>{{end}}<span class="gt{{if .}} gt2{{end}}">{{t "gear.theme"}}</span><button data-theme-set="" aria-pressed="false"><span class="gk">&#9680;</span><span>{{t "gear.theme.auto"}}<span class="gs">{{t "gear.theme.auto.sub"}}</span></span></button><button data-theme-set="light" aria-pressed="false"><span class="gk">&#9675;</span><span>{{t "gear.theme.light"}}</span></button><button data-theme-set="dark" aria-pressed="false"><span class="gk">&#9679;</span><span>{{t "gear.theme.dark"}}</span></button><span class="gt gt2">{{t "gear.language"}}</span><select id="glang" aria-label="{{t "gear.language"}}"><option value="">{{t "gear.lang.auto"}}</option>{{range langs}}<option value="{{.Code}}">{{.Name}}</option>{{end}}</select><span class="gs gh">{{t "gear.lang.auto.sub"}}</span><span class="gn">{{t "gear.saved"}}</span></span></span>{{end}}

{{/* The drawer: the side panels pulled down from the top, over the page.
The panels region keeps arriving whole; the page script registers an entry per
panel it shows, and the sheet shows every present panel at once as a card. The
handle hangs from the top edge at the header's right end (the header pads its
right side clear of it), holds one icon per present panel, and rides the
sheet's bottom edge while open. */}}
{{define "drawer"}}<div class="drawer" id="drawer"><div class="dr-in"><div class="dr-clip" id="drclip"><div class="dr-sheet" id="drsheet" role="region" aria-label="{{t "drawer.panels"}}"><div class="dr-body" id="drbody">{{region . "panels"}}</div></div></div><button type="button" class="dr-handle" id="drhandle" aria-controls="drsheet" aria-expanded="false" title="{{t "js.drawer.open"}}" hidden><span class="dr-wait" title="{{t "js.drawer.waiting"}}">{{icon "lock"}}</span><span class="dr-icons" id="dricons"></span><span class="tdot"></span>{{icon "chev"}}</button></div></div>{{end}}

{{define "r-head"}}<span class="meta">{{.ReplyID}}{{if .HasBoard}} · #{{.Seq}}{{end}}</span>{{with .Harness}}<span class="host">{{.}}</span>{{end}}<span class="meta">{{.ProjectName}}</span>{{if not .Live}}<span class="ended-chip" title="{{t "head.ended.title"}}">{{t "head.ended"}}</span>{{end}}{{if not .Adapter}}<span class="nolive" title="{{t "head.stores.title"}}">{{t "head.stores"}}</span>{{end}}<span class="counts">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAssumed}}<span class="chip assumed" title="{{t "chip.assumed"}}">{{icon "arrow"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}</span>{{end}}

{{define "r-board"}}{{if .HasBoard}}{{.Board}}{{else}}<div class="empty">{{t "board.empty"}}</div>{{end}}{{end}}

{{define "r-panels"}}{{.Panels}}{{end}}

{{define "phase"}}{{if eq . "permission"}}<span class="phase permission">{{icon "lock"}}{{t "phase.approval"}}</span>{{else if eq . "thinking"}}<span class="phase thinking"><span class="spin"></span>{{t "phase.thinking"}}</span>{{else if eq . "replying"}}<span class="phase replying"><span class="spin"></span>{{t "phase.replying"}}</span>{{else if eq . "tool"}}<span class="phase tool"><span class="spin"></span>{{t "phase.tool"}}</span>{{else if eq . "compacting"}}<span class="phase compacting"><span class="spin"></span>{{t "phase.compacting"}}</span>{{else}}<span class="phase idle"><span class="idle-dot"></span>{{t "phase.idle"}}</span>{{end}}{{end}}

{{define "dur"}}<time class="t" data-ms="{{.}}" data-f="since">{{clock .}}</time>{{end}}
{{define "ago"}}<time class="t" data-ms="{{.}}" data-f="ago">{{clock .}}</time>{{end}}
{{define "clock"}}<time class="t" data-ms="{{.}}" data-f="clock">{{clock .}}</time>{{end}}
{{define "span"}}<span class="t" data-span="{{.}}">{{spanText .}}</span>{{end}}

{{define "batch"}}{{if .Failed}}<li class="brow fail"><span class="mk">✗</span>{{else}}<li class="brow done"><span class="mk">✓</span>{{end}}<span class="bp">{{range .ToolNames}}<span class="tool" title="{{.}}">{{toolName .}}</span>{{end}}</span><span class="bm">{{tn "batch.calls" .CallCount}}{{with .Failed}} · {{t "count.failed" .}}{{end}} · {{template "ago" .EndedAt}}</span></li>{{end}}

{{define "liverows"}}{{with .Permission}}<li class="brow live perm"><span class="mk">{{icon "lock"}}</span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.approval"}}{{with .ArgsPreview}} · {{.}}{{end}}</span></span><span class="bm">{{template "dur" .StartedAt}}</span></li>{{end}}{{with .Running}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{.ArgsPreview}}</span></span><span class="bm">{{with .OthersRunning}}+{{.}} · {{end}}{{template "dur" .StartedAt}}</span></li>{{end}}{{with .Generating}}{{if eq .Kind "tool"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.args"}}</span></span><span class="bm">{{t "live.chars" .Chars}} · {{template "dur" .PhaseStartedAt}}</span></li>{{end}}{{end}}{{end}}

{{define "r-tree"}}<div class="thead">{{icon "agents"}}{{t "tree.agents"}}<span class="sum"><span class="chip">{{t "tree.running" .Tree.Running}}</span><span class="chip">{{t "tree.done" .Tree.Finished}}</span><span class="chip">{{t "tree.failed" .Tree.Failed}}</span><span class="chip">{{icon "mail"}}{{len .Tree.Peers.Live}}</span></span></div><div class="tree"><div class="agent root {{.Lead.Phase}}"><details data-key="agent-lead"><summary class="ahead"><span class="amk">{{template "mark" .Lead.Phase}}</span><span class="aname">{{t "tree.lead"}}</span>{{template "phase" .Lead.Phase}}<span class="ldet">{{if .Lead.Permission}}<span class="tn" title="{{.Lead.Permission.ToolName}}">{{toolName .Lead.Permission.ToolName}}</span> <span class="args">{{.Lead.Permission.ArgsPreview}}</span>{{else if .Lead.Running}}<span class="tn" title="{{.Lead.Running.ToolName}}">{{toolName .Lead.Running.ToolName}}</span> <span class="args">{{.Lead.Running.ArgsPreview}}</span>{{else if and .Lead.Generating (eq .Lead.Generating.Kind "tool")}}<span class="tn" title="{{.Lead.Generating.ToolName}}">{{toolName .Lead.Generating.ToolName}}</span> <span class="args">{{t "live.args"}}</span>{{end}}</span><span class="am">{{if .Lead.Permission}}{{template "dur" .Lead.Permission.StartedAt}}{{else if .Lead.Running}}{{template "dur" .Lead.Running.StartedAt}}{{else if and .Lead.PhaseStartedAt (or (eq .Lead.Phase "thinking") (eq .Lead.Phase "replying") (eq .Lead.Phase "tool") (eq .Lead.Phase "compacting"))}}{{template "dur" .Lead.PhaseStartedAt}}{{end}}<span title="{{t "tree.batches.title"}}">{{tn "tree.batches" (len .Lead.Finished)}}</span>{{icon "chev"}}</span></summary><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}</ol></details><div class="kids">{{range .Tree.Agents}}{{template "agent" .}}{{end}}{{template "peers" .Tree.Peers}}</div></div></div>{{end}}

{{define "mark"}}{{if eq . "permission"}}{{icon "lock"}}{{else if or (eq . "idle") (eq . "")}}<span class="idle-dot"></span>{{else}}<span class="spin"></span>{{end}}{{end}}

{{define "agent"}}<div class="agent {{.Status}}"><details data-key="agent-{{.ID}}"><summary class="ahead"><span class="amk">{{if .IsRunning}}<span class="spin"></span>{{else if eq .Status "failed"}}✗{{else}}✓{{end}}</span><span class="aname" title="{{or .Label .ID}}">{{if .Label}}{{.Label}}{{else}}{{t "agent.name" (shortID .ID)}}{{end}}</span>{{with .ReplyID}}{{if $.Linked}}<a class="arid" href="/s/{{.}}" title="{{t "agent.open" .}}">{{shortID .}}</a>{{else}}<span class="arid nob" title="{{.}}">{{shortID .}}</span>{{end}}{{end}}{{if .IsRunning}}{{template "phase" .Phase}}{{end}}{{with .Caption}}<span class="acap" title="{{.}}">{{.}}</span>{{end}}<span class="am"><span class="ok" title="{{t "agent.done"}}">✓ {{.Done}}</span><span class="{{if .Failed}}f{{end}}" title="{{t "agent.failed"}}">✗ {{.Failed}}</span>{{if .IsRunning}}{{with .StartedAt}}<span>{{template "dur" .}}</span>{{end}}{{else}}{{with .EndedAt}}<span>{{template "ago" .}}</span>{{end}}{{end}}{{icon "chev"}}</span></summary><ol class="brows">{{range .Finished}}{{template "batch" .}}{{end}}</ol></details>{{if .IsRunning}}<ol class="brows live">{{template "liverows" .}}</ol>{{end}}{{with .Children}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}</div>{{end}}

{{define "peers"}}<div class="pgroup"><div class="pghead">{{icon "mail"}}{{t "peers.title"}}<span class="chip">{{len .Live}}</span>{{with .Ended}}<span class="chip">{{t "peers.ended" (len .)}}</span>{{end}}</div>{{range .Rows}}{{template "peer" .}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "peers.hidden" .}}</div>{{end}}</div>{{end}}

{{define "peerrow"}}<span class="amk">{{if and .Live .Adapter}}{{template "mark" .Lead.Phase}}{{else}}<span class="pdot"></span>{{end}}</span>{{if .Served}}<a class="pname" href="/s/{{.ReplyID}}">{{.Address}}</a>{{else}}<span class="pname">{{.Address}}</span>{{end}}{{if and .Harness .Live}}<span class="host sm">{{.Harness}}</span>{{end}}{{if not .Compact}}<span class="pline">{{if not .Live}}<span class="pstate">{{t "head.ended"}}</span>{{else if not .Served}}<span class="pstate">{{t "peer.unserved"}}</span>{{else if .Adapter}}{{template "phase" .Lead.Phase}}{{with .Lead.Running}}<span class="ptool" title="{{.ToolName}}">{{toolName .ToolName}}</span>{{end}}{{end}}</span>{{end}}<span class="am">{{if .RunningAgents}}<span class="prun" title="{{t "peer.subagents"}}"><span class="spin"></span>{{tn "peer.running" .RunningAgents}}</span>{{end}}{{if and .Adapter (not .Compact)}}<span title="{{t "peer.subagents"}}">{{icon "agents"}}{{.AgentCount}}</span>{{end}}<span title="{{t "peer.lastmail"}}">{{icon "mail"}}{{template "ago" .LastExchange}}</span></span>{{end}}

{{define "peer"}}{{if and .Served .Adapter (not .Compact)}}<details class="peer {{if .Live}}live{{else}}ended{{end}}" data-peer="{{.ReplyID}}"><summary>{{template "peerrow" .}}</summary><div class="ptree"><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}{{template "liverows" .Lead}}</ol>{{with .Agents}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}</div></details>{{else}}<div class="peer {{if .Live}}{{if .Compact}}live compact{{if not .Adapter}} nophase{{end}}{{else if .Served}}live nophase{{else}}unserved{{end}}{{else}}ended{{end}}">{{template "peerrow" .}}</div>{{end}}{{end}}

{{/* The conversation's two regions share the #convo scroll wrapper. entries
holds the finished messages, each keyed by data-entry (its ring entry name);
the page merges it by key and never re-renders an entry it shows. convlive is
the rest, swapped whole: a streaming tick changes it alone. Its data-phase is
the lead's phase, which shows or hides the composer's interrupt badge. */}}
{{define "r-entries"}}<div class="thead">{{icon "chat"}}{{t "tab.conversation"}}<span class="sum"><span class="chip">{{t "convo.user" .Conversation.Users}}</span><span class="chip">{{icon "mail"}}{{.Conversation.Mails}}</span></span></div><div class="conv centries">{{range .Conversation.Entries}}{{.Rendered}}{{end}}</div>{{end}}

{{define "r-convlive"}}<div class="conv clive" data-phase="{{.Conversation.Phase}}">{{with .Conversation}}{{with .ToolGap}}<details class="toolsline live" data-key="tools-live"><summary>{{icon "chev"}}{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{with .Reply}}<div class="msg fromlead streaming"><div class="mh"><b>{{t "tree.lead"}}</b>{{template "clock" .StartedAt}}</div><div class="bub md">{{$.Conversation.ReplyHTML}}{{if .Truncated}} …{{end}}<span class="caret"></span></div></div>{{end}}{{if .Permission}}<div class="permwait">{{icon "lock"}}<span><b>{{t "convo.perm"}}</b> · <code title="{{.Permission.ToolName}}">{{toolName .Permission.ToolName}}</code> <span class="args">{{.Permission.ArgsPreview}}</span></span>{{template "dur" .Permission.StartedAt}}</div>{{else if eq .Phase "compacting"}}<div class="sysline compaction running"><span class="mk"><span class="spin"></span></span>{{t "convo.compacting"}}{{with $.Lead.PhaseStartedAt}}{{template "dur" .}}{{end}}</div>{{else if and .Phase (ne .Phase "idle") (ne .Phase "replying")}}<div class="activity"><span class="spin"></span>{{t "convo.activity" (phaseWord .Phase)}}{{with .Running}} · {{toolName .ToolName}}{{else}}{{with .Generating}}{{with .ToolName}} · {{toolName .}}{{end}}{{end}}{{end}}</div>{{end}}{{range .Held}}{{template "held" .}}{{end}}<div class="sentdata" hidden>{{range .Sent}}<i data-id="{{.ID}}" data-answer="{{.Answer}}" data-note="{{.Note}}" data-state="{{if .Held}}held{{else}}sent{{end}}"></i>{{end}}</div>{{end}}</div>{{end}}

{{/* The status band (pageview_band.go): ctx is the context bar above the
message box, sline the folder, branch, upstream, limits, and cost below it.
A part with no figure is left out; an empty region collapses. */}}
{{define "r-ctx"}}{{with .Band.Context}}<div class="sb sb-top"><span class="sb-ctx{{with .Level}} {{.}}{{end}}" role="meter" aria-label="{{t "band.ctx.aria"}}" aria-valuemin="0" aria-valuemax="100"{{if .Known}} aria-valuenow="{{.Fill}}"{{end}} title="{{if .Known}}{{t "band.ctx.title" .Percent .Tokens}}{{else}}{{t "band.ctx.unknown" .Tokens}}{{end}}"><span class="sb-pct">{{if .Known}}{{.Percent}}%{{else}}?{{end}}</span><span class="sb-bar"><i style="width: {{.Fill}}%"></i><u class="t80"></u><u class="t95"></u></span><span class="sb-tok">{{.Tokens}}</span>{{with .Flag}}<span class="sb-flag">{{flagText .}}</span>{{end}}{{with .Cache}}<span class="sb-cache" title="{{t "band.cache.title"}}">{{t "band.cache" .}}</span>{{end}}</span></div>{{end}}{{end}}

{{define "r-sline"}}{{with .Band}}{{if not .Empty}}<div class="sb sb-foot">{{with .Repo}}{{with .Folder}}<span class="sb-dir" title="{{t "band.folder" .}}">{{icon "folder"}}<span>{{.}}</span></span>{{end}}{{if .Branch}}<span class="sb-br" title="{{if .Detached}}{{t "band.detached" .Branch}}{{else}}{{t "band.branch" .Branch}}{{end}}">{{icon "branch"}}<span>{{.Branch}}</span></span>{{if not .Detached}}{{template "sync" .}}{{end}}{{template "tree" .}}{{end}}{{end}}{{if or .Limits .Cost}}<span class="sb-tail">{{range .Limits}}{{template "limit" .}}{{end}}{{with .Cost}}<span class="sb-cost" title="{{t "band.cost"}}">{{.}}</span>{{end}}</span>{{end}}</div>{{end}}{{end}}{{end}}

{{define "tree"}}{{if or .Modified .Staged .Untracked}}<span class="sb-diff" title="{{t "band.tree"}}{{with .Modified}} {{t "band.modified" .}}{{end}}{{with .Staged}} {{t "band.staged" .}}{{end}}{{with .Untracked}} {{t "band.untracked" .}}{{end}}">{{with .Modified}}<b class="mod">~{{.}}</b>{{end}}{{with .Staged}}<b class="add">+{{.}}</b>{{end}}{{with .Untracked}}<b class="unt">?{{.}}</b>{{end}}</span>{{end}}{{end}}

{{define "sync"}}{{if not .Upstream}}<span class="sb-sync none" title="{{t "band.noupstream.title"}}">{{t "band.noupstream"}}</span>{{else if and (eq .Ahead 0) (eq .Behind 0)}}<span class="sb-sync ok" title="{{t "band.insync" .Upstream}}">✓<span class="sl"> {{t "band.synced"}}</span></span>{{else}}<span class="sb-sync" title="{{t "band.against" .Upstream}}{{with .Ahead}} {{t "band.push" .}}{{end}}{{with .Behind}} {{t "band.pull" .}}{{end}}">{{with .Ahead}}<span class="up">↑{{.}}</span>{{end}}{{with .Behind}}<span class="dn">↓{{.}}</span>{{end}}</span>{{end}}{{end}}

{{define "limit"}}<span class="sb-use{{with .Level}} {{.}}{{end}}{{if .Both}} both{{end}}{{if .Hi}} hi{{end}}" data-limit="{{.Kind}}" title="{{t "band.limit" (limitName .Name) .Percent}}"><span class="u-pct">{{.Percent}}%</span>{{if .ResetsAt}}/<time class="t" data-ms="{{.ResetsAt}}" data-f="{{.ResetFormat}}">{{.ResetText}}</time><em class="u-pace" data-reset="{{.ResetsAt}}" data-win="{{.WindowSec}}" data-pct="{{.Percent}}"></em>{{end}}</span>{{end}}

{{define "held"}}<div class="msg user held" data-entry="{{.ID}}"><div class="mh"><span class="src wb">{{t "origin.whiteboard"}}</span>{{if .Steer}}<span class="heldtag steertag" title="{{t "held.steer.title"}}">{{t "held.steer"}}</span>{{else}}<span class="heldtag" title="{{t "held.held.title"}}">{{t "held.held"}}</span>{{end}}{{template "clock" .At}}{{if not .Steer}}<button class="btn mini hsteer" data-steer="{{.ID}}" title="{{t "held.steerbtn.title"}}">{{icon "arrow"}}{{t "held.steer"}}</button>{{end}}<button class="btn mini hcancel" data-cancel="{{.ID}}" title="{{t "held.cancel.title"}}">{{icon "x"}}{{t "held.cancel"}}</button></div><div class="bub">{{range $i, $p := .Parts}}{{if $i}}<hr class="pdiv">{{end}}<div class="hpart">{{marked $p}}</div>{{end}}{{with .Images}}{{template "thumbs" .}}{{end}}{{with .Chips}}<div class="hchips">{{range .}}<span class="achip"><b>({{.ID}})</b> {{or .Answer "note"}}{{with .Note}}<span class="anote">{{.}}</span>{{end}}</span>{{end}}</div>{{end}}</div></div>{{end}}

{{define "thumbs"}}<div class="thumbs">{{range .}}{{if .Src}}<a class="thumb" href="{{.Src}}" target="_blank" rel="noopener noreferrer" title="{{.Path}}"><img src="{{.Src}}" alt="{{.Name}}" loading="lazy">{{with .Num}}<span class="tnum">#{{.}}</span>{{end}}</a>{{else}}<span class="ipath">{{if .Num}}Image #{{.Num}}: {{.Path}}{{else}}[image: {{.Path}}]{{end}}</span>{{end}}{{end}}</div>{{end}}

{{define "origin"}}{{if eq . "whiteboard"}}<span class="src wb">{{t "origin.whiteboard"}}</span>{{else if eq . "mail"}}<span class="src mail">{{t "origin.mail"}}</span>{{else if eq . "terminal"}}<span class="src">{{t "origin.terminal"}}</span>{{end}}{{end}}

{{define "entry"}}{{if eq .Kind "user"}}<div class="msg user" data-entry="{{.Key}}"><div class="mh">{{template "origin" .Origin}}{{template "clock" .At}}</div><div class="bub">{{marked .Text}}{{if .Truncated}} …{{end}}{{with .Images}}{{template "thumbs" .}}{{end}}</div></div>{{else if eq .Kind "reply"}}<div class="msg fromlead" data-entry="{{.Key}}"><div class="mh"><b>{{t "tree.lead"}}</b>{{template "clock" .At}}</div><div class="bub md">{{.HTML}}{{if .Truncated}} …{{end}}</div></div>{{else if eq .Kind "turn"}}<div class="turnline" data-entry="{{.Key}}">{{template "origin" .Origin}}{{t "entry.turn" .Done}}{{with .Failed}} · {{t "count.failed" .}}{{end}}{{with .DurationMs}} · {{template "span" .}}{{end}}</div>{{else if eq .Kind "tools"}}{{with .Tools}}<details class="toolsline" data-entry="{{$.Key}}" data-key="tools-{{$.Key}}"><summary>{{icon "chev"}}{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{else if eq .Kind "compact"}}<div class="sysline compaction{{if .CompactFailed}} fail{{end}}" data-entry="{{.Key}}">{{if .CompactFailed}}<span class="mk">✗</span>{{t "entry.compact.failed"}}{{else}}<span class="mk">✓</span>{{t "entry.compact.done"}}{{if eq .Trigger "auto"}} {{t "entry.compact.auto"}}{{else if eq .Trigger "manual"}} {{t "entry.compact.manual"}}{{end}}{{end}}{{template "clock" .At}}</div>{{else if eq .Kind "mail"}}{{if .HasBody}}<details class="mailline {{.Direction}}" data-entry="{{.Key}}" data-key="mail-{{.Key}}"><summary>{{template "mailhead" .}}</summary><div class="mbody">{{.Body}}</div></details>{{else}}<div class="mailline {{.Direction}} nobody" data-entry="{{.Key}}">{{template "mailhead" .}}</div>{{end}}{{end}}{{end}}

{{/* toolsum and toolbatches draw a ToolSummary: the lead's finished tool calls between two conversation entries (a tools ring entry), or so far in the open stretch (convlive). */}}
{{define "toolsum"}}<span class="tsum">{{range $i, $t := .Tools}}{{if $i}} · {{end}}<span title="{{$t.Name}}">{{toolName $t.Name}}</span> {{$t.Calls}}{{end}}{{with .OtherCalls}}{{if $.Tools}} · {{t "tools.rest" .}}{{else}}{{t "tools.calls" .}}{{end}}{{end}}{{with .Failed}} · <b class="tf">{{t "count.failed" .}}</b>{{end}}{{with .DurationMs}} · {{template "span" .}}{{end}}{{with .Usage}} · <span class="ttok" title="{{tokenTitle .}}">{{tokenText .}}</span>{{end}}</span>{{end}}
{{define "toolbatches"}}<ol class="brows">{{range .Batches}}<li class="brow {{if .Failed}}fail{{else}}done{{end}}"><span class="mk">{{if .Failed}}✗{{else}}✓{{end}}</span><span class="bp">{{if .Tools}}{{range .Tools}}<span class="tool" title="{{.Name}}">{{toolName .Name}}{{if gt .Calls 1}}<b class="x">×{{.Calls}}</b>{{end}}</span>{{end}}{{else}}{{range .Names}}<span class="tool" title="{{.}}">{{toolName .}}</span>{{end}}{{end}}</span><span class="bm"{{with .Usage}} title="{{tokenTitle .}}"{{end}}>{{batchMeta .}}</span></li>{{end}}{{with .BatchesOmitted}}<li class="brow more"><span class="mk"></span><span class="bp">{{t "tools.more" .}}</span><span class="bm"></span></li>{{end}}</ol>{{end}}
{{define "mailhead"}}<span class="arr">{{if eq .Direction "sent"}}→{{else}}←{{end}}</span>{{if .PeerLinked}}<a class="mpeer" href="/s/{{.PeerReplyID}}">{{.Peer}}</a>{{else}}<span class="mpeer">{{.Peer}}</span>{{end}}<span class="mfirst">: {{.Title}}</span>{{template "clock" .At}}{{end}}

{{define "index"}}<!DOCTYPE html>
<html data-mode="index" data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ws dashboard</title>
<style>{{.Assets.WhiteboardCSS}}</style>
<style>{{.Assets.CSS}}</style></head>
<body class="dash index">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}<div class="dwrap narrow">
<div class="top"><h1>ws dashboard</h1><span class="meta">v{{.Version}}</span>{{template "sse"}}{{template "gear" false}}</div>
{{with .LAN}}<div class="lanbox"><b>{{t "lan.on"}}</b> {{t "lan.open"}}{{range .URLs}}<code class="lanurl">{{.}}</code>{{end}}<span class="lannote">{{tcode "lan.note" .TokenFile}}</span></div>{{end}}
{{region . "sessions"}}
</div>
<script>{{i18n}}</script>
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{define "r-sessions"}}<div class="totals"><span class="chip">{{t "index.live" .Live}}</span><span class="chip">{{t "index.working" .Busy}}</span></div>{{range .Projects}}<section class="project"><div class="pbar"><span class="pname">{{.Name}}</span><span class="ppath">{{.Path}}</span><span class="chip">{{len .Sessions}}</span></div>{{range .Sessions}}{{template "srow" .}}{{end}}{{if .Ended}}<div class="endedhead">{{t "head.ended"}}</div>{{range .Ended}}{{template "srow" .}}{{end}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "index.hidden" .}}</div>{{end}}</section>{{else}}<div class="empty">{{t "index.empty"}}</div>{{end}}{{end}}

{{define "srow"}}<a class="sess{{if not .Live}} ended{{end}}" href="/s/{{.ReplyID}}"><span class="who"><span class="rid">{{.ReplyID}}</span><span class="sub">{{if .Tool}}<span class="tn">{{.Tool}}</span>{{end}}{{with .RunningAgents}}<span class="agents-mini">{{t "srow.agents" .}}</span>{{end}}{{if not .HasBoard}}<span class="agents-mini">{{t "srow.noboard"}}</span>{{end}}</span></span>{{with .Harness}}<span class="host">{{.}}</span>{{else}}<span></span>{{end}}{{if .Adapter}}{{template "phase" .Phase}}{{else}}<span class="phase none" title="{{t "srow.nolive.title"}}">{{t "srow.nolive"}}</span>{{end}}<span class="qs">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAssumed}}<span class="chip assumed" title="{{t "chip.assumed"}}">{{icon "arrow"}}{{.}}</span>{{end}}</span><span class="when">{{template "ago" .LastSeen}}</span></a>{{end}}

{{/* The file view's pages (file_route.go): a rendered markdown file, and the
"not viewable" page that offers the path copies only. Neither is a region;
both inline the board's stylesheet for its colours and markdown rules. */}}
{{define "filecss"}}.fileview .fwrap { max-width: 920px; margin: 0 auto; padding: 18px 20px 48px; }
.fileview .fhead { margin-bottom: 12px; }
.fileview code.fpath { font-size: 12.5px; color: var(--wb-muted-fg); overflow-wrap: anywhere; }
.fileview .fbody { background: var(--wb-card); border-radius: 10px; padding: 14px 18px; overflow-wrap: anywhere; }
.fileview .fbody h1, .fileview .fbody h2, .fileview .fbody h3, .fileview .fbody h4 { font-weight: 700; margin: 14px 0 6px; }
.fileview .fbody h1 { font-size: 1.5em; } .fileview .fbody h2 { font-size: 1.3em; } .fileview .fbody h3 { font-size: 1.15em; }
.fileview .fbody > :first-child { margin-top: 0; }
.fileview .fbody hr { border: 0; border-top: 1px solid var(--wb-muted); margin: 12px 0; }
.fileview .fnone { margin: 0 0 12px; }
.fileview .fcopy { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.fileview .fcopy button { font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 8px; border: 0; background: var(--wb-muted); color: var(--wb-fg); cursor: pointer; }
.fileview .fnote { font-size: 12.5px; color: var(--wb-muted-fg); }{{end}}

{{define "file-md"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div><article class="md fbody">{{.HTML}}</article></div></body></html>
{{end}}

{{define "file-none"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div>
<p class="fnone">{{t "file.none" .Reason}}</p>
<div class="fcopy"><button type="button" data-copy="{{.Rel}}">{{t "file.copyrel"}}</button><button type="button" data-copy="{{.Abs}}">{{t "file.copyabs"}}</button><span class="fnote" id="fnote" role="status" data-ok="{{t "file.copied"}}" data-fail="{{t "file.copyfail"}}"></span></div></div>
<script nonce="{{.Nonce}}">(function () {
  // A LAN page over plain http is not a secure context, where
  // navigator.clipboard is missing: copy through a selected textarea there.
  var doc = document, note = doc.getElementById("fnote");
  function done(ok) { note.textContent = note.getAttribute(ok ? "data-ok" : "data-fail"); }
  function fallback(text) {
    var t = doc.createElement("textarea");
    t.value = text;
    t.setAttribute("readonly", "");
    t.style.position = "fixed";
    t.style.opacity = "0";
    doc.body.appendChild(t);
    t.select();
    var ok = false;
    try { ok = doc.execCommand("copy"); } catch (e) { ok = false; }
    doc.body.removeChild(t);
    done(ok);
  }
  doc.addEventListener("click", function (e) {
    var b = e.target && e.target.closest && e.target.closest("[data-copy]");
    if (!b) return;
    var text = b.getAttribute("data-copy");
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { fallback(text); });
    else fallback(text);
  });
})();</script></body></html>
{{end}}
