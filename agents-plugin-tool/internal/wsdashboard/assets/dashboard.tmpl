{{define "session"}}<!DOCTYPE html>
<html data-mode="{{.Mode}}" data-rid="{{.ReplyID}}"{{if .HasBoard}} data-board-incarnation="{{.BoardIncarnation}}"{{end}}{{with .Worktree}} data-worktree="{{.}}"{{end}} data-assets="{{.Assets.ID}}" data-wb-titlehost data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .SysOpen}} data-sysopen="1"{{end}}{{if .Hosted}} data-hosted="1"{{end}}{{if .IsChild}} data-child="1"{{end}}{{if .CanEditSettings}} data-can-edit-settings="1"{{end}}{{if .HandedOff}} data-handed="1"{{end}}{{with .Terminal}} data-term="{{.}}"{{end}}{{if .Frame}} data-frame="1"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{pwa .Theme}}
<title>{{if .Worktree}}{{.Workspace}} · {{.WorktreeBranch}} - Werkschaft (alpha){{else}}{{template "stitle" .}}{{end}}</title>
{{if .Frame}}<link rel="stylesheet" href="/s/{{.Assets.FrameWhiteboardFile}}">{{if .Terminal}}
<link rel="stylesheet" href="/s/{{.Assets.FrameXtermFile}}">{{end}}
<link rel="stylesheet" href="/s/{{.Assets.FrameCSSFile}}">{{else}}
<style>{{.Assets.WhiteboardCSS}}</style>{{if .Terminal}}
<style>{{.Assets.XtermCSS}}</style>{{end}}
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.TrackerCSS}}</style>{{end}}</head>
<body class="dash {{.Mode}}{{if .Worktree}} live{{end}}">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}{{.Assets.LucideSprite}}<div class="dwrap">
<div class="top">{{template "railbtn"}}{{region . "head"}}{{template "sse"}}{{template "tcen"}}{{template "qsslot"}}</div>
{{template "drawer" .}}
<div class="banner" id="dash-banner" hidden></div>
<div class="dbody">{{if .Frame}}{{template "railph"}}{{else}}<aside id="rail" class="rail" aria-label="{{t "rail.title"}}">{{region . "rail"}}</aside><div class="rscrim" id="rscrim"></div>
{{template "memopad"}}{{end}}
<main id="grid" class="dgrid {{.Mode}}">
{{if .Worktree}}<div id="chead" class="thead">{{icon "folder"}}{{t "tab.files"}}<span class="sum fsum"></span></div>
<section id="files" class="fpane" aria-label="{{t "tab.files"}}"></section>
{{else if .Adapter}}<nav id="tabbar" class="tabbar"><button data-tab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button data-tab="board" aria-pressed="false">{{icon "board"}}{{t "tab.board"}}<span class="tdot"></span></button></nav>
<section id="files" class="fpane" aria-label="{{t "tab.files"}}"></section>
<div id="chead" class="thead chead"><nav id="ctabs" class="ctabs" aria-label="{{t "tab.column"}}"><button type="button" data-ctab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button type="button" data-ctab="files" aria-pressed="false">{{icon "folder"}}{{t "tab.files"}}</button>{{if .Terminal}}<button type="button" class="d-ctab-add" data-ctab-add-term aria-label="{{t "term.tab.new"}}" title="{{t "term.tab.new"}}"><svg class="li" aria-hidden="true"><use href="#l-square-terminal"/></svg><span aria-hidden="true">+</span></button>{{end}}</nav><span class="csum"></span><span class="fsum"></span></div>
<div id="convo" class="convo">{{region . "entries"}}{{region . "convlive"}}{{if .Hosted}}<div class="apbox" id="apbox" hidden></div>{{end}}</div>
<div id="agisland" class="agisland" data-mode="idle" data-tool-label='{{t "phase.tool"}}' hidden><div id="agcompact" class="agview agcompact" role="button" tabindex="0" aria-label="{{t "tree.agents"}}" aria-controls="agpop" aria-expanded="false"></div><div id="agidle" class="agview agidle" role="button" tabindex="0" aria-label="{{t "tree.agents"}}" aria-controls="agpop" aria-expanded="false">{{icon "agents"}}</div>{{template "agpop" .}}</div>
<div id="composer" class="composer"><div class="cbadges"><button type="button" class="ibadge" id="ibadge" title="{{t "js.interrupt.title"}}" hidden><span class="istop"></span><span class="ilabel">{{t "js.interrupt"}}</span></button>{{template "subbadge"}}</div>{{region . "ctx"}}{{if .SysOpen}}{{region . "cmds"}}{{end}}<div class="cimgs" id="cimgs"></div><div class="cchips" id="cchips"></div><div class="crow"><span class="ccmd" id="ccmd" title="{{t "composer.cmd.title"}}" hidden><b class="ccmd-name"></b><span class="ccmd-args" hidden></span><button type="button" class="unchip" data-uncmd title="{{t "composer.cmd.remove"}}" aria-label="{{t "composer.cmd.remove"}}">×</button></span><div class="cfield"><div class="chl" id="chl" aria-hidden="true"></div><textarea id="ctext" rows="1" aria-description="{{t "composer.aria"}}" placeholder="{{t "js.hint.enter"}}"></textarea></div><button type="button" class="csend" id="csend" title="{{t "composer.send"}}" aria-label="{{t "composer.send"}}">{{icon "send"}}</button></div><template id="heldacts">{{template "hsteer" ""}}{{template "hcancel" ""}}</template><div class="cfoot">{{if or .Hosted .IsChild}}{{template "composerpills" .}}{{end}}{{region . "sline"}}</div></div>
{{else if .SavedConversation}}<nav id="tabbar" class="tabbar"><button data-tab="convo" aria-pressed="true">{{icon "chat"}}{{t "tab.conversation"}}<span class="tdot"></span></button><button data-tab="board" aria-pressed="false">{{icon "board"}}{{t "tab.board"}}<span class="tdot"></span></button></nav>
<div id="convo" class="convo" aria-label="{{t "tab.conversation"}}">{{region . "entries"}}</div>
{{end}}<div id="bcol" class="bcol">{{region . "board"}}</div>
</main></div></div>
{{if not .Frame}}{{template "settings" .}}{{end}}
{{if .Frame}}<script src="/s/{{index .Assets.FrameI18nFiles lang}}"></script>
<script src="/s/{{.Assets.FrameScriptFile}}"></script>{{if .Terminal}}
<script src="/s/{{.Assets.FrameTermFile}}"></script>{{end}}{{if and .SysOpen (not .Worktree)}}
<script src="/s/{{.Assets.FrameWebFile}}"></script>{{end}}
<script src="/s/{{.Assets.FrameSelectFile}}"></script>
{{else}}<script>{{i18n}}</script>
<script>{{.Assets.AnswersScript}}</script>
<script>window.wbForm = function () {
{{.Assets.FormScript}}};
window.wbMermaid = function () {
{{.Assets.MermaidInit}}};
window.wbMermaidFile = {{.Assets.MermaidFile}};</script>
<script>{{.Assets.ViewerScript}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.TrackerScript}}</script>
<script>{{.Assets.MentionScript}}</script>
<script>{{.Assets.RailScript}}</script>
<script>{{.Assets.MemoScript}}</script>
<script>{{.Assets.UsageScript}}</script>
<script>{{.Assets.ShellScript}}</script>
<script>{{.Assets.CardsScript}}</script>
<script>{{.Assets.OverviewScript}}</script>
<script>{{.Assets.PreviewScript}}</script>
<script>{{.Assets.FilesScript}}</script>{{if .Terminal}}
<script>{{.Assets.TerminalScript}}</script>{{end}}{{if and .SysOpen (not .Worktree)}}
<script>{{.Assets.WebScript}}</script>{{end}}
<script>{{.Assets.SelectAllScript}}</script>{{end}}
{{if .Frame}}<script src="/s/{{.Assets.ScriptFile}}"></script>{{else}}<script>{{.Assets.Script}}</script>{{end}}
</body></html>
{{end}}

{{/* The iframe shell (shellPageData, shell.js): the session rail and the
top header, which stay across navigations, over the frames the dashboard's
pages load in (#frames, the first one the page asked for). Each frame's page
lays itself out as it stands alone, under placeholders for the rail and the
header's shell-owned items (railph, data-frame), and hands its head to the
shell. The rail takes its stored marks before it ever shows: rail.js loads
in the head, and the inline script right after the rail applies the marks
(rail.js marks) and lifts data-premark, which keeps the rail's rows unseen
until then. */}}
{{define "shell"}}<!DOCTYPE html>
<html data-mode="shell" data-shell="1" data-rid="{{.RID}}" data-assets="{{.Assets.ID}}" data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .SysOpen}} data-sysopen="1"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{pwa .Theme}}
<title>{{.Title}}</title>
<style>{{.Assets.WhiteboardCSS}}</style>
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.TrackerCSS}}</style>
<script>{{.Assets.RailScript}}</script></head>
<body class="dash live shell">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}{{.Assets.LucideSprite}}<div class="frames" id="frames"><iframe class="sframe on" src="{{.Src}}" title="{{.Title}}"></iframe></div>
<div class="dwrap">
<div class="top{{if .OwnHead}} sh-own{{end}}">{{template "railbtn"}}{{region . "head"}}{{template "sse"}}{{template "tcen"}}{{template "qsslot"}}</div>
<div class="dbody"><aside id="rail" class="rail" aria-label="{{t "rail.title"}}" data-premark>{{region . "rail"}}</aside><script>(function () {
  var R = window.WsRail, r = document.getElementById("r-rail"), s = null;
  try {
    try { s = window.localStorage; } catch (e) { s = null; }
    var store = { load: function (k) { try { return s ? s.getItem(k) : null; } catch (e) { return null; } }, save: function () {} };
    if (!R || !r) return;
    R.marks(r, R.state(store), document.documentElement.getAttribute("data-rid"));
    var list = document.getElementById("rlist"), top = parseInt(store.load("ws.dashboard.railscroll"), 10);
    if (list && isFinite(top)) list.scrollTop = top;
  } finally { document.getElementById("rail").removeAttribute("data-premark"); }
})();</script><div class="rscrim" id="rscrim"></div>
{{template "memopad"}}</div></div>
{{template "settings" .}}
<script>{{i18n}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.MentionScript}}</script>
<script>{{.Assets.MemoScript}}</script>
<script>{{.Assets.UsageScript}}</script>
<script>{{.Assets.ShellScript}}</script>{{if .SysOpen}}
<script>{{.Assets.CardsScript}}</script>
<script>{{.Assets.FilesScript}}</script>{{end}}
<script>{{.Assets.SelectAllScript}}</script>
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{/* The rail button: it opens the session rail where the rail overlays
the page (narrow windows, beside the pinned column), and on a page the
iframe shell frames holds the place of the shell's own (data-frame). */}}
{{define "railbtn"}}<a class="back" id="railbtn" href="/" title="{{t "nav.sessions"}} (Ctrl+`)" aria-label="{{t "nav.sessions"}} (Ctrl+`)" aria-controls="rail" aria-expanded="false">{{icon "menu"}}</a>{{end}}

{{/* The rail's placeholder on a page the iframe shell frames: an empty,
invisible rail that takes the rail's place in every layout, under the
shell's own rail. */}}
{{define "railph"}}<aside class="rail rail-ph" aria-hidden="true"></aside>{{end}}

{{/* The workspace memo pad beside the rail (memo.js). */}}
{{define "memopad"}}<aside id="memo-pad" class="memo-pad" aria-label="Workspace memos" aria-hidden="true"><header><span class="memo-ic" aria-hidden="true">▤</span><b>Memos</b><span id="memo-workspace" class="memo-ws"></span><span id="memo-n" class="memo-n"></span><span class="memo-sp"></span><button type="button" id="memo-close" aria-label="Close memos">✕</button></header><div class="memo-add"><textarea id="memo-input" rows="1" maxlength="8000" aria-label="New memo" aria-description="Enter to save, Shift+Enter for a newline" placeholder="Add a memo…"></textarea><div class="memo-hint" aria-hidden="true"><span><kbd>Enter</kbd> save</span><span><kbd>Shift</kbd>+<kbd>Enter</kbd> newline</span></div></div><p id="memo-status" role="status"></p><div id="memo-list" class="memo-list"></div><div id="memo-undo" hidden><span>Memo deleted.</span><button type="button">Undo</button></div></aside>{{end}}

{{/* The search-palette button slot. Its modal mounts in the body, outside
header stacking contexts (dashboard.js mounts the tracker renderer). */}}
{{define "qsslot"}}<span class="qsslot" id="qsslot"></span>{{end}}

{{/* The header's center cluster, shell-owned and outside every region: the
plan usage handle (usage.js draws it; it steps down to one compact trigger
first when the header runs short, rail.js topFit) and the global alert slot
beside it, empty and hidden until a cross-session alert fills it. */}}
{{define "tcen"}}<span class="tcen"><button type="button" class="usage-toggle" aria-label="Plan usage" title="Plan usage" aria-haspopup="dialog" aria-expanded="false"><span class="usage-empty">Plan usage</span></button><span class="talert" id="talert" hidden></span></span>{{end}}

{{/* The stream indicator: a bare dot the page script turns off while the
stream is down. A session page whose head has a harness badge lights the
dot inside the badge instead (r-head), and the stylesheet hides this one. */}}
{{define "sse"}}<span class="sse" id="sse" title="{{t "js.sse.title.on"}}"><span class="dot"></span></span>{{end}}

{{/* Settings belongs to the rail owner, outside the shared rail region.
The footer button survives usage redraws; the existing rail popover controller
keeps the card positioned and returns focus even after a rail replacement.
Layout/input preferences also remain available before a session is selected. */}}
{{define "settings"}}<div class="rpop settings-pop" id="gmenu" role="dialog" aria-label="{{t "drawer.settings"}}" tabindex="-1" hidden><div class="sphd">{{t "drawer.settings"}}<button type="button" class="usage-close" id="settings-close" aria-label="{{t "js.card.close"}}">×</button></div><div class="gmenu gcard">{{template "gearitems" .}}</div>{{if .LoginLocal}}<div class="gmenu gcard loginbox"><span class="gt">{{t "login.title"}}</span><button type="button" id="login-copy"><span class="gk"><svg class="i" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span><span>{{t "login.copy"}}<span class="gs">{{t "login.copy.sub"}}</span></span></button></div>{{end}}{{with .LAN}}<div class="lanbox"><b>{{t "lan.on"}}</b> {{t "lan.open"}}{{range .URLs}}<code class="lanurl">{{.}}</code>{{end}}<span class="lannote">{{tcode "lan.note" .TokenFile}}</span></div>{{end}}</div>{{end}}

{{define "gearitems"}}{{if .}}<span class="gt">{{t "gear.layout"}}</span><button data-layout="auto" aria-pressed="false"><span class="gk">-</span><span>{{t "gear.layout.auto"}}<span class="gs">{{t "gear.layout.auto.sub"}}</span></span></button><button data-layout="split" aria-pressed="false"><span class="gk">A</span><span>{{t "gear.layout.split"}}<span class="gs">{{t "gear.layout.split.sub"}}</span></span></button><button data-layout="tabs" aria-pressed="false"><span class="gk">B</span><span>{{t "gear.layout.tabs"}}<span class="gs">{{t "gear.layout.tabs.sub"}}</span></span></button><span class="gt gt2">{{t "gear.input"}}</span><button data-input="enter" aria-pressed="false"><span class="gk">&crarr;</span><span>{{t "gear.input.enter"}}<span class="gs">{{t "gear.input.enter.sub"}}</span></span></button><button data-input="mod" aria-pressed="false"><span class="gk">^&crarr;</span><span>{{t "gear.input.mod"}}<span class="gs">{{t "gear.input.mod.sub"}}</span></span></button>{{end}}<span class="gt{{if .}} gt2{{end}}">{{t "gear.theme"}}</span><button data-theme-set="" aria-pressed="false"><span class="gk">&#9680;</span><span>{{t "gear.theme.auto"}}<span class="gs">{{t "gear.theme.auto.sub"}}</span></span></button><button data-theme-set="light" aria-pressed="false"><span class="gk">&#9675;</span><span>{{t "gear.theme.light"}}</span></button><button data-theme-set="dark" aria-pressed="false"><span class="gk">&#9679;</span><span>{{t "gear.theme.dark"}}</span></button><span class="gt gt2">{{t "gear.language"}}</span><select id="glang" aria-label="{{t "gear.language"}}"><option value="">{{t "gear.lang.auto"}}</option>{{range langs}}<option value="{{.Code}}">{{.Name}}</option>{{end}}</select><span class="gn">{{t "gear.saved"}}<span class="meta settings-version">v{{.Version}}</span><a class="d-settings-github" href="{{repoURL}}" target="_blank" rel="noopener noreferrer" aria-label="{{t "gear.github"}}" title="{{t "gear.github"}}"><svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a></span>{{end}}

{{/* The drawer: the side panels pulled down from the top, over the page.
The panels region keeps arriving whole; the page script registers an entry per
panel it shows, and the sheet shows every present panel at once as a card. The
handle hangs from the top edge at the header's right end (the header pads its
right side clear of it), holds one icon per present panel, and hides while
open, replaced by the top fold button. The sheet fills down to above the
composer. The git handle (the git region) hangs left of it and opens the
same frame on the git drawer's sheet (gitbody) instead. */}}
{{define "drawer"}}<div class="drawer" id="drawer"><div class="dr-in"><div class="dr-clip" id="drclip"><div class="dr-sheet" id="drsheet" role="region" aria-label="{{t "drawer.panels"}}"><div class="dr-body" id="drbody">{{region . "panels"}}{{template "drcards" .}}</div>{{if .Git}}{{template "gitbody"}}{{end}}</div></div><button type="button" class="dr-handle" id="drhandle" aria-controls="drsheet" aria-expanded="false" title="{{t "js.drawer.open"}}" hidden><span class="dr-wait" title="{{t "js.drawer.waiting"}}">{{icon "lock"}}</span>{{icon "menu"}}<span class="tdot"></span></button>{{region . "git"}}</div></div>{{end}}

{{/* The git drawer's sheet (gitdrawer.go, gitlog.go, gitpush.go): the
commit graph, whose rows dashboard.js draws from the git log route, and the
action panel, whose standing line and changed-file list it fills from the git
status route; both each time the drawer opens on it and after each action. A
row opens the commit window (dashboard.js). Fetch, pull (fast-forward only),
and push; no commit action, and the graph is read-only. */}}
{{define "gitbody"}}<div class="dr-body gbody" id="gbody" hidden><section class="glog" id="glog" aria-label="{{t "git.graph"}}"><div class="ghead">{{icon "branch"}}<span class="gtitle">{{t "git.graph.title"}}</span><span class="gsub">{{t "git.graph.sub"}}</span><span class="chip" id="glcount" hidden></span></div><div class="glscroll" id="glscroll"><div class="glcols"><span>{{t "git.graph.col.graph"}}</span><span>{{t "git.graph.col.subject"}}</span><span>{{t "git.graph.col.author"}}</span><span class="r">{{t "git.graph.col.when"}}</span><span class="r">{{t "git.graph.col.commit"}}</span></div><div class="glrows" id="glrows"></div></div></section><section class="gpanel" aria-label="{{t "git.drawer"}}"><div class="ghead">{{icon "branch"}}<span class="gref" id="gref"></span></div><div class="gacts"><button type="button" class="btn gact" data-git="fetch" data-busy="{{t "git.fetch.busy"}}" title="{{t "git.fetch.title"}}">{{icon "fetch"}}<span>{{t "git.fetch"}}</span></button><button type="button" class="btn gact" data-git="pull" data-busy="{{t "git.pull.busy"}}" title="{{t "git.pull.title"}}">{{icon "pull"}}<span>{{t "git.pull"}}</span></button><button type="button" class="btn gact" data-git="push" data-busy="{{t "git.push.busy"}}" title="{{t "git.push.title"}}">{{icon "push"}}<span>{{t "git.push.go"}}</span></button></div><div class="gmsg" id="gmsg" role="status" data-lost="{{t "git.lost"}}" hidden></div><div class="gfiles" id="gfiles"></div></section></div>{{end}}

{{/* The drawer's own cards after the panels: the pooled worktrees, when
the daemon reads pools, and the session holders, when the daemon runs them. They are no region: the page script fills the worktrees card
from the worktrees route each time the drawer opens, and the cleanup button
asks the session to clean the pool up (worktrees.go), which needs a live
adapter. It fills the holders card from the holders route (holders.go) on
the same openings: the holders no daemon is attached to, the ones not
restart-safe, and the failed holder starts; a stop button on an unattached
row, for a viewer the route lets stop one. */}}
{{define "drcards"}}{{if .Worktrees}}<details class="panel drcard wtcard" id="p-worktrees" open><summary>{{icon "branch"}}{{t "wt.title"}}<span class="chip" id="wtcount" hidden></span></summary><div class="body"><div class="wtlist" id="wtlist" aria-live="polite"></div><div class="wtfoot"><span class="wtnote" id="wtnote" role="status"></span><button type="button" class="btn wtclean" id="wtclean"{{if .Adapter}} title="{{t "wt.cleanup.title"}}"{{else}} disabled title="{{t "wt.cleanup.noadapter"}}"{{end}}>{{t "wt.cleanup"}}</button></div></div></details>{{end}}{{if .Holders}}<details class="panel drcard hdcard" id="p-holders" open><summary>{{icon "agents"}}{{t "hd.title"}}<span class="chip" id="hdcount" hidden></span></summary><div class="body"><div class="wtlist" id="hdlist" aria-live="polite"></div><div class="wtfoot"><span class="wtnote" id="hdnote" role="status"></span></div></div></details>{{end}}<details class="panel drcard notescard" id="p-notes" open><summary>{{icon "repo"}}{{t "notes.title"}}<button type="button" class="btn notes-refresh" id="notesrefresh">{{t "notes.refresh"}}</button></summary><div class="body" id="noteslist" aria-live="polite"></div></details>{{end}}

{{/* stitle is a session page's tab title: its display label, or its
reply-id when it has none. The head's name carries it too (data-title), so
the page script retitles the tab when a head swap brings a new label. */}}
{{define "stitle"}}{{or .Label .ReplyID}} - Werkschaft (alpha){{end}}

{{define "worktree-head"}}<span class="tph tph-id"><span class="tph-c"><span class="meta tph-r1">{{.Workspace}}</span><b class="worktree-branch">{{icon "branch"}}{{.WorktreeBranch}}</b></span></span><span class="tph tph-chips"><span class="meta worktree-path" title="{{.Worktree}}">{{.Worktree}}</span><span class="chip">{{t "worktree.page"}}</span><span class="chip">{{t "worktree.local"}}</span></span>{{end}}

{{/* The head's session name (sname): the display label, or the reply-id
when the session has none, as a button whose click copies the session's
mailbox address (MailboxRef); its tooltip keeps the reply-id. A label
marks the name lbl, the body face (dashboard.css), as the rail and index
rows mark theirs. The pencil
beside it opens the page script's inline rename (dashboard.js labelStart),
which posts to the label route (label_route.go). */}}
{{define "sname"}}<span class="meta sname" data-label="{{.Label}}" data-max="{{.LabelMax}}" data-title="{{template "stitle" .}}"><button type="button" class="snm{{if .Label}} lbl{{end}}" data-copy="{{.MailboxRef}}" data-mailbox-open="{{.MailboxOpen}}" title="{{.ReplyID}}&#10;{{t "head.name.copy"}}">{{or .Label .ReplyID}}</button><button type="button" class="sren" title="{{t "head.rename"}}" aria-label="{{t "head.rename"}}">{{icon "pencil"}}</button>{{if .HasBoard}}<span class="sseq"> · #{{.Seq}}</span>{{end}}</span>{{end}}

{{/* parentpill is the head's parent jump: an up-left arrow and the parent's
name under a micro-label. Linked or not, the markup is the same; only the
element around it (a link or an inert badge) differs. */}}
{{define "parentpill"}}<svg class="tph-up" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.5 11.5 4.5 4.5M4.5 10.5v-6h6"/></svg><span class="tph-c"><span class="meta tph-r1">{{t "head.parent"}}</span><b class="tph-pn">{{.Name}}</b></span>{{end}}
{{define "r-head"}}{{with .Parent}}{{if .Linked}}<a class="tph tph-parent" href="/s/{{.ReplyID}}" title="{{t "head.parent.title" .Name}}{{with .Path}}&#10;{{.}}{{end}}">{{template "parentpill" .}}</a>{{else}}<span class="tph tph-parent dead" title="{{t "head.parent.gone" .Name}}{{with .Path}}&#10;{{.}}{{end}}">{{template "parentpill" .}}</span>{{end}}{{end}}<span class="tph tph-id"><span class="tph-c"><span class="meta tph-r1">{{.ProjectName}}</span>{{template "sname" .}}</span></span>{{if or .Harness .Hosted}}<span class="tph tph-hs">{{with .Harness}}<span class="hb" data-h="{{.}}" aria-hidden="true"></span><span class="host sse{{if not $.ProcessRunning}} stopped{{end}}{{with $.Host}}{{if .Failure}} err{{end}}{{end}}" title="{{if $.ProcessRunning}}{{t "head.process.running"}}{{else}}{{t "head.process.stopped"}}{{end}}"><span class="dot"></span>{{.}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}</span>{{end}}<span class="tph tph-chips">{{with .Host}}{{with .Failure}}<span class="chip fail" title="{{.Text}}">{{template "noticeword" .Kind}}</span>{{end}}{{with .MCPBroken}}<span class="chip mcpbad" title="{{t "head.mcp.title"}} {{range $i, $s := .}}{{if $i}}, {{end}}{{$s}}{{end}}">{{t "head.mcp"}}</span>{{end}}{{end}}{{if not .Live}}<span class="ended-chip" title="{{t "head.ended.title"}}">{{t "head.ended"}}</span>{{end}}{{if not .Adapter}}<span class="nolive" title="{{t "head.stores.title"}}">{{t "head.stores"}}</span>{{end}}<span class="counts">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}</span></span>{{end}}

{{define "r-board"}}{{if .HasBoard}}{{.ThemedBoard}}{{else}}<div class="empty">{{t "board.empty"}}</div>{{end}}{{end}}

{{define "r-panels"}}{{.Panels}}{{end}}

{{define "phase"}}{{if eq . "permission"}}<span class="phase permission">{{icon "lock"}}{{t "phase.approval"}}</span>{{else if eq . "thinking"}}<span class="phase thinking"><span class="spin"></span>{{t "phase.thinking"}}</span>{{else if eq . "replying"}}<span class="phase replying"><span class="spin"></span>{{t "phase.replying"}}</span>{{else if eq . "tool"}}<span class="phase tool"><span class="spin"></span>{{t "phase.tool"}}</span>{{else if eq . "compacting"}}<span class="phase compacting"><span class="spin"></span>{{t "phase.compacting"}}</span>{{else}}<span class="phase idle"><span class="idle-dot"></span>{{t "phase.idle"}}</span>{{end}}{{end}}

{{define "dur"}}<time class="t" data-ms="{{.}}" data-f="since">{{clock .}}</time>{{end}}
{{define "ago"}}<time class="t" data-ms="{{.}}" data-f="ago">{{clock .}}</time>{{end}}
{{define "clock"}}<time class="t" data-ms="{{.}}" data-f="clock">{{clock .}}</time>{{end}}
{{define "span"}}<span class="t" data-span="{{.}}">{{spanText .}}</span>{{end}}

{{define "batch"}}{{if .Failed}}<li class="brow fail"><span class="mk">✗</span>{{else}}<li class="brow done"><span class="mk">✓</span>{{end}}<span class="bp">{{range .ToolNames}}<span class="tool" title="{{.}}">{{toolName .}}</span>{{end}}</span><span class="bm">{{tn "batch.calls" .CallCount}}{{with .Failed}} · {{t "count.failed" .}}{{end}} · {{template "ago" .EndedAt}}</span></li>{{end}}

{{/* The live rows: permrow a pending permission prompt, runrow the running
call, genrow a tool call streaming its arguments. liverows is a lead's
variable list (the expanded peer tree); slots a running agent's fixed rows
(AgentNode.Slots), where a slot with nothing set is a dim placeholder. */}}
{{define "permrow"}}<li class="brow live perm"><span class="mk">{{icon "lock"}}</span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.approval"}}{{with .ArgsPreview}} · {{.}}{{end}}</span></span><span class="bm">{{template "dur" .StartedAt}}</span></li>{{end}}

{{define "runrow"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{.ArgsPreview}}</span></span><span class="bm">{{with .OthersRunning}}+{{.}} · {{end}}{{template "dur" .StartedAt}}</span></li>{{end}}

{{define "genrow"}}<li class="brow live"><span class="mk"><span class="spin"></span></span><span class="bp"><span class="tool" title="{{.ToolName}}">{{toolName .ToolName}}</span><span class="args">{{t "live.args"}}</span></span><span class="bm">{{t "live.chars" .Chars}} · {{template "dur" .PhaseStartedAt}}</span></li>{{end}}

{{define "liverows"}}{{with .Permission}}{{template "permrow" .}}{{end}}{{with .Running}}{{template "runrow" .}}{{end}}{{with .Generating}}{{if eq .Kind "tool"}}{{template "genrow" .}}{{end}}{{end}}{{end}}

{{define "slots"}}{{range .}}{{if .Permission}}{{template "permrow" .Permission}}{{else if .Finished}}{{template "batch" .Finished}}{{else if .Running}}{{template "runrow" .Running}}{{else if .Generating}}{{template "genrow" .Generating}}{{else}}<li class="brow ph"><span class="mk">-</span></li>{{end}}{{end}}{{end}}

{{/* tphase is the agents popover's phase pill: phase without the spinner, since
in the popover only a live tool row spins and an agent's mark is a pulsing dot.
The session index row keeps phase. */}}
{{define "tphase"}}{{if or (eq . "thinking") (eq . "replying") (eq . "tool") (eq . "compacting")}}<span class="phase {{.}}">{{t (printf "phase.%s" .)}}</span>{{else}}{{template "phase" .}}{{end}}{{end}}

{{define "r-tree"}}<div class="ag-source" hidden data-sub="{{.Tree.Subagents.Direct}}" data-subdeep="{{.Tree.Subagents.Deep}}">{{range .Tree.CompactAgents}}<div class="compact-agent"><summary class="ahead"><span class="aline"><span class="amk">{{if .Harness}}<span class="hb sm" data-h="{{.Harness}}"></span>{{else if eq .AgentKind "pi"}}<span class="pibadge" title="{{t "agent.pi"}}">pi</span>{{else}}<span class="pulse"></span>{{end}}</span><span class="aname">{{if .Label}}{{.Label}}{{else}}{{t "agent.name" (shortID .ID)}}{{end}}</span>{{template "tphase" .Phase}}</span><span class="am">{{if .ActiveSince}}{{template "dur" .ActiveSince}}{{else}}{{template "span" .ActiveMs}}{{end}}</span></summary></div>{{end}}</div><div class="thead">{{icon "agents"}}{{t "tree.agents"}}<span class="sum"><span class="chip crun">{{t "tree.running" .Tree.Running}}</span><span class="chip cdone">{{t "tree.done" .Tree.Finished}}</span><span class="chip cfail">{{t "tree.failed" .Tree.Failed}}</span><span class="chip">{{icon "mail"}}{{len .Tree.Peers.Live}}</span>{{with .Tasks}}<span class="chip bgt" title="{{t "tree.bg.title"}}">{{t "tree.bgchip" .}}</span>{{end}}</span></div><div class="tree"><div class="agent root {{.Lead.Phase}}"><details data-key="agent-lead"><summary class="ahead"><span class="amk">{{template "mark" .Lead.Phase}}</span><span class="aname">{{t "tree.lead"}}</span>{{template "tphase" .Lead.Phase}}<span class="ldet">{{if .Lead.Permission}}<span class="tn" title="{{.Lead.Permission.ToolName}}">{{toolName .Lead.Permission.ToolName}}</span> <span class="args">{{.Lead.Permission.ArgsPreview}}</span>{{else if .Lead.Running}}<span class="tn" title="{{.Lead.Running.ToolName}}">{{toolName .Lead.Running.ToolName}}</span> <span class="args">{{.Lead.Running.ArgsPreview}}</span>{{else if and .Lead.Generating (eq .Lead.Generating.Kind "tool")}}<span class="tn" title="{{.Lead.Generating.ToolName}}">{{toolName .Lead.Generating.ToolName}}</span> <span class="args">{{t "live.args"}}</span>{{end}}</span><span class="am">{{if .Lead.Permission}}{{template "dur" .Lead.Permission.StartedAt}}{{else if .Lead.Running}}{{template "dur" .Lead.Running.StartedAt}}{{else if and .Lead.PhaseStartedAt (or (eq .Lead.Phase "thinking") (eq .Lead.Phase "replying") (eq .Lead.Phase "tool") (eq .Lead.Phase "compacting"))}}{{template "dur" .Lead.PhaseStartedAt}}{{end}}<span title="{{t "tree.batches.title"}}">{{tn "tree.batches" (len .Lead.Finished)}}</span>{{icon "chev"}}</span></summary><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}</ol>{{template "afull" .Lead.Finished}}</details></div>{{with .Tree.RunningAgents}}<div class="tgroup run"><div class="pghead">{{t "tree.group.running" (len .)}}</div>{{range .}}{{template "agent" .}}{{end}}</div>{{end}}{{with .Tree.EndedAgents}}<div class="tgroup ended"><div class="pghead">{{t "tree.group.ended" (len .)}}</div>{{range .}}{{template "agent" .}}{{end}}</div>{{end}}{{if or .Background .Monitors}}<div class="tgroup bg"><div class="pghead">{{t "tree.group.bg" .Tasks}}</div>{{with .Background}}<div class="tbg">{{icon "clock"}}<span title="{{t "tree.bg.title"}}">{{tn "tree.bg" .}}</span></div>{{end}}{{with .Monitors}}<div class="tbg">{{icon "clock"}}<span title="{{t "tasks.monitors.title"}}">{{tn "js.monitors" .}}</span></div>{{end}}</div>{{end}}{{template "peers" .Tree.Peers}}</div>{{end}}

{{define "aended"}}{{if eq . "background"}}{{t "agent.background"}}{{else if eq . "sleep"}}{{t "agent.sleep"}}{{else if eq . "deleted"}}{{t "agent.deleted"}}{{else if eq . "failed"}}{{t "agent.failed"}}{{else}}{{t "agent.done"}}{{end}}{{end}}

{{define "mark"}}{{if eq . "permission"}}{{icon "lock"}}{{else if or (eq . "idle") (eq . "")}}<span class="idle-dot"></span>{{else}}<span class="pulse"></span>{{end}}{{end}}

{{define "agent"}}<div class="agent {{.Status}}"><details data-key="agent-{{.ID}}"><summary class="ahead"><span class="aline"><span class="amk">{{if .IsRunning}}{{if .Harness}}<span class="hb sm" data-h="{{.Harness}}"></span>{{else if eq .AgentKind "pi"}}<span class="pibadge" title="{{t "agent.pi"}}">pi</span>{{else}}<span class="pulse"></span>{{end}}{{else if eq .Status "failed"}}✗{{else}}✓{{end}}</span><span class="aname" title="{{or .Label .ID}}">{{if .Label}}{{.Label}}{{else}}{{t "agent.name" (shortID .ID)}}{{end}}</span>{{with .ReplyID}}{{if $.Linked}}<a class="arid" href="/s/{{.}}" title="{{t "agent.open" .}}">{{shortID .}}</a>{{else}}<span class="arid nob" title="{{.}}">{{shortID .}}</span>{{end}}{{end}}{{if .IsRunning}}{{template "tphase" .Phase}}{{else if or (eq .AgentKind "pi") (gt .BackgroundTasks 0)}}<span class="chip astatus">{{template "aended" .EndedStatus}}</span>{{end}}{{with .Caption}}<span class="acap" title="{{.}}">{{.}}</span>{{end}}</span>{{template "astat" .}}<span class="am"><span class="ok" title="{{t "agent.done"}}">✓ {{.Done}}</span><span class="{{if .Failed}}f{{end}}" title="{{t "agent.failed"}}">✗ {{.Failed}}</span>{{if or .IsRunning .ActiveMs}}<span>{{with .ActiveSince}}{{template "dur" .}}{{else}}{{template "span" $.ActiveMs}}{{end}}</span>{{end}}{{icon "chev"}}</span></summary><ol class="brows">{{range .Finished}}{{template "batch" .}}{{end}}</ol>{{template "afull" .Finished}}</details>{{if .IsRunning}}<ol class="brows live bguide">{{template "slots" .Slots}}</ol>{{end}}{{with .Children}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}{{template "agent-model-hover" .}}</div>{{end}}

{{/* astat is a subagent row's telemetry: model, effort, context size, and
(while it runs) output rate, each its own stat and left out while unknown;
effort stays out of the model's ellipsis so a long model ID cannot cut it. On a narrow
agents popover a container query moves it to a second line under the row
name; aline wraps the leading items so that line can sit below them. */}}
{{define "astat"}}{{if .HasStats}}<span class="astat">{{with .DisplayModel}}<span class="amodel" title="{{if $.Observed}}{{t "hover.observed"}}{{else}}{{t "agent.model" .}}{{end}}">{{.}}</span>{{end}}{{with .Effort}}<span class="aeff" title="{{t "agent.effort" .}}">{{.}}</span>{{end}}{{with .ContextText}}<span class="actx" title="{{t "agent.context" $.ContextTokens}}">{{.}}</span>{{end}}{{with .Rate}}<span class="atps" title="{{t "agent.rate" .}}">{{.}} t/s</span>{{end}}{{if not .IsRunning}}{{with .EndedAt}}<span>{{template "ago" .}}</span>{{end}}{{end}}</span>{{end}}{{end}}

{{define "peers"}}<div class="pgroup"><div class="pghead">{{icon "mail"}}{{t "peers.title"}}<span class="chip">{{len .Live}}</span>{{with .Ended}}<span class="chip">{{t "peers.ended" (len .)}}</span>{{end}}</div>{{range .Rows}}{{template "peer" .}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "peers.hidden" .}}</div>{{end}}</div>{{end}}

{{define "pfolder"}}{{with .Folder}}<span class="pfolder">{{.}}/</span>{{end}}{{end}}

{{/* pbranch is a served peer's branch chip, drawn as the session page's git
handle draws a branch: goal and impl branches by their last segment with
their marks, a detached HEAD by its commit with the detached title, and no
chip for a root that is no repository. */}}
{{define "pbranch"}}{{with .BranchHandle}}{{if .Text}}<span class="pbr" title="{{if $.Detached}}{{t "git.detached" $.Branch}}{{else}}{{$.Branch}}{{end}}">{{if .Goal}}<span class="gh-goal">{{icon "trophy"}}</span>{{end}}{{if .Impl}}<span class="gh-impl">{{icon "hammer"}}</span>{{end}}{{if not (or .Goal .Impl)}}{{icon "branch"}}{{end}}<span class="pbt">{{.Text}}</span></span>{{end}}{{end}}{{end}}

{{/* peerrow is a peer's one-line row. A row whose name is a manual label
(PeerRow.Label) carries the labeled class on its peer element, and the
stylesheet then gives way in a fixed order as the row narrows: the harness
badge (phost, which wraps it so the badge's padding collapses too), the tool
text, the phase pill, the branch chip, and the name last. */}}
{{define "peerrow"}}<span class="amk">{{if and .Live .Adapter}}{{template "mark" .Lead.Phase}}{{else}}<span class="pdot"></span>{{end}}</span>{{if .Served}}<a class="pname" href="/s/{{.ReplyID}}"{{with .Title}} title="{{.}}"{{end}}>{{template "pfolder" .}}{{.Name}}</a>{{else}}<span class="pname"{{with .Title}} title="{{.}}"{{end}}>{{template "pfolder" .}}{{.Name}}</span>{{end}}{{template "pbranch" .}}{{if and .Harness .Live}}<span class="phost"><span class="host sm">{{.Harness}}</span></span>{{end}}{{if not .Compact}}<span class="pline">{{if not .Live}}<span class="pstate">{{t "head.ended"}}</span>{{else if not .Served}}<span class="pstate">{{t "peer.unserved"}}</span>{{else if .Adapter}}{{template "tphase" .Lead.Phase}}{{with .Lead.Running}}<span class="ptool" title="{{.ToolName}}">{{toolName .ToolName}}</span>{{end}}{{end}}</span>{{end}}<span class="am">{{if .RunningAgents}}<span class="prun" title="{{tn "peer.running" .RunningAgents}}">{{icon "agents"}}{{.RunningAgents}}</span>{{end}}{{if and .Adapter (not .Compact)}}<span title="{{t "peer.subagents"}}">{{icon "agents"}}{{.AgentCount}}</span>{{end}}<span title="{{t "peer.lastmail"}}">{{icon "mail"}}{{template "ago" .LastExchange}}</span></span>{{end}}

{{/* subbadge is the running-subagent badge on the composer's top border,
beside the interrupt badge: the page script fills its label from a convlive
region's data-sub and data-subdeep and hides it while nothing runs. Any
composer that shows a session's conversation may carry it; the tracker's
support chat card builds a plain span of it, without the id or a popover,
in script (supChat). On the session page it is a button that opens the agents
popover (agpop); there it stays shown while nothing runs, so the popover is
always reachable. */}}
{{define "subbadge"}}<span class="sbwrap"><button type="button" class="sbadge" id="sbadge" title="{{t "js.subagents.title"}}" aria-haspopup="dialog" aria-expanded="false" aria-controls="agpop" hidden><span class="spin"></span>{{icon "agents"}}<span class="slabel"></span><span class="sword">{{t "subbadge.running"}}</span></button><span class="bgbadge" id="bgbadge" title="{{t "tree.bg.title"}}" hidden>{{icon "clock"}}<span class="blabel"></span></span><span class="bgbadge" id="monbadge" title="{{t "tasks.monitors.title"}}" hidden>{{icon "clock"}}<span class="blabel"></span></span></span>{{end}}

{{/* agpop is the session's agents popover: the agents region (r-tree) over
the conversation, above the subagent badge that opens it. Its pin and close
controls and its hint sit outside the region so a region swap never takes
their focus or state; the page script (dashboard-composer.js) opens, closes
and pins it. */}}
{{define "agpop"}}<div class="agpop" id="agpop" role="dialog" aria-label="{{t "tree.agents"}}" hidden>{{region . "tree"}}<div class="agctl"><button type="button" class="agpin" id="agpin" aria-pressed="false" title="{{t "agpop.pin"}}" aria-label="{{t "agpop.pin"}}"><svg class="li" aria-hidden="true"><use href="#l-pin"/></svg></button><button type="button" class="agclose" id="agclose" title="{{t "agpop.close"}}" aria-label="{{t "agpop.close"}}">×</button></div><div class="agfoot">{{t "agpop.hint"}}</div></div>{{end}}

{{/* afull follows an expanded agent's finished batches: inside the agents
popover only the newest few show, and this action shows the rest. */}}
{{define "afull"}}{{if gt (len .) 4}}<button type="button" class="afull" data-full>{{t "tree.full"}}</button>{{end}}{{end}}

{{define "peer"}}{{if and .Served .Adapter (not .Compact)}}<details class="peer {{if .Live}}live{{else}}ended{{end}}{{if .Label}} labeled{{end}}" data-peer="{{.ReplyID}}"><summary>{{template "peerrow" .}}</summary><div class="ptree"><ol class="brows">{{range .Lead.Finished}}{{template "batch" .}}{{end}}{{template "liverows" .Lead}}</ol>{{with .Agents}}<div class="kids">{{range .}}{{template "agent" .}}{{end}}</div>{{end}}</div></details>{{else}}<div class="peer {{if .Live}}{{if .Compact}}live compact{{if not .Adapter}} nophase{{end}}{{else if .Served}}live nophase{{else}}unserved{{end}}{{else}}ended{{end}}{{if .Label}} labeled{{end}}">{{template "peerrow" .}}</div>{{end}}{{end}}

{{/* The conversation's two regions share the #convo scroll wrapper. entries
holds the finished messages, each keyed by data-entry (its ring entry name);
the page merges it by key, replacing only changed mail-wake presentations.
convlive is the rest, swapped whole: a streaming tick changes it alone. Its data-phase is
the lead's phase, which shows or hides the composer's interrupt badge;
data-turn, present while a turn runs, is that turn's start stamp, which
re-enables the badge when a new turn starts right after an interrupted one;
and data-sub and data-subdeep the running subagents (SubagentCount), which
drive the subagent badge beside it. */}}
{{define "r-entries"}}<div class="thead">{{icon "chat"}}{{t "tab.conversation"}}<span class="sum"><span class="chip">{{t "convo.user" .Conversation.Users}}</span><span class="chip">{{icon "mail"}}{{.Conversation.Mails}}</span>{{with .ModelHistory}}<button type="button" class="chip modelhistory-trigger" title="{{t "hover.history"}}" aria-label="{{t "hover.history"}}" aria-haspopup="dialog" aria-expanded="false" aria-controls="modelhistory-popover">{{icon "clock"}}</button><template class="shp-source modelhistory-source"><div class="modelhistory"><div class="shp-hd"><b class="shp-nm">{{t "hover.history"}}</b></div>{{range .}}<section class="modelhistory-agent"><div class="modelhistory-label">{{if .ID}}{{or .Label .ID}}{{else}}{{t "tree.lead"}}{{end}}</div><ol class="brows">{{template "observed-history" .Observed}}</ol></section>{{end}}</div></template>{{end}}</span></div><div class="conv centries">{{range .Conversation.Entries}}{{.Rendered}}{{end}}</div>{{end}}

{{define "r-convlive"}}<div class="conv clive" data-phase="{{.Conversation.Phase}}" data-sub="{{.Conversation.Subagents.Direct}}" data-subdeep="{{.Conversation.Subagents.Deep}}"{{with .Lead.TurnStartedAt}} data-turn="{{.}}"{{end}} data-bg="{{.Background}}" data-monitors="{{.Monitors}}">{{with .Conversation}}{{with .ToolGap}}<details class="toolsline live" data-key="tools-live"><summary class="conv-row">{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{with .Reply}}<div class="msg fromlead streaming"><div class="mh conv-row"><span class="row-icon"><span class="row-avatar">{{icon "robot"}}</span></span><span class="row-content"><b>{{t "tree.lead"}}</b></span><span class="row-time">{{template "clock" .StartedAt}}</span><span></span></div><div class="bub md">{{$.Conversation.ReplyHTML}}{{if .Truncated}} …{{end}}<span class="caret"></span></div></div>{{end}}{{if .Permission}}<div class="permwait{{if $.Hosted}} apslot{{end}}">{{icon "lock"}}<span><b>{{if $.Hosted}}{{t "convo.approval"}}{{else}}{{t "convo.perm"}}{{end}}</b> · <code title="{{.Permission.ToolName}}">{{toolName .Permission.ToolName}}</code> <span class="args">{{.Permission.ArgsPreview}}</span></span>{{template "dur" .Permission.StartedAt}}</div>{{else if eq .Phase "compacting"}}<div class="sysline compaction running"><span class="mk"><span class="spin"></span></span>{{t "convo.compacting"}}{{with $.Lead.PhaseStartedAt}}{{template "dur" .}}{{end}}</div>{{else if and .Phase (ne .Phase "idle") (ne .Phase "replying")}}<div class="activity"><span class="spin"></span><span class="act-copy">{{t "convo.activity" (phaseWord .Phase)}}{{with .Running}} · {{toolName .ToolName}}{{else}}{{with .Generating}}{{with .ToolName}} · {{toolName .}}{{end}}{{end}}{{end}}{{if gt $.Lead.PhaseStartedAt 0}} · <time class="act-t" data-ms="{{$.Lead.PhaseStartedAt}}" data-f="since">{{sinceText $.ActivityAt $.Lead.PhaseStartedAt}}</time>{{if gt $.Lead.TurnStartedAt 0}} <span class="act-turn">({{t "convo.activity.turn"}} <time class="act-t" data-ms="{{$.Lead.TurnStartedAt}}" data-f="since">{{sinceText $.ActivityAt $.Lead.TurnStartedAt}}</time>)</span>{{end}}{{else if gt $.Lead.TurnStartedAt 0}} · <time class="act-t" data-ms="{{$.Lead.TurnStartedAt}}" data-f="since">{{sinceText $.ActivityAt $.Lead.TurnStartedAt}}</time>{{end}}</span></div>{{end}}{{with .Summary}}{{template "reasoningsummary" .}}{{end}}{{with $.Host}}{{with .Retry}}<div class="sysline retry running"><span class="mk"><span class="spin"></span></span><span class="nt">{{if .MaxRetries}}{{t "convo.retry" .Attempt .MaxRetries}}{{else}}{{t "convo.retry.n" .Attempt}}{{end}}{{with .Error}}: {{.}}{{end}}</span></div>{{end}}{{end}}{{range .Held}}{{template "held" .}}{{end}}<div class="sentdata" hidden>{{range .Sent}}<i data-id="{{.ID}}" data-answer="{{.Answer}}" data-note="{{.Note}}" data-state="{{if .Held}}held{{else}}sent{{end}}"></i>{{end}}</div>{{end}}</div>{{end}}

{{/* The status band (pageview_band.go): ctx is the context bar above the
message box, scaled to ws compaction thresholds when present; sline stays an
empty region while .fpills outside it owns the slim Model/Effort strip. */}}
{{define "r-ctx"}}{{with .Band.Context}}<div class="sb sb-top"><div class="sb-ctx{{with .Level}} {{.}}{{end}}" tabindex="0" role="meter" aria-label="{{if .Known}}{{t "band.ctx.title" .Percent .FullTokens}}{{else}}{{t "band.ctx.unknown" .FullTokens}}{{end}}" aria-valuemin="0" aria-valuemax="100"{{if .Known}} aria-valuenow="{{.Fill}}"{{end}}><span class="sb-pct">{{if .Known}}{{.Percent}}%{{else}}?{{end}}</span><div class="sb-bar-wrap">{{if .FloatIcon}}<span class="sb-float{{if .FloatAtHard}} at-hard{{end}}" style="{{if not .FloatAtHard}}left:{{.FloatLeft}}%;{{end}}--fc:{{.FloatColor}}" title="{{ctxBoundaryTitle .FloatIcon .FloatTitleArg}}"><svg class="li" aria-hidden="true"><use href="#l-{{.FloatIcon}}"/></svg></span>{{end}}<div class="sb-bar" aria-hidden="true"><i class="fill" style="width: {{.FillWidth}}%"></i>{{with .SoftPct}}<u class="m-soft" style="left: {{.}}%"></u>{{end}}{{range .MilestonePcts}}<u class="m-tick" style="left: {{.}}%"></u>{{end}}</div></div><span class="sb-tok">{{.Tokens}}{{with .Native}}<span class="sb-native"> ({{.}})</span>{{end}}</span>{{with .Cache}}<span class="sb-cache" title="{{t "band.cache.title"}}">{{t "band.cache" .}}</span>{{end}}</div><div class="ctx-tip" role="tooltip"><div class="ctx-tip-grid"><span>{{t "band.ctx.tip.current"}}</span><span>{{if .Known}}{{.TipCurrent}}{{else}}{{t "band.ctx.tip.unknown"}}{{end}}</span>{{with .TipSoft}}<span>{{t "band.ctx.tip.soft"}}</span><span>{{.}}</span>{{end}}{{with .TipM1}}<span>{{t "band.ctx.tip.m1"}}</span><span>{{.}}</span>{{end}}{{with .TipM2}}<span>{{t "band.ctx.tip.m2"}}</span><span>{{.}}</span>{{end}}{{with .TipHard}}<span>{{t "band.ctx.tip.hard"}}</span><span>{{.}}</span>{{end}}{{with .TipNative}}<span>{{t "band.ctx.tip.native"}}</span><span>{{.}}</span>{{end}}{{with .Cache}}<span>{{t "band.cache.title"}}</span><span>{{.}}</span>{{end}}</div></div></div>{{end}}{{end}}

{{/* composerpills: slim 2-control strip (Model + Effort only, decision (38))
rendered outside SSE-swapped r-sline so popovers and focus survive swaps. */}}
{{define "composerpills"}}<div class="fpills" id="composer-pills"><div class="fpill-wrap"><button type="button" class="fpill" data-pop="model" aria-haspopup="listbox" aria-expanded="false"{{if not .CanEditSettings}} disabled{{end}} title="{{if .IsChild}}{{t "js.lead.controls.child"}}{{else if not .CanEditSettings}}{{t "js.lead.controls.host"}}{{else}}{{t "js.lead.controls.model"}}{{end}}"><svg class="i li ico" aria-hidden="true"><use href="#l-cpu"/></svg><span class="pv">{{or .Model (t "js.sup.default")}}</span>{{if .IsChild}}<svg class="i li lock" aria-hidden="true"><use href="#l-lock"/></svg>{{else}}<svg class="i li chev" aria-hidden="true"><use href="#l-chevron-down"/></svg>{{end}}</button></div><div class="fpill-wrap"><button type="button" class="fpill" data-pop="effort" aria-haspopup="listbox" aria-expanded="false"{{if not .CanEditSettings}} disabled{{end}} title="{{if .IsChild}}{{t "js.lead.controls.child"}}{{else if not .CanEditSettings}}{{t "js.lead.controls.host"}}{{else}}{{t "js.lead.controls.effort"}}{{end}}"><svg class="i li ico" aria-hidden="true"><use href="#l-gauge"/></svg><span class="pv">{{or .Effort (t "js.sup.default")}}</span>{{if .IsChild}}<svg class="i li lock" aria-hidden="true"><use href="#l-lock"/></svg>{{else}}<svg class="i li chev" aria-hidden="true"><use href="#l-chevron-down"/></svg>{{end}}</button></div></div>{{end}}

{{/* cmds: the slash commands the session's adapter runs, hidden data the
composer's command picker reads (dashboard.js commandList); empty when the
adapter reports none, and then the page offers no picker. The session page
carries it for a browser on this machine only (SysOpen), since the daemon
holds a dashboard command from no other viewer (sendCommand). */}}
{{define "r-cmds"}}{{range .Commands}}<i data-name="{{.Name}}"{{with .Description}} data-desc="{{.}}"{{end}}{{with .Source}} data-src="{{.}}"{{end}}{{with .Layer}} data-layer="{{.}}"{{end}}></i>{{end}}{{end}}

{{define "r-sline"}}{{end}}

{{/* The git handle (gitbadge.go): the drawer handle left of the side-panel
handle, which opens the git drawer (gitbody). It shows the session root's
branch abbreviated (GitHandle: a hammer for an impl branch, a gold trophy for a
goal branch, each with the stem), the ahead and behind counts against its
upstream, and a dot for a dirty working tree; its title spells the whole
branch and the title of the ticket the stem names. A root that is no
repository has none. at carries the read's time, so every read swaps the
region. */}}
{{define "r-git"}}{{with .Git}}{{if ne .State "norepo"}}<button type="button" class="gh {{.State}}" id="ghandle" aria-controls="drsheet" aria-expanded="false" data-at="{{.At}}" title="{{if eq .State "failed"}}{{t "git.failed.title" .Err}}{{else if eq .State "pending"}}{{t "git.pending"}}{{else}}{{if .Detached}}{{t "git.detached" .Branch}}{{else}}{{.Branch}}{{end}}{{with .Ticket}}&#10;{{.}}{{end}}{{if or .Modified .Staged .Untracked}}&#10;{{t "git.dirty"}}{{end}}{{end}}">{{if eq .State "ok"}}{{with .Handle}}{{if .Goal}}<span class="gh-goal">{{icon "trophy"}}</span>{{end}}{{if .Impl}}<span class="gh-impl">{{icon "hammer"}}</span>{{end}}{{if not (or .Goal .Impl)}}{{icon "branch"}}{{end}}<span class="gh-br">{{.Text}}</span>{{end}}{{if or .Ahead .Behind}}<span class="gh-ab">{{with .Ahead}}<b class="up">↑{{.}}</b>{{end}}{{with .Behind}}<b class="dn">↓{{.}}</b>{{end}}</span>{{end}}{{if or .Modified .Staged .Untracked}}<span class="gh-dirty"></span>{{end}}{{else}}{{icon "branch"}}<span class="gh-br">{{if eq .State "failed"}}{{t "git.failed"}}{{else}}…{{end}}</span>{{end}}</button>{{end}}{{end}}{{end}}

{{/* held: a message the session has not received yet. A slash command's
bubble shows its typed line; its steer control sends that line as steered
text the agent acts on itself (wsinbox.Steer). */}}
{{define "held"}}<div class="msg user held{{if .Command}} hcmd{{end}}" data-entry="{{.ID}}"><div class="mh"><span class="src wb">{{t "origin.whiteboard"}}</span>{{if .Steer}}<span class="heldtag steertag" title="{{t "held.steer.title"}}">{{t "held.steer"}}</span>{{else}}<span class="heldtag" title="{{t "held.held.title"}}">{{t "held.held"}}</span>{{end}}{{template "clock" .At}}{{if not .Steer}}{{template "hsteer" .ID}}{{end}}{{template "hcancel" .ID}}</div><div class="bub">{{with .Command}}<code class="cmdtyped">/{{.Name}}{{with .Args}} {{.}}{{end}}</code>{{else}}{{template "achips" .}}{{if .Content}}{{template "selection-content" .Content}}{{else}}{{range $i, $p := .Parts}}{{if $i}}<hr class="pdiv">{{end}}<div class="hpart">{{marked $p}}</div>{{end}}{{end}}{{with .Images}}{{template "thumbs" .}}{{end}}{{end}}</div></div>{{end}}
{{/* hsteer and hcancel: a held bubble's buttons, for its ID. The composer's
heldacts template holds an empty-ID pair the client clones for the outbox: both
onto the bubble it builds for a send the daemon just held (outboxBubble),
before the server renders this one, and the cancel onto a send's row while
its post is unanswered (outboxRow). */}}
{{define "hsteer"}}<button class="btn mini hsteer" data-steer="{{.}}" title="{{t "held.steerbtn.title"}}">{{icon "arrow"}}{{t "held.steer"}}</button>{{end}}
{{define "hcancel"}}<button class="btn mini hcancel" data-cancel="{{.}}" title="{{t "held.cancel.title"}}">{{icon "x"}}{{t "held.cancel"}}</button>{{end}}
{{/* achips: a user message's answer capsules, above its text, styled as the
composer's chips: "(ids) value" with the note beside it, a topic note as
"[topic]" and its note. A held bubble lists one per chip, a delivered one
one per line of the answer block its text started with. The message's
mentions follow as "[topic] (id)" and an excerpt of the selected text, then
a picked page element as its selector and text, and attached console errors
as "console xN" and the page's URL. */}}
{{define "achips"}}{{if or .Answers .Mentions .CloseRequests .Picks .Consoles}}<div class="hchips">{{range .AnswerChips}}{{if .Topic}}<span class="achip tchip" title="{{.Note}}" role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}"><b>[{{.Topic}}]</b><span class="anote">{{.Note}}</span></span>{{else}}<span class="achip"{{with .Note}} title="{{.}}"{{end}}{{if .Target}} role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}"{{end}}><b>({{.IDs}})</b> {{or .Value "note"}}{{with .Note}}<span class="anote">{{.}}</span>{{end}}</span>{{end}}{{end}}{{range .MentionChips}}<span class="achip mchip" title="{{.Text}}" role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}"><b>[{{.Topic}}]{{with .IDs}} ({{.}}){{end}}</b><span class="anote">{{.Text}}</span></span>{{end}}{{range .CloseRequests}}<span class="achip close-request-chip"><b>{{t "js.closerequest.label" .Topic}}</b>{{with .Reason}}<span class="anote" title="{{.}}">{{.}}</span>{{end}}</span>{{end}}{{range .Picks}}<span class="achip mchip pchip" title="{{.URL}}&#10;{{.Selector}}{{with .Text}}&#10;{{.}}{{end}}"><b>{{.Selector}}</b>{{with .Text}}<span class="anote">{{.}}</span>{{end}}</span>{{end}}{{range .Consoles}}<span class="achip mchip cchip" title="{{.URL}}{{range .Lines}}&#10;{{.}}{{end}}"><b>console &times;{{len .Lines}}</b><span class="anote">{{.URL}}</span></span>{{end}}</div>{{end}}{{end}}

{{/* Selection source and memo stay plain escaped text; only the parser's
image-reference tail owns thumbnails. A failed group remains wholly literal. */}}
{{define "selection-content"}}{{range .}}{{with .Selection}}<section class="selection-bundle"><div class="selection-quotes">{{range .Mentions}}<p class="selection-quote"{{with .Entry}} data-wb-entry="{{.}}"{{end}}><b class="selection-topic">[{{.Topic}}]{{with .ID}} ({{.}}){{end}}</b> <span class="anote">{{.Text}}</span></p>{{end}}</div><div class="selection-comment">{{.Comment}}</div>{{with .Images}}{{template "thumbs" .}}{{end}}</section>{{else}}{{if .Plain}}{{.Text}}{{else}}{{marked .Text}}{{end}}{{end}}{{end}}{{end}}

{{define "thumbs"}}<div class="thumbs">{{range .}}{{if .Src}}<a class="thumb" href="{{.Src}}" target="_blank" rel="noopener noreferrer" title="{{.Path}}"><img src="{{.Src}}" alt="{{.Name}}" loading="lazy">{{with .Num}}<span class="tnum">#{{.}}</span>{{end}}</a>{{else if .Path}}<span class="ipath">{{if .Num}}Image #{{.Num}}: {{.Path}}{{else}}[image: {{.Path}}]{{end}}</span>{{else}}<span class="ipath">[Image #{{.Num}}]</span>{{end}}{{end}}</div>{{end}}

{{define "origin"}}{{if eq . "whiteboard"}}<span class="src wb">{{t "origin.whiteboard"}}</span>{{else if eq . "mail"}}<span class="src mail">{{t "origin.mail"}}</span>{{else if eq . "terminal"}}<span class="src">{{t "origin.terminal"}}</span>{{end}}{{end}}

{{/* msgacts: a finished chat block's hover actions, a sibling of its bubble
(a finished reply's bubble clips paint). Copy reads the block's stored text
from the entry text route (entry_text_route.go) on click; an owner prompt
also gets rewind and edit, placeholders the harness cannot serve yet:
aria-disabled, not disabled, so they stay focusable and their tooltip
reachable. A streaming reply and a held message have none. */}}
{{define "msgacts"}}<div class="d-acts" role="toolbar" aria-label="{{t "entry.act.label"}}">{{if eq .Kind "user"}}<button type="button" class="d-act" data-act="rewind" aria-disabled="true" aria-label="{{t "entry.act.rewind"}}" data-tip="{{t "entry.act.rewind"}}">{{icon "undo"}}</button><button type="button" class="d-act" data-act="edit" aria-disabled="true" aria-label="{{t "entry.act.edit"}}" data-tip="{{t "entry.act.edit"}}">{{icon "pencil"}}</button>{{end}}<button type="button" class="d-act" data-act="copy" aria-label="{{if .Truncated}}{{t "entry.act.copy.part"}}{{else}}{{t "entry.act.copy"}}{{end}}" data-tip="{{if .Truncated}}{{t "entry.act.copy.part"}}{{else}}{{t "entry.act.copy"}}{{end}}"><span class="d-act-cp">{{icon "copy"}}</span><span class="d-act-ok">{{icon "check"}}</span><span class="d-act-done">{{if .Truncated}}{{t "entry.act.copied.part"}}{{else}}{{t "entry.act.copied"}}{{end}}</span></button></div>{{end}}

{{define "userentry"}}<div class="msg user"{{with .Key}} data-entry="{{.}}"{{end}}><div class="mh">{{template "origin" .Origin}}{{if .EnvelopeAt}}<time class="t" data-ms="{{.At}}" data-f="user" datetime="{{.EnvelopeAt}}" title="{{.EnvelopeAt}}">{{.EnvelopeAt}}</time>{{else}}{{template "clock" .At}}{{end}}</div><div class="bub">{{template "achips" .}}{{if .Content}}{{template "selection-content" .Content}}{{else}}{{marked .Text}}{{end}}{{if .Truncated}} …{{end}}{{with .Images}}{{template "thumbs" .}}{{end}}</div>{{template "msgacts" .}}</div>{{end}}

{{define "entry"}}{{if .MailWakeSuppressed}}<span hidden data-entry="{{.Key}}" data-mail-wake="suppressed"></span>{{else if eq .Kind "user"}}{{if .UserBlocks}}<div class="user-batch" data-entry="{{.Key}}">{{range .UserBlocks}}{{template "userentry" .}}{{end}}</div>{{else}}{{template "userentry" .}}{{end}}{{else if eq .Kind "reply"}}<div class="msg fromlead" data-entry="{{.Key}}"><div class="mh conv-row"><span class="row-icon"><span class="row-avatar">{{icon "robot"}}</span></span><span class="row-content"><b>{{t "tree.lead"}}</b></span><span class="row-time">{{template "clock" .At}}</span><span></span></div><div class="bub md">{{.HTML}}{{if .Truncated}} …{{end}}</div>{{template "msgacts" .}}</div>{{else if eq .Kind "whiteboard-effects"}}{{template "whiteboardentry" .}}{{else if eq .Kind "wake"}}{{template "wakeentry" .}}{{else if eq .Kind "turn"}}{{$summary := .Summary}}{{if $summary}}<div class="turn-with-summary" data-entry="{{.Key}}">{{template "reasoningsummary" $summary}}{{end}}<div class="turnline{{if .WakeTurn}} wake-turn{{end}}"{{if not $summary}} data-entry="{{.Key}}"{{end}}>{{if .WakeTurn}}↳ {{t "entry.leadturn" .Done}}{{else}}{{template "origin" .Origin}}{{t "entry.turn" .Done}}{{end}}{{with .Failed}} · {{t "count.failed" .}}{{end}}{{with .DurationMs}} · {{template "span" .}}{{end}}</div>{{if $summary}}</div>{{end}}{{else if eq .Kind "tools"}}{{with .Tools}}<details class="toolsline" data-entry="{{$.Key}}" data-key="tools-{{$.Key}}"><summary class="conv-row">{{template "toolsum" .}}</summary>{{template "toolbatches" .}}</details>{{end}}{{else if eq .Kind "compact"}}<div class="sysline compaction{{if .CompactFailed}} fail{{end}}" data-entry="{{.Key}}">{{if .CompactFailed}}<span class="mk">✗</span><span class="nt">{{t "entry.compact.failed"}}{{with .Text}}: {{.}}{{end}}</span>{{else}}<span class="mk">✓</span>{{t "entry.compact.done"}}{{if eq .Trigger "auto"}} {{t "entry.compact.auto"}}{{else if eq .Trigger "manual"}} {{t "entry.compact.manual"}}{{end}}{{end}}{{template "clock" .At}}</div>{{else if eq .Kind "mail"}}{{if or .PeerLead .MatchedMailWake}}{{template "peermailentry" .}}{{else if .HasBody}}<details class="mailline {{.Direction}}" data-entry="{{.Key}}" data-key="mail-{{.Key}}"><summary class="conv-row">{{template "mailhead" .}}</summary><div class="mbody">{{.Body}}</div></details>{{else}}<div class="mailline {{.Direction}} nobody" data-entry="{{.Key}}"><div class="conv-row">{{template "mailhead" .}}</div></div>{{end}}{{else if eq .Kind "card"}}{{with .Card}}<div class="cardref" data-entry="{{$.Key}}" data-tk-store="{{.Store}}" data-tk-alias="{{.Alias}}" title="{{t "entry.card.title" .Store}}"><span class="crk">{{t "entry.card"}}</span><b class="cra">{{.Alias}}</b>{{with .Title}}<span class="crt">{{.}}</span>{{end}}</div>{{end}}{{else if eq .Kind "notice"}}{{with .Notice}}<div class="sysline notice fail" data-entry="{{$.Key}}" data-notice="{{.Kind}}"><span class="mk">✗</span><span class="nt"><b>{{template "noticeword" .Kind}}</b>{{if and (eq .Kind "usage_limit") (gt .ResetsAt 0)}} · {{t "notice.resets"}} <time class="t" data-ms="{{.ResetsAt}}" data-f="dt">{{clock .ResetsAt}}</time>{{end}}{{with .Text}}: {{.}}{{end}}</span>{{template "clock" $.At}}</div>{{end}}{{else if eq .Kind "command"}}<div class="cmdrun" data-entry="{{.Key}}"><div class="cmdecho"><span class="mk">❯</span><code>{{.Command}}</code>{{template "clock" .At}}</div>{{if .Text}}<pre class="cmdout">{{.Text}}{{if .Truncated}} …{{end}}</pre>{{else}}<div class="cmdnote">{{t "entry.command.terminal"}}</div>{{end}}</div>{{else if eq .Kind "ui"}}{{with .UI}}<div class="sysline uiline" data-entry="{{$.Key}}" data-ui-op="{{.Op}}" data-ui-arg="{{.Arg}}"{{with .Comment}} data-ui-comment="{{.}}"{{end}} title="{{t "entry.ui"}}"><span class="mk">↗</span>{{if eq .Op "search"}}{{t "entry.ui.search" .Arg}}{{else if eq .Op "focus"}}{{with .Comment}}{{t "entry.ui.focus.comment" $.UI.Arg .}}{{else}}{{t "entry.ui.focus" .Arg}}{{end}}{{else if eq .Op "scope"}}{{t "entry.ui.scope" .Arg}}{{else}}{{t "entry.ui.view" .Arg}}{{end}}</div>{{end}}{{end}}{{end}}

{{/* Summary text is escaped plain text, never marked or reply markdown. */}}
{{define "reasoningsummary"}}<details class="d-summary {{if .Live}}live{{else}}saved{{end}}" data-key="{{.Key}}"{{if .Live}} open{{end}}><summary>{{icon "chev"}}<span class="d-label">{{t "summary.label"}}</span><span class="d-meta">{{t "summary.provider"}}</span>{{if .Streaming}}<span class="d-updating">{{t "summary.updating"}}</span>{{else if not .Live}}<span class="d-meta d-open">{{t "summary.expand"}}</span><span class="d-meta d-close">{{t "summary.collapse"}}</span>{{end}}</summary><div class="d-body">{{range .Requests}}<div class="d-attempt"><div class="d-meta">{{t "summary.attempt" .Request .Attempt}} · {{.Provider}} / {{.API}} / {{.Model}} · {{template "summarystatus" .Status}}{{if .Truncated}} · {{t "summary.clipped"}}{{end}}</div>{{range .Parts}}{{if .Text}}<div class="d-part"><span class="d-meta">{{t "summary.part" .Output .Part}} · {{template "summarystatus" .Status}}{{if .Truncated}} · {{t "summary.bytes" .RetainedBytes .ObservedBytes}}{{end}}</span><p>{{.Text}}</p></div>{{end}}{{end}}</div>{{end}}{{if .Truncated}}<span class="d-provenance">{{t "summary.clipped"}}</span>{{end}}<span class="d-provenance">{{if .Live}}{{t "summary.observed"}}{{else}}{{t "summary.retained"}}{{end}}</span></div></details>{{end}}
{{define "summarystatus"}}{{if eq . "streaming"}}{{t "summary.streaming"}}{{else if eq . "complete"}}{{t "summary.complete"}}{{else if eq . "aborted"}}{{t "summary.aborted"}}{{else if eq . "failed"}}{{t "summary.failed"}}{{else if eq . "incomplete"}}{{t "summary.incomplete"}}{{end}}{{end}}

{{/* Panels are recap-only. Other effects and unsupported fallback are escaped
text: no markdown, iframe, or client-side HTML interpretation here. */}}
{{define "whiteboardentry"}}{{$card := .WhiteboardCard}}<article class="wbeffects wbupdate" data-entry="{{.Key}}"><div class="wbupdate-head"><b>{{t "entry.whiteboard"}}</b>{{template "clock" .At}}</div>{{template "whiteboardtopics" $card}}{{template "whiteboarddiagnostics" .}}</article>{{end}}

{{define "whiteboardtopics"}}{{range .Topics}}<section class="wbupdate-topic"{{with .Target}} data-wb-topic="{{.}}"{{end}}><div class="wbupdate-bar"><b>{{or .Label .Name (t "entry.whiteboard")}}</b>{{if and .Label (ne .Label .Name)}}<span class="wbupdate-key">{{.Name}}</span>{{end}}{{if .Target}}<a href="#{{.Target}}" data-wb-jump="{{.Target}}" data-wb-topic="{{.Target}}">{{t "entry.whiteboard.topic"}} ↗</a>{{end}}</div><div class="wbupdate-rows">{{$topic := .Target}}{{with .Items}}<div class="wbupdate-items">{{range .}}{{if and .Target $topic}}<a class="wbupdate-item-id" href="#{{.Target}}" data-wb-jump="{{.Target}}" data-wb-topic="{{$topic}}">({{.ID}})</a>{{else}}<span class="wbupdate-item-id">({{.ID}})</span>{{end}}{{end}}</div>{{end}}{{range .Rows}}<div class="wbupdate-row wbupdate-{{.Kind}}"{{if and .Target $topic}} data-wb-element="{{.Target}}"{{if eq .Kind "log"}} tabindex="0" role="link"{{end}}{{end}}>{{if eq .Kind "log"}}<span class="wbupdate-l">L</span>{{else if eq .Kind "panel"}}<span class="wbupdate-panel-label">{{icon "board"}}{{t "entry.whiteboard.panel"}}</span>{{end}}<span class="wbupdate-text">{{if .Text}}{{range .Parts}}{{if .Target}}<span class="wbref" role="link" tabindex="0" data-wb-nav="{{.Target}}" data-wb-topic="{{.TopicTarget}}">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}{{else if eq .Kind "panel"}}{{t "entry.whiteboard.norecap"}}{{end}}</span>{{if and (eq .Kind "panel") .Target $topic}}<a href="#{{.Target}}" data-wb-jump="{{.Target}}" data-wb-topic="{{$topic}}">#{{.Target}}</a>{{end}}</div>{{end}}</div><span class="wbupdate-status" role="status" aria-live="polite"></span></section>{{end}}{{end}}

{{define "whiteboarddiagnostics"}}{{if not .WhiteboardChanges}}<p class="wbeffect-note">{{t "entry.whiteboard.unavailable"}}</p><pre class="wbeffect-fallback">{{.WhiteboardFallback}}</pre>{{end}}{{if .Truncated}}<p class="wbeffect-note">{{t "entry.whiteboard.truncated"}}</p>{{end}}{{end}}

{{define "wakeentry"}}{{if .MailWake}}<details class="mail-notification" data-entry="{{.Key}}" data-key="wake-{{.Key}}"{{with .BoardNudgeState}} data-mail-wake="{{.}}"{{end}}><summary class="conv-row"><span class="row-icon">{{icon "mail"}}</span><span class="row-content">{{with .BoardNudgeSummary}}<b>{{.}}</b>{{else}}<b>{{t "entry.mail.notification"}}</b><span class="src">{{t "entry.mail.unmatched"}}</span>{{end}}</span><span class="row-time">{{template "clock" .At}}</span><span class="row-chevron">{{icon "chev"}}</span></summary><div class="row-details"><pre class="wake-body">{{.WakeText}}{{if .Truncated}} …{{end}}</pre></div></details>{{else if .ChildReport}}<details class="mailline recv child-report" data-entry="{{.Key}}" data-key="wake-{{.Key}}"><summary class="conv-row">{{template "agenthead" .}}</summary><div class="row-details"><div class="mbody">{{with .Caption}}<span class="wake-caption">{{.}}</span>{{end}}{{with .Text}}<pre class="wake-body">{{.}}{{if $.Truncated}} …{{end}}</pre>{{end}}</div></div></details>{{else if or (eq .Cause "subagent_done") (eq .Cause "subagent_failed") (eq .Cause "background_exit")}}<div class="mailline recv agent-note{{if eq .Cause "subagent_failed"}} fail{{end}}" data-entry="{{.Key}}"><div class="conv-row">{{template "agenthead" .}}</div></div>{{else}}<details class="mailline recv agent-card" data-entry="{{.Key}}" data-key="wake-{{.Key}}"><summary class="conv-row">{{template "agenthead" .}}</summary><div class="row-details">{{with .Text}}<pre class="wake-body">{{.}}{{if $.Truncated}} …{{end}}</pre>{{end}}</div></details>{{end}}{{end}}

{{/* noticeword names a typed failure's kind (wslive.Notice): a notice
line, the head's failure chip, and a rail row's error ring title. */}}
{{define "noticeword"}}{{if eq . "login"}}{{t "notice.login"}}{{else if eq . "model"}}{{t "notice.model"}}{{else}}{{t "notice.limit"}}{{end}}{{end}}

{{/* toolsum and toolbatches draw a ToolSummary: the lead's finished tool calls between two conversation entries (a tools ring entry), or so far in the open stretch (convlive). */}}
{{define "toolsum"}}<span class="row-icon">{{icon "hammer"}}</span><span class="row-content tsum"><span class="tsl">{{range $i, $t := .Tools}}{{if $i}} · {{end}}<span title="{{$t.Name}}">{{toolName $t.Name}}</span> {{$t.Calls}}{{end}}{{with .OtherCalls}}{{if $.Tools}} · {{t "tools.rest" .}}{{else}}{{t "tools.calls" .}}{{end}}{{end}}</span>{{if or .Failed .Usage}}<span class="tsn">{{with .Failed}}<b class="tf">{{t "count.failed" .}}</b>{{end}}{{with .Usage}}{{if $.Failed}} · {{end}}<span class="ttok" title="{{tokenTitle (requests $) .}}">{{tokenText (requests $) .}}</span>{{end}}</span>{{end}}</span><span class="row-time">{{with .DurationMs}}{{template "span" .}}{{end}}</span><span class="row-chevron">{{icon "chev"}}</span>{{end}}
{{define "toolbatches"}}<ol class="brows">{{range .Batches}}{{$args := batchArgs .}}{{$list := argsList .}}<li class="brow {{if .Failed}}fail{{else}}done{{end}}"><span class="mk">{{if .Failed}}✗{{else}}✓{{end}}</span><span class="bp{{if $args}} one{{end}}"{{with $list}} title="{{.}}"{{end}}>{{if .Tools}}{{range .Tools}}<span class="tool"{{if not $list}} title="{{.Name}}"{{end}}>{{toolName .Name}}{{if gt .Calls 1}}<b class="x">×{{.Calls}}</b>{{end}}</span>{{end}}{{else}}{{range .Names}}<span class="tool"{{if not $list}} title="{{.}}"{{end}}>{{toolName .}}</span>{{end}}{{end}}{{with $args}}<span class="ba" title="{{.}}">{{.}}</span>{{end}}</span><span class="bm">{{range batchNums .}}{{.Sep}}<span{{with .Class}} class="{{.}}"{{end}} title="{{.Title}}">{{.Text}}</span>{{end}}</span></li>{{end}}{{with .BatchesOmitted}}<li class="brow more"><span class="mk"></span><span class="bp">{{t "tools.more" .}}</span><span class="bm"></span></li>{{end}}</ol>{{end}}
{{define "peermailentry"}}<article class="mail-block" data-entry="{{.Key}}"{{if .MatchedMailWake}} data-mail-wake="matched"{{end}}><details class="mailline {{.Direction}}" data-key="mail-{{.Key}}"><summary class="conv-row">{{template "mailhead" .}}</summary><div class="row-details"><div class="mbody">{{.MailBody}}</div><pre class="wake-body mail-delivery">{{.MailDeliveryText}}</pre></div></details></article>{{end}}
{{define "agenthead"}}<span class="row-icon"><span class="arr">←</span>{{icon "robot"}}</span><span class="row-content"><span class="mpeer">{{or .Source .Cause}}</span>{{with .AgentBadge}}<span class="src">{{.}}</span>{{end}}<span class="mfirst">{{.AgentPreview}}</span></span><span class="row-time">{{template "clock" .At}}</span><span class="row-chevron">{{if .AgentExpands}}{{icon "chev"}}{{end}}</span>{{end}}
{{define "mailhead"}}<span class="row-icon"><span class="arr">{{if eq .Direction "sent"}}→{{else}}←{{end}}</span><svg class="i mail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span class="row-content">{{if .PeerLinked}}<a class="mpeer" href="/s/{{.PeerReplyID}}"{{if .PeerLabel}} title="{{.Peer}}"{{end}}>{{or .PeerLabel .Peer}}</a>{{else}}<span class="mpeer">{{.Peer}}</span>{{end}}{{if .PeerLead}}<span class="src peer-lead">{{t "entry.mail.peerlead"}}</span>{{end}}<span class="mfirst">{{.MailPreview}}</span></span><span class="row-time">{{template "clock" .At}}</span><span class="row-chevron">{{if .HasBody}}{{icon "chev"}}{{end}}</span>{{end}}

{{define "index"}}<!DOCTYPE html>
<html data-mode="index" data-rid="" data-assets="{{.Assets.ID}}" data-wb-titlehost data-lang="{{lang}}" data-langpref="{{.LangPref}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{if .Local}} data-sysopen="1"{{end}}{{if .Frame}} data-frame="1"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{pwa .Theme}}
<title>Werkschaft (alpha)</title>
<style>{{.Assets.WhiteboardCSS}}</style>
<style>{{.Assets.CSS}}</style>
<style>{{.Assets.TrackerCSS}}</style></head>
<body class="dash live">{{.Assets.WhiteboardSprite}}{{.Assets.Sprite}}<div class="dwrap">
<div class="top">{{template "railbtn"}}{{region . "head"}}{{template "sse"}}{{template "tcen"}}{{template "qsslot"}}</div>
<div class="dbody">{{if .Frame}}{{template "railph"}}{{else}}<aside id="rail" class="rail" aria-label="{{t "rail.title"}}">{{region . "rail"}}</aside><div class="rscrim" id="rscrim"></div>{{template "memopad"}}{{end}}<main id="grid" class="dgrid">{{template "landing" .}}</main></div>
</div>
{{if not .Frame}}{{template "settings" .}}{{end}}
<script>{{i18n}}</script>
<script>{{.Assets.ToastScript}}</script>
<script>{{.Assets.TrackerScript}}</script>
<script>{{.Assets.MentionScript}}</script>
<script>{{.Assets.RailScript}}</script>
<script>{{.Assets.MemoScript}}</script>
<script>{{.Assets.UsageScript}}</script>
<script>{{.Assets.ShellScript}}</script>
<script>{{.Assets.SelectAllScript}}</script>
<script>{{.Assets.Script}}</script>
</body></html>
{{end}}

{{/* The landing: what the index's main panel shows with no session open,
at / and after a second click on the open session's rail row closes its
view (dashboard-rail.js). The Werkschaft lockup over an illustrated how-to,
a short page that scrolls in the panel: each step a title, a line or two,
and a marked screenshot of the real dashboard (guideshot, landing_guide.go),
with no card behind them. Both lockup variants and both screenshot themes
are in the page; the stylesheet shows the ones for the page's theme. Its id
keeps an earlier /#guide address landing on the same page. */}}
{{define "landing"}}<div class="dlanding" id="guide"><div class="dlogo" role="img" aria-label="Werkschaft">{{.Assets.Logo}}</div><article class="dguide" aria-labelledby="dguide-h"><header><h2 id="dguide-h">{{t "index.guide.title"}}</h2><p>{{t "index.guide.lead"}}</p></header><ol>
<li class="dstep" data-step="open"><h3>{{t "index.guide.open"}}</h3><p>{{t "index.guide.open.sub"}}</p><figure class="dshot">{{guideshot "open" (t "index.guide.open")}}</figure></li>
<li class="dstep" data-step="workspace"><h3>{{t "index.guide.workspace"}}</h3><p>{{t "index.guide.workspace.sub"}}</p><figure class="dshot">{{guideshot "workspace" (t "index.guide.workspace")}}</figure></li>
<li class="dstep" data-step="new"><h3>{{t "index.guide.new"}}</h3><p>{{t "index.guide.new.sub"}}</p><figure class="dshot">{{guideshot "new" (t "index.guide.new")}}</figure></li>
<li class="dstep" data-step="ask"><h3>{{t "index.guide.board"}}</h3><p>{{t "index.guide.board.sub"}}</p><figure class="dshot">{{guideshot "ask" (t "index.guide.board")}}</figure></li>
<li class="dstep" data-step="board"><h3>{{t "index.guide.view"}}</h3><p>{{t "index.guide.view.sub"}}</p><figure class="dshot">{{guideshot "board" (t "index.guide.view")}}</figure></li>
<li class="dstep" data-step="answer"><h3>{{t "index.guide.answer"}}</h3><p>{{t "index.guide.answer.sub"}}</p><figure class="dshot">{{guideshot "answer" (t "index.guide.answer")}}</figure></li>
<li class="dstep" data-step="files"><h3>{{t "index.guide.files"}}</h3><p>{{t "index.guide.files.sub"}}</p><figure class="dshot">{{guideshot "files" (t "index.guide.files")}}</figure></li>
<li class="dstep" data-step="settings"><h3>{{t "index.guide.settings"}}</h3><p>{{t "index.guide.settings.sub"}}</p><figure class="dshot">{{guideshot "settings" (t "index.guide.settings")}}</figure></li>
</ol></article></div>{{end}}

{{define "r-sessions"}}<div class="totals"><span class="chip">{{t "index.live" .Live}}</span><span class="chip">{{t "index.working" .Busy}}</span></div>{{range .Projects}}<section class="project"><div class="pbar"><span class="pname">{{.Name}}</span><span class="ppath">{{.Path}}</span><span class="chip">{{len .Sessions}}</span></div>{{range .Sessions}}{{template "srow" .}}{{end}}{{if .Ended}}<div class="endedhead">{{t "head.ended"}}</div>{{range .Ended}}{{template "srow" .}}{{end}}{{end}}{{with .HiddenEnded}}<div class="thidden">{{t "index.hidden" .}}</div>{{end}}</section>{{else}}<div class="empty">{{t "index.empty"}}</div>{{end}}{{end}}

{{define "hostexit"}}<span class="host-exit">{{if eq .Reason "idle_timeout"}}{{t "phase.idle"}} · {{end}}{{t "hostexit.stopped"}}{{if .HasCode}} · {{t "hostexit.code" .Code}}{{end}}{{if .HasSignal}} · {{t "hostexit.signal" .Signal}}{{end}}{{with .Reason}} · {{.}}{{end}}{{with .StoppedAt}} · <time datetime="{{.}}">{{.}}</time>{{end}}</span>{{end}}

{{define "srow"}}<a class="sess{{if not .Live}} ended{{end}}" href="/s/{{.ReplyID}}" data-rid="{{.ReplyID}}"{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}><span class="who"><span class="rid{{if .Label}} lbl{{end}}"{{if .Label}} title="{{.ReplyID}}"{{end}}>{{or .Label .ReplyID}}</span><span class="sub">{{if .Tool}}<span class="tn">{{.Tool}}</span>{{end}}{{with .RunningAgents}}<span class="agents-mini">{{t "srow.agents" .}}</span>{{end}}{{if not .HasBoard}}<span class="agents-mini">{{t "srow.noboard"}}</span>{{end}}</span></span><span class="hostc">{{with .Harness}}<span class="host">{{.}}</span>{{end}}{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}</span>{{if .Exit}}{{template "hostexit" .Exit}}{{else if .Adapter}}{{template "phase" .Phase}}{{else}}<span class="phase none" title="{{t "srow.nolive.title"}}">{{t "srow.nolive"}}</span>{{end}}<span class="qs">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}</span><span class="when">{{template "ago" .LastSeen}}</span></a>{{end}}

{{/* The session rail (pageview_rail.go): every session page's left card,
one shared render without the viewed session (the page marks its own row,
.cur, on the client). The daemon orders the rows and workspaces by the rail
layout (rail_layout.go) and renders each row's star from it; the list
carries the layout's generation (data-lgen) and, while the layout holds no
entry, data-layout-empty, which has a browser import its retired local
order. A workspace is a
repository, its sessions under its worktrees (data-g, the worktree's path),
or a plain folder; each row is two lines, the star outside the row's link,
and an ended row a daemon can bring back carries the revive entry
(data-revive, its move) after the link, shown disabled with its reason when
the move is blocked. A parent row's live children follow it in its children
box (.rkids, data-parent): one line each, the message in the row's title,
no star, their own group in data-g and a branch tag when it is not the
parent's; the parent carries the toggle and its children's roll-ups
(.kap, .kidorb), which show while the page collapses it (kcol), and a
stored parent data-kids. A workspace bar is a container,
not a button: its collapse toggle (.wstog), the add-worktree + (a repository
on a daemon that keeps stored workspaces), and forget (a stored workspace)
are sibling buttons. Every worktree heading (.wthd), admitted, pending or
rejected, is a focusable link (tabindex, role) that opens the worktree page
on click and on Enter (dashboard-rail.js openWorktree). */}}
{{define "r-rail"}}<div class="rhd"><b class="rtitle">{{t "rail.title"}}</b>{{if .CanAdd}}<button type="button" class="radd" data-add="ws" title="{{t "rail.ws.add"}}" aria-label="{{t "rail.ws.add"}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}<span class="rsp"></span><span class="chip" title="{{t "rail.live.title"}}">{{t "index.live" .Live}}</span>{{with .CountApproval}}<span class="chip perm" title="{{t "rail.approvals"}}">{{icon "lock"}}{{.}}</span>{{end}}{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{if .CanSpawn}}<button type="button" class="rref rsleep" id="railsleep"{{if not .CountSleep}} disabled{{end}} title="{{if .CountSleep}}{{t "rail.sleep"}}{{else}}{{t "rail.sleep.none"}}{{end}}" aria-label="{{if .CountSleep}}{{t "rail.sleep"}}{{else}}{{t "rail.sleep.none"}}{{end}}" aria-haspopup="dialog">{{icon "moon"}}</button>{{end}}<button type="button" class="rref" id="railref" title="{{t "rail.refresh"}}" aria-label="{{t "rail.refresh"}}">{{icon "reload"}}</button></div><div class="rlist" id="rlist" data-max="{{.LabelMax}}" data-lgen="{{.LayoutGen}}"{{if .LayoutEmpty}} data-layout-empty="1"{{end}}>{{range $ws := .Workspaces}}<section class="rws" data-ws="{{.Path}}"><div class="wsbar"><button type="button" class="wstog" aria-expanded="true" title="{{.Path}}">{{if .Repo}}<span class="wsi" title="{{t "rail.repo"}}">{{icon "repo"}}</span>{{else}}<span class="wsi" title="{{t "rail.folder"}}">{{icon "wsfolder"}}</span>{{end}}<span class="nm">{{.Name}}</span><span class="pp">{{.Path}}</span></button>{{if and .Repo $.CanAdd}}<button type="button" class="radd" data-add="wt" title="{{t "rail.wt.add" .Name}}" aria-label="{{t "rail.wt.add" .Name}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}{{if and (not .Repo) $.CanAdd}}<button type="button" class="rgit" title="{{t "rail.gitinit"}}" aria-label="{{t "rail.gitinit"}}" aria-haspopup="dialog" aria-expanded="false">{{icon "gitinit"}}</button>{{end}}{{if .Stored}}<button type="button" class="rforget" title="{{t "rail.ws.forget" .Name}}" aria-label="{{t "rail.ws.forget" .Name}}">{{icon "x"}}</button>{{end}}{{with .Approvals}}<span class="chip perm" title="{{t "rail.approvals"}}">{{icon "lock"}}{{.}}</span>{{end}}<button type="button" class="memo-count" title="Workspace memos" aria-label="Workspace memos">▤ <span>{{.MemoCount}}</span></button><span class="ct" title="{{t "rail.live.title"}}">{{.Live}}</span></div><div class="wsbody">{{if .Repo}}{{with .PendingWorktrees}}<div class="rpend"><div class="pendhd"><span class="pdot"></span>{{t "rail.admission.pending"}} <span class="pn">{{len .}}</span><span class="phint">{{t "rail.admission.pending.hint"}}</span></div>{{range .}}{{template "r-pending-worktree" .}}{{end}}</div>{{end}}{{range .AdmittedWorktrees}}<div class="rwt{{if .Empty}} empty{{end}}" data-g="{{.Path}}"><div class="wthd" tabindex="0" role="link" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else}}{{.Branch}}{{end}}</span>{{if .Root}}<span class="wtroot" role="img" title="{{t "rail.root"}}" aria-label="{{t "rail.root"}}">{{icon "repo"}}</span>{{end}}<span class="wf">· {{if .Root}}{{t "rail.root"}}{{else}}{{.Folder}}{{end}}</span>{{if $.CanSpawn}}{{$b := .Branch}}{{if .Detached}}{{$b = t "rail.detached"}}{{end}}<button type="button" class="rnew" data-root="{{.Path}}" data-name="{{$ws.Name}}" data-branch="{{$b}}" title="{{t "rail.new.title" $b}}" aria-label="{{t "rail.new.title" $b}}" aria-haspopup="dialog" aria-expanded="false">{{icon "plus"}}</button>{{end}}{{if and .Deletable $.CanAdd}}<button type="button" class="rdel" data-ws="{{$ws.Path}}" data-path="{{.Path}}" data-folder="{{.Folder}}" title="{{t "rail.wt.delete" .Folder}}" aria-label="{{t "rail.wt.delete" .Folder}}" aria-haspopup="dialog">{{icon "trash"}}</button>{{end}}{{if .HasChanges}}<span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span>{{end}}</div>{{template "rsessions" .}}</div>{{end}}{{with .RejectedWorktrees}}<details class="rrej"><summary>{{icon "x"}}<span class="fl">{{t "rail.admission.rejected"}} <b class="d-n">{{len .}}</b></span>{{with $.RejectedPrompt}}<button type="button" class="rrej-copy" data-admission-copy-all data-copy="{{.}}" title="{{t "rail.admission.copyall"}}" aria-label="{{t "rail.admission.copyall"}}">{{icon "copy"}}</button>{{end}}</summary>{{range .}}<div class="rwt" data-g="{{.Path}}" data-admission="{{.Admission}}" data-repository="{{.AdmissionRepository}}" data-path="{{.AdmissionPath}}" data-revision="{{.Revision}}"><div class="wthd" tabindex="0" role="link" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else if .Branch}}{{.Branch}}{{else}}{{.Folder}}{{end}}</span><span class="wf">· {{.Folder}}</span><span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span><button type="button" class="admission-undo" title="{{t "rail.admission.undo.title"}}">{{icon "undo"}}{{t "rail.admission.undo"}}</button></div><div class="wtpath" title="{{.Path}}"><span class="d-pt">{{.ShortPath}}</span></div>{{template "rsessions" .}}</div>{{end}}</details>{{end}}{{else}}{{template "rsessions" .}}{{end}}</div></section>{{else}}<div class="rail-empty-guide"><span class="rail-empty-icon">{{icon "wsfolder"}}</span><b class="rail-empty-title">{{t "rail.ws.empty.title"}}</b><p class="rail-empty-sub">{{t "rail.ws.empty.sub"}}</p>{{if $.CanAdd}}<button type="button" class="rail-empty-add" data-add="ws">{{icon "plus"}}{{t "rail.ws.empty.add"}}</button>{{end}}{{with .PendingWorkspaces}}<div class="rail-empty-hint">{{t "rail.ws.empty.hint" (len .)}}</div>{{end}}</div>{{end}}{{if or .CanAdd .PendingWorkspaces .RejectedWorkspaces}}{{template "r-workspace-admission" .}}{{end}}</div><div class="admission-feedback" role="group" aria-label="{{t "rail.admission.notice"}}" hidden><div class="afrow"><span class="admission-status" role="status" aria-live="polite"></span><button type="button" class="afx" data-admission-dismiss title="{{t "rail.admission.dismiss"}}" aria-label="{{t "rail.admission.dismiss"}}">{{icon "x"}}</button></div><div class="admission-corrections"></div><div class="admission-copy" hidden><button type="button" class="afcopy" data-admission-copy>{{icon "copy"}}{{t "rail.admission.retry"}}</button><details><summary>{{t "rail.admission.prompt"}}</summary><textarea readonly rows="6" aria-label="{{t "rail.admission.prompt"}}"></textarea></details></div></div><div class="rcap" hidden role="toolbar" aria-label="{{t "rail.admission.cap"}}"><button type="button" class="clr" data-admission-clear aria-label="{{t "rail.admission.clearall"}}" title="{{t "rail.admission.clearall"}}">{{icon "x"}}</button><span class="seg ok"></span><span class="seg no"></span><button type="button" class="go" data-admission-apply title="{{t "rail.admission.apply.title"}}">{{icon "check"}}{{t "rail.admission.apply"}}</button></div><div class="rfoot"><button type="button" class="btn gear settings-toggle" id="gear" title="{{t "gear.title"}}" aria-label="{{t "drawer.settings"}}" aria-haspopup="dialog" aria-controls="gmenu" aria-expanded="false">{{icon "gear"}}</button><button type="button" class="btn gear rail-home" title="{{t "rail.home"}}" aria-label="{{t "rail.home"}}"><svg class="i li" aria-hidden="true"><use href="#l-house"/></svg></button></div>{{end}}


{{define "r-workspace-admission"}}<details class="rws-unreg" data-key="rail-unregistered-workspaces"><summary class="unreg-sum"><svg class="i unreg-chev" aria-hidden="true"><use href="#l-chevron-right"/></svg><span class="unreg-dot{{if not .PendingWorkspaces}} zero{{end}}"></span><span class="unreg-lbl">{{t "rail.ws.unreg.title"}}</span><span class="unreg-draft-pill" hidden></span><span class="unreg-count">{{len .PendingWorkspaces}}</span></summary><div class="unreg-body"><div class="unreg-toolbar"><span class="unreg-pend-stat">{{t "rail.ws.unreg.pending"}} <span class="pn">{{len .PendingWorkspaces}}</span></span><button type="button" class="unreg-reject-all" id="unreg-reject-all" data-reject-label="{{t "rail.ws.unreg.rejectall"}}" data-clear-label="{{t "rail.ws.unreg.rejectall.clear"}}"{{if not .PendingWorkspaces}} disabled{{end}}>{{t "rail.ws.unreg.rejectall"}}</button></div>{{if gt (len .PendingWorkspaces) 10}}<div class="unreg-filter-wrap"><svg class="i" aria-hidden="true"><use href="#l-search"/></svg><input type="search" class="unreg-filter" id="unreg-filter" placeholder="{{t "rail.ws.unreg.filter" (len .PendingWorkspaces)}}" aria-label="{{t "rail.ws.unreg.filter" (len .PendingWorkspaces)}}"></div>{{end}}<div class="unreg-list" id="unreg-list">{{range .PendingWorkspaces}}<div class="rwt d-pend unreg-row" data-unreg-path="{{.Path}}"><div class="unreg-row-main"><span class="tgs"><button type="button" class="tg ap" data-ws-admission-action="approve" aria-pressed="false" aria-label="{{t "rail.ws.unreg.approve" .Name}}" title="{{t "rail.ws.unreg.approve.title"}}">{{icon "check"}}</button><button type="button" class="tg rj" data-ws-admission-action="reject" aria-pressed="false" aria-label="{{t "rail.ws.unreg.reject" .Name}}" title="{{t "rail.ws.unreg.reject.title"}}">{{icon "x"}}</button></span><div class="unreg-info" title="{{.Path}}"><div class="unreg-name">{{.Name}}</div><div class="unreg-parent">{{.ParentPath}}</div></div><button type="button" class="unreg-scount" data-tog-sess="{{.Path}}" aria-expanded="false" title="{{t "rail.ws.unreg.sessions.title" .SessionCount}}">{{.SessionCount}}</button></div><div class="unreg-sessions" hidden>{{range .AllSessions}}<a class="unreg-slink" href="/s/{{.ReplyID}}"><span class="hb sm" data-h="{{.Harness}}"></span><span class="unreg-stitle">{{or .Label .ReplyID}}</span>{{with .LastTool}}<time class="unreg-stime t" data-ms="{{.}}" data-f="rel">{{.}}</time>{{end}}</a>{{end}}</div></div>{{else}}<div class="unreg-empty-filter">{{t "rail.ws.unreg.empty"}}</div>{{end}}<div class="unreg-empty-filter unreg-filter-empty" hidden>{{t "rail.ws.unreg.filter.empty"}}</div></div>{{with .RejectedWorkspaces}}<details class="rrej" id="unreg-rrej" data-key="rail-unregistered-rejected"><summary>{{icon "x"}}<span class="fl">{{t "rail.ws.unreg.rejected"}} <b class="d-n">({{len .}})</b></span></summary><div class="rrej-list">{{range .}}<div class="rrej-row" data-ws-rej-path="{{.Path}}"><div class="rrej-row-info" title="{{.Path}}"><div class="rrej-row-name">{{.Name}}</div><div class="rrej-row-path">{{.ParentPath}}</div></div><button type="button" class="unreg-undo" data-ws-undo="{{.Path}}" title="{{t "rail.ws.unreg.undo.title"}}">{{icon "undo"}}{{t "rail.ws.unreg.undo"}}</button></div>{{end}}</div></details>{{end}}</div></details>{{end}}
{{define "r-pending-worktree"}}<div class="rwt d-pend" data-g="{{.Path}}" data-origin="{{.Origin}}" data-admission="{{.Admission}}" data-repository="{{.AdmissionRepository}}" data-path="{{.AdmissionPath}}" data-revision="{{.Revision}}"><div class="wthd" tabindex="0" role="link" title="{{.Path}}">{{icon "branch"}}<span class="br">{{if .Detached}}{{t "rail.detached"}}{{else}}{{.Branch}}{{end}}</span><span class="wf">· {{.Folder}}</span>{{if .HasChanges}}<span class="gs" title="{{t "rail.changes"}}">±{{.Changes}}</span>{{end}}<span class="tgs"><button type="button" class="tg ap" data-admission-action="approve" aria-pressed="false" aria-label="{{t "rail.admission.approve"}}" title="{{t "rail.admission.approve.title"}}">{{icon "check"}}</button><button type="button" class="tg rj" data-admission-action="reject" aria-pressed="false" aria-label="{{t "rail.admission.reject"}}" title="{{t "rail.admission.reject.title"}}">{{icon "x"}}</button></span></div><div class="wtpath" title="{{.Path}}"><span class="d-pt">{{.ShortPath}}</span><span class="d-tag"></span></div><div class="admission-row-correction" hidden><span>{{t "rail.admission.stale"}}</span><button type="button" data-admission-clear-row>{{t "rail.admission.clear"}}</button><button type="button" data-admission-reselect>{{t "rail.admission.reselect"}}</button></div>{{template "rsessions" .}}</div>{{end}}

{{define "rsessions"}}{{if or .Sessions .Ended .Archived}}<div class="rsessions">{{range .Sessions}}{{$p := .ReplyID}}{{template "rrow" .}}{{with .Children}}<div class="rkids" data-parent="{{$p}}">{{range .}}{{template "rrow" .}}{{end}}</div>{{end}}{{end}}{{if or .Ended .Archived}}{{template "rfold" .}}{{end}}</div>{{end}}{{end}}

{{/* The fold row under a group's live rows: two halves, archived (left) and
ended (right), acting as one tri-state radio (none, archived, or ended
open; rail.js marks keeps the pick by the group's path). A half with no
rows is disabled. */}}
{{define "rfold"}}<div class="rfold" role="group" aria-label="{{t "rail.fold"}}" data-key="{{.Path}}"><button type="button" class="rfh" data-k="arch" aria-expanded="false" title="{{t "rail.archived" (len .Archived)}}"{{if not .Archived}} disabled{{end}}>{{icon "archive"}}{{t "rail.fold.archived"}} <span class="d-n">{{len .Archived}}</span></button><button type="button" class="rfh" data-k="del" aria-expanded="false" title="{{t "rail.ended" (len .Ended)}}"{{if not .Ended}} disabled{{end}}>{{icon "clock"}}{{t "rail.fold.ended"}} <span class="d-n">{{len .Ended}}</span></button></div>{{with .Archived}}<div class="rended" data-k="arch"><div class="rsessions">{{range .}}{{template "rrow" .}}{{end}}</div></div>{{end}}{{with .Ended}}<div class="rended" data-k="del"><div class="rsessions">{{range .}}{{template "rrow" .}}{{end}}</div></div>{{end}}{{end}}

{{/* The harness icon's tooltip and label: the harness, then its state. */}}
{{define "hitip"}}{{with .Harness}}{{.}}{{else}}?{{end}} · {{if .Approval}}{{t "rail.approval"}}{{else if .Working}}{{t "rail.working"}}{{else if .BackgroundTasks}}{{t "agent.background"}}{{else if .Failure}}{{template "noticeword" .Failure.Kind}}{{else}}{{t "rail.waiting"}}{{end}}{{end}}

{{/* rmsg is a row's message link: the second line's text (a hosted exit,
the awaited tool, or the last message), or, on a parent with no message,
an empty link that keeps the rest of its meta line opening the session. A
child row has none. */}}
{{define "rmsg"}}<a class="drmsg" href="/s/{{.ReplyID}}" tabindex="-1">{{if .Child}}{{else if .Exit}}<span class="s2">{{template "hostexit" .Exit}}</span>{{else if and .Approval .Approval.Tool}}<span class="s2 ap"><b class="who">{{toolName .Approval.Tool}}</b>{{.Approval.Args}}</span>{{else}}{{with .Message}}<span class="s2">{{if $.User}}<b class="who">{{t "rail.you"}}</b>{{end}}{{.}}</span>{{end}}{{end}}</a>{{end}}

{{define "rrow"}}<div class="rs{{if not .Live}} ended{{end}}{{if .Stopped}} stopped{{end}}{{if .Archived}} archived{{end}}{{if and .Hosted (or .Live .Archived)}} hosted-row{{end}}" data-rid="{{.ReplyID}}" data-asks="{{.OpenAskIDs}}"{{if not (or .StarHidden .Archived)}} data-star="{{if .Starred}}1{{else}}0{{end}}"{{end}}{{with .Approval}} data-ap="1" data-ap-tool="{{.Tool}}" data-ap-args="{{.Args}}"{{end}}{{if .HasChildren}} data-kids="1"{{end}}{{if .Child}} data-g="{{.Group}}"{{with .Message}} title="{{.}}"{{end}}{{end}}>{{if .Live}}<span class="drgrip" aria-hidden="true">{{icon "grip"}}</span>{{end}}<div class="drbody"><div class="s1"><a class="rl" href="/s/{{.ReplyID}}"><span class="hiw"><span class="hb{{if .Child}} sm{{end}}{{if .Approval}} perm{{else if .Working}}{{else if .Failure}} err{{end}}" data-h="{{.Harness}}" role="img" aria-label="{{template "hitip" .}}" title="{{template "hitip" .}}">{{if and .Working (not .Approval)}}<span class="hbr"></span>{{end}}{{if .KidWorking}}<span class="hbr kidorb"></span>{{end}}</span>{{with .CountPolicy}}<span class="qdot" role="img" aria-label="{{tn "rail.questions" .}}" title="{{tn "rail.questions" .}}"></span>{{end}}{{if and .Starred (not (or .StarHidden .Archived))}}<span class="hstar" role="img" aria-label="{{t "js.rail.starred"}}" title="{{t "js.rail.starred"}}">{{icon "pin"}}</span>{{end}}{{with .Subagents}}<span class="sbn" title="{{t "srow.agents" .}}">{{.}}</span>{{end}}</span><span class="rid{{if .Label}} lbl{{end}}">{{or .Label .ReplyID}}</span>{{if .Hosted}}<span class="hosted" title="{{t "rail.hosted"}}">{{icon "hosted"}}</span>{{end}}{{with .BranchTag}}<span class="rbt" title="{{$.Group}}">{{icon "branch"}}<span>{{.}}</span></span>{{end}}</a><a class="drtail" href="/s/{{.ReplyID}}" tabindex="-1">{{with .Approval}}<span class="chip perm" title="{{if .Tool}}{{t "rail.approve.title" (toolName .Tool)}}{{else}}{{t "rail.approval"}}{{end}}">{{icon "lock"}}{{t "rail.approve"}}</span>{{end}}{{if and (not .Working) (not .Approval) .BackgroundTasks}}<span class="chip bgt" title="{{t "tree.bg.title"}}">{{t "agent.background"}}</span>{{end}}{{with .KidApprovals}}<span class="chip perm kap" title="{{tn "rail.kids.approval" .}}">?</span>{{end}}<span class="drslot">{{if .DeleteAt}}<time class="when del" data-ms="{{.DeleteAt}}" data-f="del" data-tl="{{t "rail.deleteat"}}">{{clock .DeleteAt}}</time>{{else}}{{with .LastTool}}<time class="when t" data-ms="{{.}}" data-f="rel" data-tl="{{t "rail.lasttool"}}">{{clock .}}</time>{{end}}{{end}}</span></a><span class="dracts"><button type="button" class="drren" data-label="{{.Label}}" title="{{t "head.rename"}}" aria-label="{{t "head.rename"}}">{{icon "pencil"}}</button><button type="button" class="drcopy" data-copy="{{.MailboxRef}}" data-mailbox-open="{{.MailboxOpen}}" title="{{t "rail.copy"}}" aria-label="{{t "rail.copy"}}">{{icon "copy"}}</button>{{if and .Hosted .Live}}<button type="button" class="drarch" data-act="hide" title="{{t "rail.archive"}}" aria-label="{{t "rail.archive"}}">{{icon "archive"}}</button>{{else if .Archived}}<button type="button" class="drarch unarch" data-act="unhide" title="{{t "rail.unarchive"}}" aria-label="{{t "rail.unarchive"}}">{{icon "archive-restore"}}</button>{{end}}</span></div>{{$msg := and (not .Child) (or .Exit (and .Approval .Approval.Tool) .Message)}}{{with .Children}}<div class="drmeta"><button type="button" class="kidtog" aria-expanded="true" title="{{tn "rail.kids" (len .)}}" aria-label="{{tn "rail.kids" (len .)}}">{{icon "chev"}}{{icon "person"}}<span class="kn">{{len .}}</span></button>{{with $.KidBusy}}<sub class="drkwork" title="{{tn "rail.kids.busy" .}}">{{.}}</sub>{{end}}{{template "rmsg" $}}</div>{{else}}{{if $msg}}{{template "rmsg" .}}{{end}}{{end}}</div>{{if .Revive}}<button type="button" class="rrev" data-revive="{{.Revive}}"{{if .ReviveBlocked}} aria-disabled="true" title="{{t "rail.revive.nosession"}}" aria-label="{{t "rail.revive.nosession"}}"{{else if eq .Revive "reopen"}} title="{{t "rail.reopen.title"}}"{{else}} title="{{t "rail.takeover.title"}}"{{end}}>{{if eq .Revive "reopen"}}{{t "rail.reopen"}}{{else}}{{t "rail.takeover"}}{{end}}</button>{{end}}{{template "session-hover" .}}</div>{{end}}

{{/* Hover sources are inert, escaped server markup. The shared rail script
copies only the hovered row's own source outside the SSE-replaced regions.
Only explicit response evidence establishes output identity or last-turn t/s. */}}
{{define "session-hover"}}<template class="shp-source"{{if .Hover.Stale}} data-stale="1"{{end}}><div class="shp-hd"><span class="hb" data-h="{{.Harness}}"></span><b class="shp-nm">{{or .Label .ReplyID}}</b>{{if .Stopped}}<span class="chip">{{if and .Exit (eq .Exit.Reason "idle_timeout")}}{{t "phase.idle"}} · {{end}}{{t "hostexit.stopped"}}</span>{{else if not .Live}}<span class="chip">{{t "head.ended"}}</span>{{else}}{{template "tphase" .Hover.Phase}}{{end}}</div><div class="shp-sub"><span>{{.ReplyID}}</span><span>{{.Harness}}</span>{{with .BranchTag}}<span>{{.}}</span>{{end}}</div>{{template "observed-model" .Hover.Observed}}{{with .Hover}}{{if .Band.Context}}{{template "r-ctx" .}}{{else}}<div class="shp-unk">{{t "hover.context.unknown"}}</div>{{end}}{{end}}<div class="shp-stats"><div class="shp-stat">{{if .Hover.Rate}}<b class="tps">{{.Hover.Rate}}</b>{{else}}<b class="na">—</b>{{end}}<span>{{if .Working}}{{t "hover.rate"}}{{else}}{{t "hover.lastrate"}}{{end}}</span></div><div class="shp-stat"><b>{{if .Hover.TurnStartedAt}}{{template "dur" .Hover.TurnStartedAt}}{{else if .Hover.LastTurnMs}}{{template "span" .Hover.LastTurnMs}}{{else}}—{{end}}</b><span>{{if .Hover.TurnStartedAt}}{{t "hover.turn"}}{{else}}{{t "hover.lastturn"}}{{end}}</span></div><div class="shp-stat"><b>{{if and .Live (not .Hover.Stale)}}{{.Subagents}}{{else}}—{{end}}</b><span>{{t "hover.children"}}</span></div></div><div class="shp-foot">{{with .LastTool}}<span>{{t "rail.lasttool"}} {{template "ago" .}}</span>{{end}}{{with .Hover.Band.Cost}}<span>{{t "hover.cost"}} <b>{{.}}</b></span>{{end}}{{with .Hover.RegisteredAt}}<span>{{t "hover.registered"}} {{template "ago" .}}</span>{{end}}{{with .Hover.SnapshotAt}}<span>{{t "hover.snapshot"}} {{template "ago" .}}</span>{{end}}</div>{{if .Exit}}<div class="shp-note exit">{{template "hostexit" .Exit}}</div>{{end}}</template>{{end}}

{{define "agent-model-hover"}}<template class="shp-source"{{if not .IsRunning}} data-stale="1"{{end}}><div class="shp-hd"><b class="shp-nm">{{or .Label .ID}}</b>{{if .IsRunning}}{{template "tphase" .Phase}}{{else}}<span class="chip">{{template "aended" .EndedStatus}}</span>{{end}}</div><div class="shp-sub"><span>{{or .ReplyID .ID}}</span></div>{{template "observed-model" .Observed}}{{with .Model}}<div class="shp-last">{{t "hover.reported"}} · {{.}}{{if not $.Observed}} · {{t "hover.unverified"}}{{end}}</div>{{end}}{{with .Effort}}<div class="shp-last">{{t "hover.effort" .}}</div>{{end}}{{with .ContextText}}<div class="shp-last">{{t "agent.context" $.ContextTokens}} · {{.}}</div>{{end}}</template>{{end}}

{{/* Evidence time and source survive idle/stopped states. The popup shows only
its latest transition; the expanded session/agent detail owns full history. */}}
{{define "observed-model"}}<div class="shp-model"><div class="shp-mtx"><span class="shp-last">{{t "hover.observed"}}</span>{{if .}}<span class="shp-mid">{{.Current.Model}}</span><span class="shp-last">{{t "hover.lastobserved"}} · {{template "clock" .Current.At}} · {{.Current.Source}}</span>{{with .Current.Effort}}<span class="shp-last">{{t "hover.effort" .}} · {{$.Current.EffortSource}}</span>{{end}}{{with .Change}}<span class="shp-last">{{.Previous}} → {{.Model}} · {{template "clock" .At}}</span>{{end}}{{else}}<span class="shp-unk">{{t "hover.unknown"}}</span>{{end}}</div>{{if .}}{{with .Current.Effort}}<span class="shp-eff">{{.}}</span>{{end}}{{end}}</div>{{end}}

{{define "observed-history"}}{{if .}}{{range .History}}<li class="brow"><span class="bp">{{with .Previous}}{{.}} → {{end}}{{.Model}} · {{.Source}}</span><span class="bm">{{template "clock" .At}}</span></li>{{end}}{{end}}{{end}}

{{/* The file view's pages (file_route.go): a rendered markdown file, and the
"not viewable" page that offers the path copies only. Neither is a region;
both inline the board's stylesheet for its colours and markdown rules. */}}
{{define "filecss"}}.fileview .fwrap { max-width: 920px; margin: 0 auto; padding: 18px 20px 48px; }
.fileview .fhead { margin-bottom: 12px; }
.fileview code.fpath { font-size: 12.5px; color: var(--wb-muted-fg); overflow-wrap: anywhere; }
.fileview .fbody { background: var(--wb-card); border-radius: 10px; padding: 14px 18px; overflow-wrap: anywhere; }
.fileview .fbody h1, .fileview .fbody h2, .fileview .fbody h3, .fileview .fbody h4 { font-weight: 700; margin: 14px 0 6px; }
.fileview .fbody h1 { font-size: 1.5em; } .fileview .fbody h2 { font-size: 1.3em; } .fileview .fbody h3 { font-size: 1.15em; }
.fileview .fbody > :first-child { margin-top: 0; }
.fileview .fbody hr { border: 0; border-top: 1px solid var(--wb-muted); margin: 12px 0; }
.fileview .fnone { margin: 0 0 12px; }
.fileview .fcopy { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.fileview .fcopy button { font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 8px; border: 0; background: var(--wb-muted); color: var(--wb-fg); cursor: pointer; }
.fileview .fnote { font-size: 12.5px; color: var(--wb-muted-fg); }{{end}}

{{define "file-md"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div><article class="md fbody">{{.HTML}}</article></div></body></html>
{{end}}

{{define "file-none"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Rel}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Rel}}</code></div>
<p class="fnone">{{t "file.none" .Reason}}</p>
<div class="fcopy"><button type="button" data-copy="{{.Rel}}">{{t "file.copyrel"}}</button><button type="button" data-copy="{{.Abs}}">{{t "file.copyabs"}}</button><span class="fnote" id="fnote" role="status" data-ok="{{t "file.copied"}}" data-fail="{{t "file.copyfail"}}"></span></div></div>
<script nonce="{{.Nonce}}">(function () {
  // A LAN page over plain http is not a secure context, where
  // navigator.clipboard is missing: copy through a selected textarea there.
  var doc = document, note = doc.getElementById("fnote");
  function done(ok) { note.textContent = note.getAttribute(ok ? "data-ok" : "data-fail"); }
  function fallback(text) {
    var t = doc.createElement("textarea");
    t.value = text;
    t.setAttribute("readonly", "");
    t.style.position = "fixed";
    t.style.opacity = "0";
    doc.body.appendChild(t);
    t.select();
    var ok = false;
    try { ok = doc.execCommand("copy"); } catch (e) { ok = false; }
    doc.body.removeChild(t);
    done(ok);
  }
  doc.addEventListener("click", function (e) {
    var b = e.target && e.target.closest && e.target.closest("[data-copy]");
    if (!b) return;
    var text = b.getAttribute("data-copy");
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { fallback(text); });
    else fallback(text);
  });
})();</script></body></html>
{{end}}

{{/* The re-mint page (fs_outside.go): what a tab on an outside HTML file
shows when its capability no longer verifies. Its script posts the mint for
the path the URL named and replaces the page with the fresh URL, at most
once in a few seconds per tab; a refused mint shows the note. */}}
{{define "file-remint"}}<!DOCTYPE html>
<html{{with .Theme}} data-theme="{{.}}"{{end}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Abs}}</title>
<style>{{.WhiteboardCSS}}</style>
<style>{{template "filecss"}}</style></head>
<body class="fileview" data-mint="{{.Mint}}" data-base="{{.Base}}" data-abs="{{.Abs}}" data-rel="{{.Rel}}"><div class="fwrap"><div class="fhead"><code class="fpath">{{.Abs}}</code></div>
<p class="fnone" id="fgone" hidden>{{t "file.outside.gone"}}</p></div>
<script nonce="{{.Nonce}}">(function () {
  var b = document.body, key = "ws.outside.remint", now = Date.now();
  function gone() { document.getElementById("fgone").hidden = false; }
  try {
    if (now - (+sessionStorage.getItem(key) || 0) < 5000) { gone(); return; }
    sessionStorage.setItem(key, String(now));
  } catch (e) {}
  if (!window.fetch) { gone(); return; }
  fetch(b.getAttribute("data-mint"), {
    method: "POST", credentials: "same-origin", cache: "no-store",
    headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: b.getAttribute("data-abs") })
  }).then(function (r) {
    if (!r.ok) throw r.status;
    return r.json();
  }).then(function (v) {
    var view = v && typeof v.view === "string" ? v.view : "";
    if (view.indexOf(b.getAttribute("data-base")) !== 0) { gone(); return; }
    location.replace(view.slice(0, view.lastIndexOf("/") + 1) + b.getAttribute("data-rel"));
  }).catch(gone);
})();</script></body></html>
{{end}}
