{{define "page"}}<!DOCTYPE html>
<html{{if .Full}} data-wb-reply="{{.ReplyID}}" data-stamp="{{.StampFile}}" data-seq="{{.Seq}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{t "wb.title"}} - {{.ReplyID}}</title>
<style>{{.CSS}}</style></head>
<body class="{{if .Full}}full{{else}}embed{{end}}">{{.Sprite}}<div class="wrap">
{{if .Full}}<div class="banner" id="wb-banner" title="{{t "wb.banner"}}">{{icon "reload"}}</div>
{{end}}<div class="top"><h1>{{t "wb.title"}}</h1><span class="meta">{{.ReplyID}} · #{{.Seq}}</span><span class="counts">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}{{if .Embed}}{{with .CountFresh}}<span class="chip fresh" title="{{t "chip.fresh"}}"><span class="new"></span>{{.}}</span>{{end}}{{end}}</span></div>
{{if .Full}}<div class="grid solo"><main>{{template "board" .}}</main>{{if .Panels}}<aside class="side flat">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</aside>{{end}}</div>
{{else}}{{template "board" .}}<p class="full-board-link"><a href="{{href .FullBoardLink}}">{{t "wb.stream.full"}}</a></p>{{if .Panels}}<div class="side flat">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</div>{{end}}
{{end}}</div>
<script>{{i18n}}</script>
<script>{{.Script}}</script>
{{if .Mermaid}}<script src="{{.MermaidFile}}"></script>
<script>{{.MermaidInit}}</script>
{{end}}</body></html>
{{end}}

{{define "board"}}{{range .Topics}}{{$.TopicHTML .}}{{end}}{{template "closedmore" .}}{{range .DeferredTopics}}<template data-history-topic="{{.Name}}">{{$.TopicHTML .}}</template>{{end}}{{template "reply" .}}{{end}}

{{define "closedpage"}}<div class="closed-page">{{range .Topics}}{{$.TopicHTML .}}{{end}}{{template "closedmore" .}}</div>{{end}}

{{define "closedmore"}}{{with .ClosedMore}}{{if $.DocFramed}}<button class="btn closed-more" data-closed-next="{{$.ClosedNext}}" data-closed-more="{{.}}">{{t "wb.closed.showmore" .}}</button>{{else}}<div class="closed-more">{{t "wb.closed.more" .}}</div>{{end}}{{end}}{{end}}

{{define "tago"}}{{with .UpdatedAt}}<time class="tago" datetime="{{.}}" title="{{t "wb.updated"}}"{{if $.Page.Full}} data-at="{{$.UpdatedMs}}"{{end}}>{{$.UpdatedClock}}</time>{{end}}{{end}}

{{/* recap is the topic's current-state line: the newest agent log or panel
recap (a legacy recap until converted). Its L/P marker and time precede inline
text. An open topic's summary rides in its head; a legacy recap shows as a
card under the head. Once closed either folds inside the body's fold. On the
full page the clock chip is a button: stream.js jumps to its exact log/panel
version row (data-entry). Only the chip takes the role: text may hold links. */}}
{{define "recap"}}<div class="trecap"{{with .Head}} data-entry="{{.ID}}" data-kind="{{.Kind}}"{{end}}>{{with .RecapAt}}<span class="rat"{{if and $.Head $.Page.Full}} role="button" tabindex="0"{{end}} title="{{$.RecapStamp}}">{{if $.Head}}{{if eq $.Head.Kind "panel"}}<span class="evi wb-evi-panel" title="{{t "wb.stream.panels"}}">P</span>{{else}}<span class="evi lead" title="{{t "wb.stream.agent"}}">L</span>{{end}}{{if $.Page.Full}}{{$.RecapClock}} · {{end}}{{else}}{{t "wb.recap"}} {{end}}<time class="tago" datetime="{{.}}"{{if $.Page.Full}} data-at="{{$.RecapMs}}"{{end}}>{{$.RecapClock}}</time></span> — {{end}}<div class="rtext md" title="{{.Summary}}">{{.Page.RecapHTML .TopicView}}</div></div>{{end}}

{{/* The dashboard's whole-card fold owns the topic body. Standalone pages
retain their content disclosure; inner history/panel disclosures are separate. */}}
{{define "doc"}}{{if .HasFold}}{{if .Page.DocFramed}}<div class="tdoc"{{if and .Page.Full .Doc}} data-body-at="{{.BodyUpdatedAt}}"{{end}}>{{else}}<details class="tdoc" data-key="doc:{{.Name}}"{{if and .Page.Full .Doc}} data-body-at="{{.BodyUpdatedAt}}"{{end}}{{if .DocOpen .Page.Embed}} open{{end}}><summary title="{{t "wb.doc"}}">{{icon "book"}}{{if and .Page.Embed .DocNew}}<span class="new" title="{{t "chip.fresh"}}"></span>{{end}}</summary>{{end}}{{if .RecapFolded}}{{template "recap" .}}{{end}}{{if .Doc}}<div class="doc-body {{.DocClass}}">{{.Page.DocHTML .Name}}</div>{{end}}{{if .Page.DocFramed}}</div>{{else}}</details>{{end}}{{end}}{{end}}

{{define "topicstate"}}{{if and .State (not .Closed) (not .StateDiagnostic)}}{{with .Page.StateBadge .State}}{{if .Class}}<span class="topic-state dw"><span class="wb-state-pill {{.Class}}{{if .Over}} wb-state-over{{end}}{{if not (or .ETA .Estimate)}} solo{{end}}" tabindex="0" role="img" aria-label="{{.Description}}">{{icon .Icon}}{{if .ETA}}<span class="wb-state-time"><b>{{.Elapsed}}</b><small>{{t "js.wb.state.eta.max" .ETA}}</small></span>{{else if .Estimate}}<span class="wb-state-time est"><small>{{t "js.wb.state.estimate.short" .Estimate}}</small></span>{{end}}</span><span class="pop sb-tip {{.Class}}{{if .Over}} wb-state-over{{end}}" role="tooltip" popover="manual" hidden><span class="h">{{icon .Icon}}{{.Label}}</span>{{with .Owner}}<span class="who">{{.}}</span>{{end}}{{if .ETA}}<span class="tl">{{t "js.wb.state.eta.tip" .ETA .Elapsed}}{{if .Over}} · <span class="ov">{{t "js.wb.state.over" .OverMinutes}}</span>{{end}}</span>{{if .Extensions}}<span class="ext">{{t "js.wb.state.extended" .Extensions .Initial}}</span>{{end}}<span class="bar"><i style="width:{{.Percent}}%"></i></span>{{end}}{{if .Estimate}}<span class="tl">{{t "js.wb.state.estimate" .Estimate}}</span>{{end}}</span></span>{{end}}{{end}}{{end}}{{end}}

{{define "topicdeps"}}{{if or .Dependencies .Waiters}}{{$summary := waitingSummary .Dependencies .WaitingReady (len .Waiters)}}<span class="dw"><button type="button" class="dbtn{{if .Dependencies}}{{if .WaitingReady}} green{{else}} amber{{end}}{{end}}" aria-expanded="false" aria-haspopup="dialog" aria-label="{{$summary}}" title="{{$summary}}">{{if .WaitingReady}}{{icon "check"}}{{else}}{{icon "clock"}}{{end}}{{with .Waiters}}<span class="bd r">{{len .}}</span>{{end}}</button><span class="pop" role="dialog" aria-label="{{$summary}}" popover="manual" hidden><span class="pop-content">{{if .Dependencies}}<span class="sum {{if .WaitingReady}}green{{else}}amber{{end}}">{{if .WaitingReady}}{{icon "check"}}{{else}}{{icon "clock"}}{{end}}<span>{{$summary}}</span></span><span class="bar{{if .WaitingReady}} green{{end}}"><i style="width:{{waitingPercent .Dependencies}}%"></i></span>{{end}}{{range .Dependencies}}<span class="row{{if .Resolved}} res{{end}}" data-target="{{.Token}}"{{with .Status}} data-status="{{.}}"{{end}}{{if .Derived}} title="{{t "wb.waiting.derived"}}"{{end}}><span class="wb-dot {{if or (eq .Status "unknown") (eq .Status "dropped")}}x{{else if .Resolved}}r{{else if manualRelease .}}x{{else}}u{{end}}" aria-hidden="true"></span>{{if .Anchor}}<a class="nm" href="#{{.Anchor}}">{{.Label}}</a>{{else}}<span class="nm">{{if eq .Token "owner"}}{{t "wb.waiting.owner"}}{{else}}{{.Label}}{{end}}</span>{{end}}<span class="st">{{if eq .Status "unknown"}}{{t "wb.waiting.unknown"}}{{else if eq .Status "dropped"}}{{t "wb.waiting.dropped"}}{{else if .Resolved}}{{t "wb.waiting.resolved"}}{{else if manualRelease .}}{{t "wb.waiting.release"}}{{else}}{{t "wb.waiting.open"}}{{end}}</span></span>{{end}}{{with .Waiters}}<span class="sep"></span><span class="lb">{{t "wb.waiting.reverse" (len .)}}</span>{{range .}}{{if .Anchor}}<a class="row link" href="#{{.Anchor}}"><span>{{.Label}}</span><span class="ar">{{icon "ext"}}</span></a>{{else}}<span class="row link"><span>{{.Label}}</span></span>{{end}}{{end}}{{end}}</span></span></span>{{end}}{{end}}

{{/* topictickets: the topic's linked tickets as one ticket icon right after
the waiting clock, reusing its popover (deps.js binds every .dw). The count
shows from two tickets; the popover lists each stem with its status, open
grouping idea/todo/ready. Linked tickets add no glow to the topic. */}}
{{define "topictickets"}}{{with .Tickets}}{{$label := (t "wb.tickets" (len .))}}<span class="dw wbtk"><button type="button" class="dbtn" aria-expanded="false" aria-haspopup="dialog" aria-label="{{$label}}" title="{{$label}}">{{icon "ticket"}}{{if gt (len .) 1}}<span class="bd">{{len .}}</span>{{end}}</button><span class="pop" role="dialog" aria-label="{{$label}}" popover="manual" hidden><span class="pop-content"><span class="lb">{{$label}}</span>{{range .}}<span class="row {{if .Open}}open{{else}}{{.Status}}{{end}}" data-ticket="{{.Stem}}" data-status="{{.Status}}">{{if eq .Status "done"}}{{icon "check"}}{{else if eq .Status "dropped"}}{{icon "x"}}{{else}}<span class="wb-dot" aria-hidden="true"></span>{{end}}<span class="nm" title="{{.Stem}}">{{.Stem}}</span><span class="st">{{if .Open}}{{t "wb.tickets.open"}} · {{.Status}}{{else if eq .Status "done"}}{{t "wb.tickets.done"}}{{else if eq .Status "dropped"}}{{t "wb.waiting.dropped"}}{{else}}{{t "wb.waiting.unknown"}}{{end}}</span></span>{{end}}</span></span></span>{{end}}{{end}}

{{/* topic: the head (.tophead) is the bar, the note, and an open topic's
summary line (the latest log or panel recap, plus the embed's check pill); it
sticks as one unit under the rail (page.css, rail.js), and everything after it
scrolls under it. On the full page the open asks stack after the history
(openasks); the embed keeps its check rows in flow below the head. */}}
{{define "topic"}}<section class="topic{{if .Quiet}} quiet{{end}}{{if .Closed}} closed{{end}}{{if and .HasFold (not .Page.DocFramed)}} has-doc{{end}}" id="{{.Anchor}}" data-topic="{{.Name}}"{{if .Closed}} title="{{t "wb.closed"}}"{{end}}{{if .WaitingReady}} data-waiting-ready="true"{{end}}{{with .State}} data-state="{{.Value}}"{{if eq .Value "researching"}}{{with .Owner}} data-state-owner="{{.}}"{{end}}{{with .ETAMinutes}} data-state-eta-minutes="{{.}}"{{end}}{{end}}{{with .Run}} data-state-owner="{{.Owner}}" data-state-eta-minutes="{{.ETAMinutes}}" data-state-initial-eta-minutes="{{.InitialETAMinutes}}" data-state-extensions="{{.ExtensionCount}}" data-state-started-at="{{.StartedAt}}" data-state-deadline-at="{{.DeadlineAt}}" data-state-run="{{.ID}}"{{end}}{{end}}{{with .StateDiagnostic}} data-state-diagnostic="{{.Code}}"{{end}}><div class="tophead"><div class="tbar">{{template "topicstate" .}}<span class="tlead"><span class="tname" title="{{.Label}}">{{.Label}}</span>{{if and .Closed .Result}}<span class="tresult" title="{{t "wb.result"}}">{{.Page.Inline .Result}}</span>{{end}}{{template "topicdeps" .}}{{template "topictickets" .}}</span>{{template "tago" .}}{{if .Page.Embed}}{{with .Fresh}}<span class="chip fresh" title="{{t "chip.fresh"}}"><span class="new"></span>{{.}}</span>{{end}}{{end}}{{with .AskCount}}{{if and $.Page.BulkChips $.Policy}}<button type="button" class="chip policy bulk" data-bulk="policy" title="{{t "chip.bulk.policy"}}">{{icon "ask"}}{{.}}</button>{{else}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{end}}{{with len .Acks}}{{if $.Page.BulkChips}}<button type="button" class="chip ok bulk" data-bulk="ack" title="{{t "chip.bulk.ack"}}">{{icon "check"}}{{.}}</button>{{else}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}{{end}}{{if and .Quiet .Page.Embed}}{{template "settled" .}}{{end}}<button class="btn mini tnote-toggle" title="{{t "wb.topic.note"}}">{{icon "pen"}}</button></div><textarea class="note tnote" data-topic="{{.Name}}" rows="1" placeholder="✎" title="{{t "wb.topic.note"}}" hidden></textarea>{{if .HeadSummary}}<div class="tsub">{{with .Head}}{{template "recap" $}}{{end}}{{if and .Checks .Page.Embed}}{{template "ckpill" .}}{{end}}</div>{{end}}</div>{{if .LegacyRecapOpen}}{{template "recap" .}}{{end}}{{if and .ChecksShown .Page.Embed}}{{template "checks" .}}{{end}}{{template "doc" .}}{{template "stream" .}}{{if not .Page.Embed}}{{template "openasks" .}}{{end}}{{if and (not .Quiet) .Page.Embed}}{{if or .Policy .Acks .SettledCount}}<div class="tbody">{{range .Policy}}{{template "policy" ($.Page.ItemOf .)}}{{end}}{{if .Acks}}<div class="acks">{{range .Acks}}{{template "ack" ($.Page.ItemOf .)}}{{end}}</div>{{end}}{{if .Page.Embed}}{{template "settled" .}}{{end}}</div>{{end}}{{end}}</section>
{{end}}

{{/* The topic stream: one chronological column under the body, always
shown. Its quiet header row holds the counts and, while older entries
remain, the centered load-older capsule; then panel cards and one-line log
rows. The log
between two panels is one run, every line shown, and adjacent system events
fold behind one chip inside it (EntryPage.Segments). Every panel version keeps
its own write position; earlier ones render folded, linking to the newest
version, and the latest links back to its prior version. Inert pages keep
payloads out of the live DOM until the user explicitly loads them; the embed
carries only the latest panel recaps. */}}
{{define "stream"}}{{if .Page.Embed}}{{if .PanelRecaps}}<div class="tstream embed"><div class="mhead">{{icon "list"}}{{t "wb.stream.panels"}} <span class="n">{{len .PanelRecaps}}</span></div><ul class="panel-recaps">{{range .PanelRecaps}}<li data-entry="{{.ID}}" data-kind="panel" data-panel="{{.PanelID}}"><span class="entry-recap" title="{{.Recap}}">{{$.Page.Inline .Recap}}</span>{{with .Clock}}<span class="entry-at">{{.}}</span>{{end}}<a class="mref" href="{{href (printf "%s#%s" $.Page.FullBoardLink .PanelID)}}">#{{.PanelID}}</a></li>{{end}}</ul></div>{{end}}{{else}}{{if .Timeline}}<div class="topic-stream"><div class="wb-history" data-history="{{.Name}}" aria-label="{{t "wb.stream"}}"><div class="mhead"><span class="wb-mtitle">{{icon "list"}}<span class="wb-mlabel">{{t "wb.stream"}}</span><span class="n">{{.StreamTotal}}</span></span><span></span><span class="mmeta">{{if gt .PanelVersions (len .PanelRecaps)}}{{t "wb.stream.meta.versions" (len .PanelRecaps) .PanelVersions .StreamLines}}{{else}}{{t "wb.stream.meta" (len .PanelRecaps) .StreamLines}}{{end}}</span></div><div class="history-live">{{range .Timeline}}{{if .Gap}}<div class="history-gap" data-count="{{.Count}}" data-from="{{.From}}" data-to="{{.To}}"><span class="gap-label">{{t "js.wb.timeline.gap" .Count}}</span><span class="gap-range">{{.From}}{{if ne .From .To}}–{{.To}}{{end}}</span><span class="gap-actions"><button type="button" data-load="up" title="{{t "wb.stream.older"}}">{{t "wb.timeline.up"}}</button><button type="button" data-load="down"{{if not .Above}} hidden{{end}}>{{t "wb.timeline.down"}}</button></span><template data-history-gap>{{range .Rows}}{{template "timelinerow" ($.Page.TimelineOf .)}}{{end}}</template></div>{{else}}{{range .Rows}}{{template "timelinerow" ($.Page.TimelineOf .)}}{{end}}{{end}}{{end}}</div></div></div>{{end}}{{end}}{{end}}

{{define "timelinerow"}}<div class="timeline-row" data-row="{{.Key}}" data-count="{{.Count}}" data-from="{{.From}}" data-to="{{.To}}">{{range .Inputs}}<div class="owner-input"><span class="evi owner">O</span>{{template "clock" (clockOf "" .SentAt .Stamp .Clock "")}}<span class="input-body">{{with .Excerpt}}<span class="input-excerpt">{{.}}</span>{{end}}{{range .Chips}}<a class="chip" href="#item-{{.ID}}">({{.ID}})</a>{{with .Answer}}<span class="in-ans">→ {{.}}</span>{{end}}{{end}}</span></div>{{end}}{{if .Ask}}{{if .Created}}{{range .CreatedRows}}{{template "timelineask" .}}{{end}}{{else}}{{template "timelineask" .}}{{end}}{{else if .Answer}}{{if .Event.Item}}{{template "entrypage" .EntryPage}}{{else}}<article class="wb-entry system owner" id="{{.Key}}" data-entry="{{.Key}}" data-kind="system" data-entry-item="{{.Event.ItemID}}"><details class="timeline-answer" data-key="answer:{{.Key}}"><summary><span class="evi owner">O</span>{{template "clock" (clockOf .At .Event.Ms .Event.Stamp .Clock "")}}<span><a href="#item-{{.Event.ItemID}}">({{.Event.ItemID}})</a> {{.Page.Inline .Event.Text}}</span></summary><div class="sbody"><b>{{.Page.Inline .Item.Title}}</b>{{template "ctx" .ItemData}}{{template "opts" .ItemData.AsStatic}}</div></details></article>{{end}}{{else}}{{template "entrypage" .EntryPage}}{{end}}</div>{{end}}

{{define "timelineask"}}<article class="wb-entry system timeline-ask"{{if and .Event.ID .Key}} id="{{.Key}}"{{end}} data-entry="{{if and .Event.ID .Key}}{{.Event.ID}}{{else}}ask:{{.Item.ID}}{{end}}" data-entry-item="{{.Item.ID}}" data-history-item="{{.Item.ID}}" data-kind="system">{{template "timelinequestion" .}}</article>{{end}}

{{/* An open ask's history row is only its ask-time line (historyitem, no
controls, no item-N anchor); its card stacks at the topic's bottom. */}}
{{define "timelinequestion"}}{{if or (eq .Item.Class "check") (eq .Item.Status "open")}}{{template "historyitem" .ItemData}}{{else if and (eq .Item.Status "answered") (or .Event.ID .AnswerTarget)}}<div class="srow wb-hitem original-question {{.Item.Class}}" id="item-{{.Item.ID}}"><details class="sx" data-key="question:{{.Item.ID}}"><summary><span class="stext wb-htext">{{template "askclock" .ItemData}}<span class="wb-hmark" title="{{.ItemData.HistoryClassLabel}}">{{.ItemData.HistoryMark}}</span><span class="wb-hmain"><span class="id">{{.Item.Label}}</span><span class="wb-hclass">{{t "wb.timeline.original"}}</span>{{with .ItemData.AskReasked}}<span class="wb-hreask">{{t "wb.timeline.reasked"}} {{.}}</span>{{end}}<a href="#{{if .AnswerTarget}}{{.AnswerTarget}}{{else}}item-{{.Item.ID}}{{end}}">{{.Page.Inline .Item.Title}}</a></span></span></summary><div class="sbody">{{template "ctx" .ItemData}}{{template "opts" .ItemData.AsStatic}}{{if not .AnswerTarget}}{{template "stext" .ItemData}}{{end}}</div></details></div>{{else}}{{template "historyitem" .ItemData}}{{end}}{{end}}

{{/* openasks: the full page's open asks after the history, in creation
order, each card owning its item-N anchor. A run of checks or acks shares its
list frame. A card whose ask has a history event links to that ask-time line
(askjump); the shared fragment navigation expands only the folded history
around it. */}}
{{define "openasks"}}{{with .Asks}}<div class="tbody wb-asks">{{range .}}{{if eq .Kind "policy"}}{{range .Asks}}{{template "policy" ($.Page.AskOf .)}}{{end}}{{else if eq .Kind "check"}}<div class="checks">{{range .Asks}}{{template "check" ($.Page.AskOf .)}}{{end}}</div>{{else}}<div class="acks">{{range .Asks}}{{template "ack" ($.Page.AskOf .)}}{{end}}</div>{{end}}{{end}}</div>{{end}}{{end}}

{{define "askjump"}}{{if .AskEntry}}<a class="wb-askjump" href="#{{.AskEntry}}" title="{{t "wb.timeline.askjump"}}" aria-label="{{t "wb.timeline.askjump"}}">{{icon "history"}}{{with .AskClock}}{{template "clock" (clockOf $.AskAt $.AskMs $.AskStamp . "")}}{{end}}{{with .AskReasked}}<span class="wb-askre">{{t "wb.timeline.reasked"}} {{.}}</span>{{end}}</a>{{end}}{{end}}

{{define "entrypage"}}{{range .Entries.Segments}}{{if .IsPanel}}{{template "entry" ($.Page.EntryOf .Panel)}}{{else}}{{range .Rows}}{{template "logrow" ($.Page.RowOf .)}}{{end}}{{end}}{{end}}{{end}}

{{define "logrow"}}{{if .Systems}}<details class="system-run" data-key="system:{{(index .Systems 0).ID}}" data-history-anchor="{{(index .Systems 0).ID}}"><summary><span class="rl"></span><span class="lbl">{{t "js.wb.stream.system" (len .Systems) .Range}}</span></summary>{{range .Systems}}{{template "entry" ($.Page.EntryOf .)}}{{end}}</details>{{else}}{{template "entry" (.Page.EntryOf .Entry)}}{{end}}{{end}}

{{/* A panel card with a body carries its maximize and back buttons only on
the dashboard's board (DocFramed), where cards.js draws the panel large in
place; the static page has nothing to drive them. */}}
{{define "entry"}}<article class="wb-entry {{.Kind}}{{if .Historical}} historical{{end}}{{if .Current}} current{{end}}{{if .OwnerAnswer}} owner{{end}}" id="{{.ID}}" data-history-anchor="{{.ID}}" data-entry="{{.ID}}" data-kind="{{.Kind}}"{{with .PanelID}} data-panel="{{.}}"{{end}}{{with .ItemID}} data-entry-item="{{.}}"{{end}}{{with .Item}} data-history-item="{{.ID}}"{{end}}>{{if .Item}}{{template "historyitem" .HistoryItem}}{{else if .IsPanel}}<details class="entry-panel{{if not .HasBody}} msg{{end}}" data-key="entry:{{.ID}}{{if .Historical}}:history{{end}}"{{if not .Historical}} id="{{.PanelID}}"{{end}}{{if .Open}} open{{end}}><summary><span class="entry-recap" title="{{.Recap}}">{{.Page.Inline .Recap}}</span><span class="pmeta">{{if not .Historical}}<span class="wb-panel-updated" hidden>{{t "wb.panel.updated"}}</span>{{end}}{{if .Diff}}<button type="button" class="pdg-chip" aria-pressed="false" title="{{t "wb.panel.diff.title" .Prior.Label}}"><span>{{t "wb.panel.diff.against" .Prior.Version}}</span><span class="n a">+{{.Diff.Added}}</span><span class="n m">~{{.Diff.Modified}}</span><span class="n wb-pdg-del">−{{.Diff.Removed}}</span></button>{{end}}{{with .BoundName}}<span class="pfname" title="{{t "wb.panel.name"}}">{{.}}</span>{{end}}{{if gt .Of 1}}<span class="pfver{{if .Historical}} old{{end}}" title="{{t "wb.panel.version" .Version .Of}}{{if not .Historical}} · {{t "wb.panel.latest"}}{{end}}">v{{.Version}}</span>{{end}}{{template "entrytime" .}}{{if .Historical}}<a class="pfnewer" href="#{{.Newest.ID}}" title="{{t "wb.panel.newer"}}">→ {{.Newest.Label}}</a><a class="mref pfexact" href="#{{.ID}}" title="{{t "wb.panel.exact"}}">#{{.ID}}</a>{{else}}<a class="mref" href="#{{.PanelID}}" title="{{t "wb.panel.latestlink"}}">#{{.PanelID}}</a>{{end}}<button type="button" class="ibtn pflink" title="{{t "js.wb.link.copy"}}" aria-label="{{t "js.wb.link.copy"}}" aria-haspopup="menu" aria-expanded="false" data-ver="{{.VersionLabel}}" data-newest="{{if .Historical}}{{.Newest.Label}}{{else}}v{{.Version}}{{end}}">{{icon "link"}}</button></span>{{if and .HasBody .Page.DocFramed}}<button type="button" class="ibtn d-max" title="{{t "js.card.max"}}" aria-label="{{t "js.card.max"}}"><svg class="li" aria-hidden="true"><use href="#l-maximize-2"/></svg></button><button type="button" class="ibtn d-min" title="{{t "js.card.back"}}" aria-label="{{t "js.card.back"}}"><svg class="li" aria-hidden="true"><use href="#l-minimize-2"/></svg></button>{{end}}</summary>{{if and .Historical .Text}}<div class="pfoldnote">{{icon "history"}}{{t "wb.panel.oldnote" .VersionLabel}} <a href="#{{.Newest.ID}}">{{t "wb.panel.oldnote.latest" .Newest.Label}}</a></div>{{end}}{{if .Diff}}<div class="pfoldnote pdg-note">{{icon "history"}}{{t "wb.panel.diff.note" .Prior.Label}} <button type="button" class="pdg-off">{{t "wb.panel.diff.off"}}</button></div>{{end}}{{if .HasBody}}<div class="doc-body entry-body {{.PayloadClass}}">{{.Page.EntryHTML .ID}}</div>{{end}}{{if and (not .Historical) .Prior.ID}}<div class="pfprev"><a href="#{{.Prior.ID}}">{{t "wb.panel.prev" .Prior.Label}}</a></div>{{end}}</details>{{else}}<div class="entry-line">{{if eq .Kind "agent"}}<span class="evi lead" title="{{t "wb.stream.agent"}}">L</span>{{else if .OwnerAnswer}}<span class="evi owner" title="{{t "wb.stream.owner"}}">O</span>{{else}}<span class="evi sys"></span>{{end}}<span class="entry-text">{{template "entrytime" .}}{{if or .At .Imported}}<span class="sep"> — </span>{{end}}{{.Page.Inline .Text}}{{if .Current}}<span class="ptag">{{t "wb.stream.current"}}</span>{{end}}</span></div>{{end}}</article>{{end}}

{{/* clock is the one entry-at time element: ago.js turns every time.entry-at[data-at] into relative time, so each history row kind must carry data-at and data-stamp. */}}{{define "clock"}}<time class="entry-at{{with .Class}} {{.}}{{end}}"{{with .At}} datetime="{{.}}"{{end}}{{with .Stamp}} title="{{.}}" data-stamp="{{.}}"{{end}}{{with .Ms}} data-at="{{.}}"{{end}}>{{.Clock}}</time>{{end}}
{{define "entrytime"}}{{with .At}}{{template "clock" (clockOf . $.Ms $.Stamp $.Clock "")}}{{end}}{{if .Imported}}<span class="entry-imported">{{t "wb.stream.imported"}}</span>{{end}}{{end}}

{{define "settled"}}{{if .SettledCount}}<details class="settled"{{if .Expanded}} open{{end}}><summary title="{{t "wb.settled"}}">{{icon "list"}}{{.SettledCount}}</summary>{{if and .Closed .Checks}}{{template "checks" .}}{{end}}{{range .Expanded}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{if .Expanded}}{{with .Collapsed}}<details class="more"><summary title="{{t "wb.settled.older"}}">+{{len .}}</summary>{{range .}}{{template "srow" ($.Page.ItemOf .)}}{{end}}</details>{{end}}{{else}}{{range .Collapsed}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{end}}</details>{{end}}{{end}}

{{define "newdot"}}{{if .IsNew}}<span class="new" title="{{t "chip.fresh"}}"></span>{{end}}{{end}}

{{define "text"}}{{range .}}{{if .Target}}<a href="#{{.Target}}">{{.Text}}</a>{{else if .Ref}}<a href="#item-{{.Ref}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}{{end}}

{{define "ctx"}}{{if .Rationale}}<div class="ctx md">{{.RationaleHTML}}</div>{{end}}{{end}}

{{define "links"}}{{with .Links}}<span class="links">{{range .}}<span class="link">{{icon "link"}}{{$.Page.TextInline .}}</span>{{end}}</span>{{end}}{{end}}

{{define "policy"}}<div class="card policy" id="item-{{.ID}}" data-id="{{.Num}}">
  <div class="cbar"><span class="head"><span class="id">{{.Label}}</span><span class="cls">policy</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>{{template "askjump" .}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button></div>
  <div class="cbody">{{template "ctx" .}}{{template "links" .}}{{template "opts" .}}
  <textarea class="note" rows="1" placeholder="✎" title="{{t "wb.note"}}" hidden></textarea></div>
</div>{{end}}

{{/* opts is an item's lettered options and recommendation line. The open
card's options are the answer controls (data-opt, aria-pressed), which form.js
and the dashboard's answer scripts read; a settled row's expanded body renders
them Static, with none of those attributes, the pick shown by a class. */}}
{{define "opts"}}{{with .Options}}{{if $.Stacked}}<div class="opts stack">{{range .}}{{if $.Static}}<div class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}">{{else}}<div class="opt{{if .Recommended}} rec{{end}}" role="button" tabindex="0" data-opt="{{.Letter}}" aria-pressed="false">{{end}}<span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><div class="md">{{$.OptionHTML .}}</div></div>{{end}}</div>{{else}}<div class="opts">{{range .}}{{if $.Static}}<span class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}">{{else}}<button class="opt{{if .Recommended}} rec{{end}}" data-opt="{{.Letter}}" aria-pressed="false">{{end}}<span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><span>{{$.OptionHTML .}}</span>{{if $.Static}}</span>{{else}}</button>{{end}}{{end}}</div>{{end}}{{end}}{{if .RecLetter}}
  <div class="rec-line md" title="{{t "wb.rec"}}"><b>{{icon "star"}}{{.RecLetter}}</b> {{.RecHTML}}</div>{{end}}{{end}}

{{define "ack"}}<div class="arow" id="item-{{.ID}}" data-id="{{.Num}}"><label class="ack"><input type="checkbox" data-id="{{.Num}}"><span class="atext"><span class="head"><span class="id">{{.Label}}</span><span class="tag {{.Class}}">{{.Class}}</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>{{range lines .Rationale}}<span class="why">{{$.Page.Inline .}}</span>{{end}}{{template "links" .}}</span></label>{{template "askjump" .}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.note"}}" hidden></textarea></div>{{end}}

{{/* checks is an embed topic's check list: in flow under the head while the
topic is open (its count is the head's pill, ckpill), inside the settled fold with its
own count line once it is closed. Rows carry no class tag, and none
reuses label.ack, which the reply bar's all-ok box selects page-wide: a check
is answered one at a time. An open topic with an answered check carries the
hide toggle (button.ckhide) in its pill, which form.js wires and page.css
hides where that script does not run. */}}
{{define "checks"}}<div class="checks">{{if .Closed}}<div class="chead">{{icon "todo"}}{{t "wb.checks"}}<span class="prog">{{t "wb.checks.progress" .AnsweredChecks (len .Checks)}}</span></div>{{end}}{{range .Checks}}{{if or $.Page.Embed (eq .Status "open")}}{{template "check" ($.Page.ItemOf .)}}{{end}}{{end}}</div>{{end}}

{{/* ckpill is an embed topic's check summary in its head, heading its
in-flow check list: the progress count and, with an answered check, the hide
toggle. The full page has no pill: its open checks stack after the history. */}}
{{define "ckpill"}}<div class="ckpill"><span class="ckbtn">{{icon "todo"}}{{t "wb.checks"}}<span class="prog">{{t "wb.checks.progress" .AnsweredChecks (len .Checks)}}</span></span>{{if .HideableChecks}}<button type="button" class="btn mini ckhide" aria-pressed="true" title="{{t "wb.checks.hide"}}">{{icon "eye-off"}}</button>{{end}}</div>{{end}}

{{/* check is one check row. An open row (the item-N anchor: on the full page
it is the bottom-stacked card) has a box that answers ok and an x button that
answers no (form.js); an answered or assumed row is locked and stamped, a "no" row
quoting the user's words below it. Only an open or assumed row carries data-id
(the answer scripts read .ckrow[data-id]); an assumed row is also marked
data-assumed, and its pen takes a veto or comment as a note alone. */}}
{{define "check"}}{{if eq .Status "open"}}<div class="ckrow" id="item-{{.ID}}" data-id="{{.Num}}"><label class="ck"><input type="checkbox" data-id="{{.Num}}"><span class="atext">{{template "checkhead" .}}{{range lines .Rationale}}<span class="why">{{$.Page.Inline .}}</span>{{end}}{{template "links" .}}</span></label>{{template "askjump" .}}<button class="btn mini no-toggle" aria-pressed="false" title="{{t "wb.check.no"}}">{{icon "x"}}</button><button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.note"}}" hidden></textarea></div>{{else}}<div class="ckrow {{if .CheckNo}}no{{else}}done{{end}}" id="{{if .Page.Full}}check{{else}}item{{end}}-{{.ID}}"{{if .Assumed}} data-id="{{.Num}}" data-assumed{{end}}><span class="ck">{{if .CheckNo}}<span class="cbox">{{icon "x"}}</span>{{else}}<input type="checkbox" checked disabled>{{end}}<span class="atext">{{template "checkhead" .}}{{if .Assumed}}<span class="amark" title="{{t "wb.assumed.title"}}">{{t "chip.assumed"}}</span>{{end}}{{with .CheckVerdict}}<span class="stamp">{{.}}</span>{{end}}{{with .CheckReading}}<span class="ans" title="{{t "wb.read"}}">{{$.Page.TextInline .}}</span>{{end}}{{template "links" .}}{{if .CheckNo}}{{with .AnswerQuote}}<span class="said" title="{{t "wb.quote"}}">{{.}}</span>{{end}}{{end}}</span></span>{{if .Assumed}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.correction"}}" hidden></textarea>{{end}}</div>{{end}}{{end}}

{{define "checkhead"}}<span class="head"><span class="id">{{.Label}}</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>{{end}}

{{/* srow is a settled item's row. With anything more to show (Expandable)
the compact text is the summary of a details keyed item:<ID>, whose body is the
original item; an assumed row's pen and note follow it as siblings, so they
stay visible while it is closed and never toggle it. Only an assumed row
carries data-id: the answer scripts read every .srow[data-id]. */}}
{{define "srow"}}<div class="srow{{if .Void}} void{{end}}"{{if .HistoryAnchor}} id="item-{{.ID}}"{{end}}{{if and .Assumed (not .TimelineCheck)}} data-id="{{.Num}}"{{end}}>{{if .Expandable}}<details class="sx" data-key="item:{{.ID}}"{{if .TimelineCheck}} open{{end}}><summary>{{template "stext" .}}</summary><div class="sbody">{{if .TimelineCheck}}<div class="checks">{{template "check" .}}</div>{{else}}{{template "ctx" .}}{{template "opts" .AsStatic}}{{end}}</div></details>{{else}}{{template "stext" .}}{{end}}{{if and .Assumed (not .TimelineCheck)}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.correction"}}" hidden></textarea>{{end}}</div>{{end}}

{{define "stext"}}<span class="stext"><span class="id"{{if .Void}} title="{{.Status}}"{{end}}>{{.Label}}</span>{{if eq .Status "commented"}}<span>{{.HistoryStatusLabel}}</span>{{end}}{{if .Assumed}}<span class="amark" title="{{t "wb.assumed.title"}}">{{t "chip.assumed"}}</span>{{end}}{{template "newdot" .}}<b>{{.Page.Inline .Title}}</b>{{with .PickedOption}} <span class="pick" title="{{t "wb.picked"}}"><span class="k">{{.Letter}}</span><span class="pt">{{$.PickedChip .}}</span></span>{{else}}{{if .TimelineCheck}} <span class="pick" title="{{t "wb.read"}}"><span class="pt">{{if .CheckVerdict}}{{.CheckVerdict}}{{else}}{{.Status}}{{end}}</span></span>{{end}}{{end}}{{with .Reading}} <span class="ans" title="{{t "wb.read"}}">{{$.Page.TextInline .}}</span>{{end}}{{with .AnswerQuote}} <span class="quote" title="{{t "wb.quote"}}">“{{.}}”</span>{{end}}{{template "links" .}}</span>{{end}}

{{/* Timeline items reuse ctx/opts and the static-option sanitizer path.
Their identity/class/status occur once; only useful additional content folds.
The current open-question and compact embed renderers remain independent. */}}
{{define "historyitem"}}<div class="srow wb-hitem {{.Class}}{{if .Void}} void{{end}}{{if .Assumed}} wb-hassumed{{end}}"{{if .HistoryAnchor}} id="item-{{.ID}}"{{end}}{{if and .Assumed .HistoryAnchor (not .TimelineCheck)}} data-id="{{.Num}}"{{end}}>{{if .HistoryExpandable}}<details class="sx" data-key="{{if not .History}}question{{else if .History.ID}}settlement{{else}}item{{end}}:{{.ID}}"{{if .TimelineCheck}} open{{end}}><summary>{{template "historytext" .}}</summary><div class="sbody">{{if .TimelineCheck}}<div class="checks">{{template "check" .}}</div>{{end}}{{with .HistoryRationaleHTML}}<div class="ctx md">{{.}}</div>{{end}}{{template "opts" .AsStatic}}{{with .HistoryPastAnswer}}<div class="ans wb-hpast">{{t "wb.history.answered"}}: {{$.Page.TextInline .}}</div>{{end}}{{with .HistoryReading}}<div class="ans" title="{{t "wb.read"}}">{{$.Page.TextInline .}}</div>{{end}}{{with .HistoryQuote}}<blockquote class="quote" title="{{t "wb.quote"}}">{{.}}</blockquote>{{end}}{{with .HistoryAnswerTime}}<div class="wb-hanswer-at">{{t "wb.history.answer_at"}} <time datetime="{{.}}">{{.}}</time></div>{{end}}{{template "links" .}}</div></details>{{else}}{{template "historytext" .}}{{template "links" .}}{{end}}{{if and .Assumed .HistoryAnchor (not .TimelineCheck)}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.correction"}}" hidden></textarea>{{end}}</div>{{end}}

{{define "askclock"}}{{with .AskClock}}{{template "clock" (clockOf $.AskAt $.AskMs $.AskStamp . "wb-htime")}}{{else}}<span class="wb-htime"></span>{{end}}{{end}}

{{define "historytext"}}<span class="stext wb-htext">{{if not .History}}{{template "askclock" .}}{{end}}{{with .History}}{{if .Clock}}{{template "clock" (clockOf .At .Ms .Stamp .Clock "wb-htime")}}{{else}}<span class="wb-htime wb-hunknown">{{t "wb.history.unknown"}}</span>{{end}}{{end}}<span class="wb-hmark" title="{{.HistoryClassLabel}}">{{.HistoryMark}}</span><span class="wb-hmain"><span class="id">{{.Label}}</span><span class="wb-hclass">{{.HistoryClassLabel}}</span>{{with .AskReasked}}<span class="wb-hreask">{{t "wb.timeline.reasked"}} {{.}}</span>{{end}}<b>{{.Page.Inline .Title}}</b></span><span class="wb-hstatus" title="{{.HistoryStatusLabel}}">{{if and (eq .Class "check") (not .Void)}}<span class="pick" title="{{t "wb.read"}}"><span class="pt">{{if .CheckVerdict}}{{.CheckVerdict}}{{else}}{{.HistoryStatusLabel}}{{end}}</span></span>{{else}}{{if or .Void (not .Answer)}}{{.HistoryStatusLabel}}{{else}}{{if .Assumed}}{{.HistoryStatusLabel}} · {{end}}{{with .PickedOption}}<span class="pick" title="{{t "wb.picked"}}"><span class="k">{{.Letter}}</span><span class="pt">{{$.PickedChip .}}</span></span>{{else}}{{.Page.TextInline .Answer}}{{end}}{{end}}{{end}}</span></span>{{end}}

{{define "panel"}}<details class="panel" id="p-{{.ID}}"{{if .Page.Full}} open{{end}}><summary>{{icon .IconName}}{{.Title}}{{with .Count}}<span class="chip">{{.}}</span>{{end}}</summary><div class="body">{{with .Lanes}}<div class="lanes">{{range .}}{{template "lane" .}}{{end}}</div>{{end}}{{if .Rows}}<ul class="rows">{{range .Rows}}{{template "row" .}}{{end}}</ul>{{end}}{{with .Tree}}<ul class="tree">{{range .}}{{template "tnode" .}}{{end}}</ul>{{end}}{{with .Folded}}<details class="folded"><summary class="chip" title="{{t "agent.done"}}">{{t "wb.done" (len .)}}</summary><ul class="rows">{{range .}}{{template "row" .}}{{end}}</ul></details>{{end}}</div></details>{{end}}

{{define "tnode"}}<li>{{if .IsContainer}}<details class="tnode" data-key="{{.Path}}"{{if .Open}} open{{end}}><summary><span class="tkey">{{.Key}}</span><span class="tsum">{{.Value}}</span></summary><ul>{{range .Children}}{{template "tnode" .}}{{end}}</ul></details>{{else if .Long}}<details class="tnode tlong" data-key="{{.Path}}"><summary><span class="tkey">{{.Key}}</span><span class="tv str">{{.Value}}</span></summary><div class="tfull">{{.Value}}</div></details>{{else}}<div class="tleaf"><span class="tkey">{{.Key}}</span><span class="tv {{.Kind}}">{{.Value}}</span></div>{{end}}</li>{{end}}

{{define "lane"}}<section class="lane"><h4><span class="lname">{{.Name}}</span><span class="chip">{{.Count}}</span>{{with .Note}}<span class="lnote">{{.}}</span>{{end}}</h4><ul class="kcards">{{range .Rows}}{{template "card" .}}{{else}}<li class="none">{{t "wb.none"}}</li>{{end}}</ul></section>{{end}}

{{define "card"}}<li class="kcard"><span class="ctitle"{{if and (not .Link) (not .IsAction) .Path}} title="{{.Path}}"{{end}}>{{with .Label}}<span class="chip cat {{.}}">{{.}}</span>{{end}}{{if .Link}}<a href="{{href .Link}}">{{.Text}}</a>{{else if .IsAction}}<a{{actionAttrs .}}>{{.Text}}</a>{{else}}{{.Text}}{{end}}</span>{{with .Sub}}<span class="csub" title="{{.}}">{{.}}</span>{{end}}</li>{{end}}

{{define "row"}}{{if .State}}<li class="{{.State}}"{{with .Label}} title="{{.}}"{{end}}><span class="box">{{icon (box .State)}}</span><span>{{template "rowtext" .}}</span></li>{{else}}<li class="keyed">{{with .Label}}<code>{{.}}</code>{{end}}<span>{{template "rowtext" .}}</span></li>{{end}}{{end}}

{{define "rowtext"}}{{if .Link}}<a href="{{href .Link}}">{{.Text}}</a>{{else if .IsAction}}<a{{actionAttrs .}}>{{.Text}}</a>{{else}}{{.Text}}{{with .Path}} <code class="fpath">{{.}}</code>{{end}}{{end}}{{end}}

{{define "reply"}}{{if or .Answerable .Topics}}<div class="reply{{if not .BulkAck}} solo{{end}}"{{if not .Answerable}} data-idle hidden{{end}}>{{if .BulkAck}}<label class="allok" title="{{t "wb.allok"}}"><input type="checkbox" id="ack-all">{{icon "check"}}{{.CountBulk}}</label>{{end}}<textarea id="reply-text" readonly placeholder="(nn) a; (mm) ok"></textarea><button class="btn primary" id="reply-copy" title="{{t "wb.copy"}}">{{icon "copy"}}</button><span class="hint" id="reply-hint"></span></div>{{end}}{{end}}
