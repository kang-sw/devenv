{{define "page"}}<!DOCTYPE html>
<html{{if .Full}} data-stamp="{{.StampFile}}" data-seq="{{.Seq}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{t "wb.title"}} - {{.ReplyID}}</title>
<style>{{.CSS}}</style></head>
<body class="{{if .Full}}full{{else}}embed{{end}}">{{.Sprite}}<div class="wrap">
{{if .Full}}<div class="banner" id="wb-banner" title="{{t "wb.banner"}}">{{icon "reload"}}</div>
{{end}}<div class="top"><h1>{{t "wb.title"}}</h1><span class="meta">{{.ReplyID}} · #{{.Seq}}</span><span class="counts">{{with .CountPolicy}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}{{if .Embed}}{{with .CountFresh}}<span class="chip fresh" title="{{t "chip.fresh"}}"><span class="new"></span>{{.}}</span>{{end}}{{end}}</span></div>
{{if .Full}}<div class="grid solo"><main>{{template "board" .}}</main>{{if .Panels}}<aside class="side flat">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</aside>{{end}}</div>
{{else}}{{template "board" .}}<p class="full-board-link"><a href="{{href .FullBoardLink}}">{{t "wb.stream.full"}}</a></p>{{if .Panels}}<div class="side flat">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</div>{{end}}
{{end}}</div>
<script>{{i18n}}</script>
<script>{{.Script}}</script>
{{if .Mermaid}}<script src="{{.MermaidFile}}"></script>
<script>{{.MermaidInit}}</script>
{{end}}</body></html>
{{end}}

{{define "board"}}{{range .Topics}}{{template "topic" ($.TopicOf .)}}{{end}}{{template "closedmore" .}}{{range .DeferredTopics}}<template data-history-topic="{{.Name}}">{{template "topic" ($.TopicOf .)}}</template>{{end}}{{template "reply" .}}{{end}}

{{define "closedpage"}}<div class="closed-page">{{range .Topics}}{{template "topic" ($.TopicOf .)}}{{end}}{{template "closedmore" .}}</div>{{end}}

{{define "closedmore"}}{{with .ClosedMore}}{{if $.DocFramed}}<button class="btn closed-more" data-closed-next="{{$.ClosedNext}}">{{t "wb.closed.showmore" .}}</button>{{else}}<div class="closed-more">{{t "wb.closed.more" .}}</div>{{end}}{{end}}{{end}}

{{define "tago"}}{{with .UpdatedAt}}<time class="tago" datetime="{{.}}" title="{{t "wb.updated"}}"{{if $.Page.Full}} data-at="{{$.UpdatedMs}}"{{end}}>{{$.UpdatedClock}}</time>{{end}}{{end}}

{{/* recap is the topic's current-state line, the latest agent log line (a
legacy recap until converted): its text, then its time in the topic bar's
notation (relative where ago.js runs, through data-at), the local date and
time as the hover title. An agent line is marked as one, its clock before the
relative time where that runs. It shows above the body while the topic is
open and inside the body's fold once it is closed. */}}
{{define "recap"}}<div class="trecap"{{with .LatestAgent}} data-entry="{{.ID}}" data-kind="agent"{{end}}><div class="rtext md">{{.Page.RecapHTML .TopicView}}</div>{{with .RecapAt}}<span class="rat" title="{{$.RecapStamp}}">{{if $.LatestAgent}}<span class="evi lead" title="{{t "wb.stream.agent"}}">L</span>{{if $.Page.Full}}{{$.RecapClock}} · {{end}}{{else}}{{t "wb.recap"}} {{end}}<time class="tago" datetime="{{.}}"{{if $.Page.Full}} data-at="{{$.RecapMs}}"{{end}}>{{$.RecapClock}}</time></span>{{end}}</div>{{end}}

{{define "doc"}}{{if .HasFold}}<details class="tdoc" data-key="doc:{{.Name}}"{{if .DocOpen .Page.Embed}} open{{end}}><summary title="{{t "wb.doc"}}">{{icon "book"}}{{if and .Page.Embed .DocNew}}<span class="new" title="{{t "chip.fresh"}}"></span>{{end}}</summary>{{if .RecapFolded}}{{template "recap" .}}{{end}}{{if .Doc}}<div class="doc-body {{.DocClass}}">{{.Page.DocHTML .Name}}</div>{{end}}</details>{{end}}{{end}}

{{define "topic"}}<section class="topic{{if .Quiet}} quiet{{end}}{{if .Closed}} closed{{end}}{{if .HasFold}} has-doc{{end}}" data-topic="{{.Name}}"><div class="tbar"><span class="tlead"><span class="tname"{{if .Closed}} title="{{t "wb.closed"}}"{{end}}>{{.Label}}</span>{{if and .Closed .Result}}<span class="tresult" title="{{t "wb.result"}}">{{.Page.Inline .Result}}</span>{{end}}</span>{{template "tago" .}}{{if .Page.Embed}}{{with .Fresh}}<span class="chip fresh" title="{{t "chip.fresh"}}"><span class="new"></span>{{.}}</span>{{end}}{{end}}{{with .AskCount}}{{if and $.Page.BulkChips $.Policy}}<button type="button" class="chip policy bulk" data-bulk="policy" title="{{t "chip.bulk.policy"}}">{{icon "ask"}}{{.}}</button>{{else}}<span class="chip policy" title="{{t "chip.answer"}}">{{icon "ask"}}{{.}}</span>{{end}}{{end}}{{with len .Acks}}{{if $.Page.BulkChips}}<button type="button" class="chip ok bulk" data-bulk="ack" title="{{t "chip.bulk.ack"}}">{{icon "check"}}{{.}}</button>{{else}}<span class="chip ok" title="{{t "chip.ack"}}">{{icon "check"}}{{.}}</span>{{end}}{{end}}{{if .Quiet}}{{template "settled" .}}{{end}}<button class="btn mini tnote-toggle" title="{{t "wb.topic.note"}}">{{icon "pen"}}</button></div><textarea class="note tnote" data-topic="{{.Name}}" rows="1" placeholder="✎" title="{{t "wb.topic.note"}}" hidden></textarea>{{if .RecapOpen}}{{template "recap" .}}{{end}}{{if .ChecksShown}}{{template "checks" .}}{{end}}{{template "doc" .}}{{template "stream" .}}{{if not .Quiet}}{{if or .Policy .Acks .SettledCount}}<div class="tbody">{{range .Policy}}{{template "policy" ($.Page.ItemOf .)}}{{end}}{{if .Acks}}<div class="acks">{{range .Acks}}{{template "ack" ($.Page.ItemOf .)}}{{end}}</div>{{end}}{{template "settled" .}}</div>{{end}}{{end}}</section>
{{end}}

{{/* The topic stream: one chronological column under the body, a quiet
header with its counts, then panel cards and one-line log rows. The log
between two panels is one run; a long run folds behind one row (the newest
run keeps its last rows visible), and adjacent system events fold behind one
chip inside it (EntryPage.Segments). Earlier versions of a panel fold inside
its latest card. Inert pages keep payloads out of the live DOM until the user
explicitly loads them; the embed carries only the latest panel recaps. */}}
{{define "stream"}}{{if .Page.Embed}}{{if .PanelRecaps}}<div class="tstream embed"><div class="mhead">{{icon "list"}}{{t "wb.stream.panels"}} <span class="n">{{len .PanelRecaps}}</span></div><ul class="panel-recaps">{{range .PanelRecaps}}<li data-entry="{{.ID}}" data-kind="panel" data-panel="{{.PanelID}}"><span class="entry-recap">{{$.Page.Inline .Recap}}</span>{{with .Clock}}<span class="entry-at">{{.}}</span>{{end}}<a class="mref" href="{{href (printf "%s#%s" $.Page.FullBoardLink .PanelID)}}">#{{.PanelID}}</a></li>{{end}}</ul></div>{{end}}{{else}}{{if .Stream.Count}}<details class="topic-stream" data-key="history:{{.Name}}"{{if not .Closed}} open{{end}}><summary class="mhead">{{icon "list"}}{{t "wb.stream"}} <span class="n">{{.StreamTotal}}</span><span class="mmeta">{{t "wb.stream.meta" (len .PanelRecaps) .StreamLines}}</span></summary><div class="wb-history" data-history="{{.Name}}" tabindex="0" aria-label="{{t "wb.stream"}}"><button type="button" class="history-older"{{if not .Older}} hidden{{end}}>{{t "wb.stream.older"}}</button><div class="history-live">{{template "entrypage" (.Page.EntryPageOf .Stream true)}}</div>{{range .Older}}<template data-history-page data-count="{{.Count}}">{{template "entrypage" ($.Page.EntryPageOf . false)}}</template>{{end}}</div></details>{{end}}{{end}}{{end}}

{{define "entrypage"}}{{range .Entries.Segments .Tail}}{{if .IsPanel}}{{template "entry" ($.Page.EntryOf .Panel)}}{{else}}{{if .Fold}}<details class="run-fold{{if .FoldOwner}} owner{{end}}" data-key="run:{{.FoldKey}}" data-history-anchor="{{.FoldKey}}"><summary><span class="rl"></span><span class="lbl">{{t "js.wb.stream.run" .FoldCount .FoldRange}}</span></summary>{{range .Fold}}{{template "logrow" ($.Page.RowOf .)}}{{end}}</details>{{end}}{{range .Rows}}{{template "logrow" ($.Page.RowOf .)}}{{end}}{{end}}{{end}}{{end}}

{{define "logrow"}}{{if .Systems}}<details class="system-run" data-key="system:{{(index .Systems 0).ID}}" data-history-anchor="{{(index .Systems 0).ID}}"><summary><span class="rl"></span><span class="lbl">{{t "js.wb.stream.system" (len .Systems) .Range}}</span></summary>{{range .Systems}}{{template "entry" ($.Page.EntryOf .)}}{{end}}</details>{{else}}{{template "entry" (.Page.EntryOf .Entry)}}{{end}}{{end}}

{{define "entry"}}<article class="wb-entry {{.Kind}}{{if .Historical}} historical{{end}}{{if .Current}} current{{end}}{{if .OwnerAnswer}} owner{{end}}" id="{{.ID}}" data-history-anchor="{{.ID}}" data-entry="{{.ID}}" data-kind="{{.Kind}}"{{with .PanelID}} data-panel="{{.}}"{{end}}{{with .ItemID}} data-entry-item="{{.}}"{{end}}>{{if .IsPanel}}<details class="entry-panel{{if not .Text}} msg{{end}}" data-key="entry:{{.ID}}{{if .Historical}}:history{{end}}"{{if not .Historical}} id="{{.PanelID}}"{{end}}{{if .Open}} open{{end}}><summary><span class="entry-recap">{{.Page.Inline .Recap}}</span><span class="pmeta">{{template "entrytime" .}}{{if .Text}}<span class="hint">{{with .ImageCount}}{{t "wb.stream.images" .}} · {{end}}{{t "wb.stream.lines" .LineCount}}</span>{{end}}{{if not .Historical}}<a class="mref" href="#{{.PanelID}}">#{{.PanelID}}</a>{{end}}</span></summary>{{if .Text}}<div class="doc-body entry-body {{.PayloadClass}}">{{.Page.EntryHTML .ID}}</div>{{end}}{{with .Versions}}<details class="panel-versions" data-key="versions:{{$.ID}}"><summary>{{t "wb.stream.versions" (len .)}}</summary>{{range .}}{{template "entry" ($.Page.EntryOf .)}}{{end}}</details>{{end}}</details>{{else}}<div class="entry-line">{{template "entrytime" .}}{{if eq .Kind "agent"}}<span class="evi lead" title="{{t "wb.stream.agent"}}">L</span>{{else if .OwnerAnswer}}<span class="evi owner" title="{{t "wb.stream.owner"}}">O</span>{{else}}<span class="evi sys"></span>{{end}}<span class="entry-text">{{.Page.Inline .Text}}{{if .Current}}<span class="ptag">{{t "wb.stream.current"}}</span>{{end}}</span></div>{{end}}</article>{{end}}

{{define "entrytime"}}{{with .At}}<time class="entry-at" datetime="{{.}}" title="{{$.Stamp}}" data-stamp="{{$.Stamp}}"{{with $.Ms}} data-at="{{.}}"{{end}}>{{$.Clock}}</time>{{end}}{{if .Imported}}<span class="entry-imported">{{t "wb.stream.imported"}}</span>{{end}}{{end}}

{{define "settled"}}{{if .SettledCount}}<details class="settled"{{if .Expanded}} open{{end}}><summary title="{{t "wb.settled"}}">{{icon "list"}}{{.SettledCount}}</summary>{{if and .Closed .Checks}}{{template "checks" .}}{{end}}{{range .Expanded}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{if .Expanded}}{{with .Collapsed}}<details class="more"><summary title="{{t "wb.settled.older"}}">+{{len .}}</summary>{{range .}}{{template "srow" ($.Page.ItemOf .)}}{{end}}</details>{{end}}{{else}}{{range .Collapsed}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{end}}</details>{{end}}{{end}}

{{define "newdot"}}{{if .IsNew}}<span class="new" title="{{t "chip.fresh"}}"></span>{{end}}{{end}}

{{define "text"}}{{range .}}{{if .Target}}<a href="#{{.Target}}">{{.Text}}</a>{{else if .Ref}}<a href="#item-{{.Ref}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}{{end}}

{{define "ctx"}}{{if .Rationale}}<div class="ctx md">{{.RationaleHTML}}</div>{{end}}{{end}}

{{define "links"}}{{with .Links}}<span class="links">{{range .}}<span class="link">{{icon "link"}}{{$.Page.TextInline .}}</span>{{end}}</span>{{end}}{{end}}

{{define "policy"}}<div class="card policy" id="item-{{.ID}}" data-id="{{.Num}}">
  <div class="cbar"><span class="head"><span class="id">{{.Label}}</span><span class="cls">policy</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span><button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button></div>
  <div class="cbody">{{template "ctx" .}}{{template "links" .}}{{template "opts" .}}
  <textarea class="note" rows="1" placeholder="✎" title="{{t "wb.note"}}" hidden></textarea></div>
</div>{{end}}

{{/* opts is an item's lettered options and recommendation line. The open
card's options are the answer controls (data-opt, aria-pressed), which form.js
and the dashboard's answer scripts read; a settled row's expanded body renders
them Static, with none of those attributes, the pick shown by a class. */}}
{{define "opts"}}{{with .Options}}{{if $.Stacked}}<div class="opts stack">{{range .}}{{if $.Static}}<div class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}">{{else}}<div class="opt{{if .Recommended}} rec{{end}}" role="button" tabindex="0" data-opt="{{.Letter}}" aria-pressed="false">{{end}}<span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><div class="md">{{$.OptionHTML .}}</div></div>{{end}}</div>{{else}}<div class="opts">{{range .}}{{if $.Static}}<span class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}">{{else}}<button class="opt{{if .Recommended}} rec{{end}}" data-opt="{{.Letter}}" aria-pressed="false">{{end}}<span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><span>{{$.OptionHTML .}}</span>{{if $.Static}}</span>{{else}}</button>{{end}}{{end}}</div>{{end}}{{end}}{{if .RecLetter}}
  <div class="rec-line md" title="{{t "wb.rec"}}"><b>{{icon "star"}}{{.RecLetter}}</b> {{.RecHTML}}</div>{{end}}{{end}}

{{define "ack"}}<div class="arow" id="item-{{.ID}}" data-id="{{.Num}}"><label class="ack"><input type="checkbox" data-id="{{.Num}}"><span class="atext"><span class="head"><span class="id">{{.Label}}</span><span class="tag {{.Class}}">{{.Class}}</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>{{range lines .Rationale}}<span class="why">{{$.Page.Inline .}}</span>{{end}}{{template "links" .}}</span></label><button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.note"}}" hidden></textarea></div>{{end}}

{{/* checks is a topic's check list: under the recap while the topic is open,
inside the settled fold once it is closed. Rows carry no class tag, and none
reuses label.ack, which the reply bar's all-ok box selects page-wide: a check
is answered one at a time. An open topic's list with an answered check carries
the hide toggle (button.ckhide), which form.js wires and page.css hides where
that script does not run. */}}
{{define "checks"}}<div class="checks"><div class="chead">{{icon "todo"}}{{t "wb.checks"}}<span class="prog">{{t "wb.checks.progress" .AnsweredChecks (len .Checks)}}</span>{{if and (not .Closed) .HideableChecks}}<button type="button" class="btn mini ckhide" aria-pressed="true" title="{{t "wb.checks.hide"}}">{{icon "eye-off"}}</button>{{end}}</div>{{range .Checks}}{{template "check" ($.Page.ItemOf .)}}{{end}}</div>{{end}}

{{/* check is one check row. An open row's box answers ok and its x button
no (form.js); an answered or assumed row is locked and stamped, a "no" row
quoting the user's words below it. Only an open or assumed row carries data-id
(the answer scripts read .ckrow[data-id]); an assumed row is also marked
data-assumed, and its pen takes a veto or comment as a note alone. */}}
{{define "check"}}{{if eq .Status "open"}}<div class="ckrow" id="item-{{.ID}}" data-id="{{.Num}}"><label class="ck"><input type="checkbox" data-id="{{.Num}}"><span class="atext">{{template "checkhead" .}}{{range lines .Rationale}}<span class="why">{{$.Page.Inline .}}</span>{{end}}{{template "links" .}}</span></label><button class="btn mini no-toggle" aria-pressed="false" title="{{t "wb.check.no"}}">{{icon "x"}}</button><button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.note"}}" hidden></textarea></div>{{else}}<div class="ckrow {{if .CheckNo}}no{{else}}done{{end}}" id="item-{{.ID}}"{{if .Assumed}} data-id="{{.Num}}" data-assumed{{end}}><span class="ck">{{if .CheckNo}}<span class="cbox">{{icon "x"}}</span>{{else}}<input type="checkbox" checked disabled>{{end}}<span class="atext">{{template "checkhead" .}}{{if .Assumed}}<span class="amark" title="{{t "wb.assumed.title"}}">{{t "chip.assumed"}}</span>{{end}}{{with .CheckVerdict}}<span class="stamp">{{.}}</span>{{end}}{{with .CheckReading}}<span class="ans" title="{{t "wb.read"}}">{{$.Page.TextInline .}}</span>{{end}}{{template "links" .}}{{if .CheckNo}}{{with .AnswerQuote}}<span class="said" title="{{t "wb.quote"}}">{{.}}</span>{{end}}{{end}}</span></span>{{if .Assumed}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.correction"}}" hidden></textarea>{{end}}</div>{{end}}{{end}}

{{define "checkhead"}}<span class="head"><span class="id">{{.Label}}</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>{{end}}

{{/* srow is a settled item's row. With anything more to show (Expandable)
the compact text is the summary of a details keyed item:<ID>, whose body is the
original item; an assumed row's pen and note follow it as siblings, so they
stay visible while it is closed and never toggle it. Only an assumed row
carries data-id: the answer scripts read every .srow[data-id]. */}}
{{define "srow"}}<div class="srow{{if .Void}} void{{end}}" id="item-{{.ID}}"{{if .Assumed}} data-id="{{.Num}}"{{end}}>{{if .Expandable}}<details class="sx" data-key="item:{{.ID}}"><summary>{{template "stext" .}}</summary><div class="sbody">{{template "ctx" .}}{{template "opts" .AsStatic}}</div></details>{{else}}{{template "stext" .}}{{end}}{{if .Assumed}}<button class="btn mini note-toggle" title="{{t "wb.note"}}">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="{{t "wb.correction"}}" hidden></textarea>{{end}}</div>{{end}}

{{define "stext"}}<span class="stext"><span class="id"{{if .Void}} title="{{.Status}}"{{end}}>{{.Label}}</span>{{if .Assumed}}<span class="amark" title="{{t "wb.assumed.title"}}">{{t "chip.assumed"}}</span>{{end}}{{template "newdot" .}}<b>{{.Page.Inline .Title}}</b>{{with .PickedOption}} <span class="pick" title="{{t "wb.picked"}}"><span class="k">{{.Letter}}</span><span class="pt">{{$.PickedChip .}}</span></span>{{end}}{{with .Reading}} <span class="ans" title="{{t "wb.read"}}">{{$.Page.TextInline .}}</span>{{end}}{{with .AnswerQuote}} <span class="quote" title="{{t "wb.quote"}}">“{{.}}”</span>{{end}}{{template "links" .}}</span>{{end}}

{{define "panel"}}<details class="panel" id="p-{{.ID}}"{{if .Page.Full}} open{{end}}><summary>{{icon .IconName}}{{.Title}}{{with .Count}}<span class="chip">{{.}}</span>{{end}}</summary><div class="body">{{with .Lanes}}<div class="lanes">{{range .}}{{template "lane" .}}{{end}}</div>{{end}}{{if .Rows}}<ul class="rows">{{range .Rows}}{{template "row" .}}{{end}}</ul>{{end}}{{with .Tree}}<ul class="tree">{{range .}}{{template "tnode" .}}{{end}}</ul>{{end}}{{with .Folded}}<details class="folded"><summary class="chip" title="{{t "agent.done"}}">{{t "wb.done" (len .)}}</summary><ul class="rows">{{range .}}{{template "row" .}}{{end}}</ul></details>{{end}}</div></details>{{end}}

{{define "tnode"}}<li>{{if .IsContainer}}<details class="tnode" data-key="{{.Path}}"{{if .Open}} open{{end}}><summary><span class="tkey">{{.Key}}</span><span class="tsum">{{.Value}}</span></summary><ul>{{range .Children}}{{template "tnode" .}}{{end}}</ul></details>{{else if .Long}}<details class="tnode tlong" data-key="{{.Path}}"><summary><span class="tkey">{{.Key}}</span><span class="tv str">{{.Value}}</span></summary><div class="tfull">{{.Value}}</div></details>{{else}}<div class="tleaf"><span class="tkey">{{.Key}}</span><span class="tv {{.Kind}}">{{.Value}}</span></div>{{end}}</li>{{end}}

{{define "lane"}}<section class="lane"><h4><span class="lname">{{.Name}}</span><span class="chip">{{.Count}}</span>{{with .Note}}<span class="lnote">{{.}}</span>{{end}}</h4><ul class="kcards">{{range .Rows}}{{template "card" .}}{{else}}<li class="none">{{t "wb.none"}}</li>{{end}}</ul></section>{{end}}

{{define "card"}}<li class="kcard"><span class="ctitle"{{if and (not .Link) (not .IsAction) .Path}} title="{{.Path}}"{{end}}>{{with .Label}}<span class="chip cat {{.}}">{{.}}</span>{{end}}{{if .Link}}<a href="{{href .Link}}">{{.Text}}</a>{{else if .IsAction}}<a{{actionAttrs .}}>{{.Text}}</a>{{else}}{{.Text}}{{end}}</span>{{with .Sub}}<span class="csub" title="{{.}}">{{.}}</span>{{end}}</li>{{end}}

{{define "row"}}{{if .State}}<li class="{{.State}}"{{with .Label}} title="{{.}}"{{end}}><span class="box">{{icon (box .State)}}</span><span>{{template "rowtext" .}}</span></li>{{else}}<li class="keyed">{{with .Label}}<code>{{.}}</code>{{end}}<span>{{template "rowtext" .}}</span></li>{{end}}{{end}}

{{define "rowtext"}}{{if .Link}}<a href="{{href .Link}}">{{.Text}}</a>{{else if .IsAction}}<a{{actionAttrs .}}>{{.Text}}</a>{{else}}{{.Text}}{{with .Path}} <code class="fpath">{{.}}</code>{{end}}{{end}}{{end}}

{{define "reply"}}{{if or .Answerable .Topics}}<div class="reply{{if not .BulkAck}} solo{{end}}"{{if not .Answerable}} data-idle hidden{{end}}>{{if .BulkAck}}<label class="allok" title="{{t "wb.allok"}}"><input type="checkbox" id="ack-all">{{icon "check"}}{{.CountBulk}}</label>{{end}}<textarea id="reply-text" readonly placeholder="(nn) a; (mm) ok"></textarea><button class="btn primary" id="reply-copy" title="{{t "wb.copy"}}">{{icon "copy"}}</button><span class="hint" id="reply-hint"></span></div>{{end}}{{end}}
