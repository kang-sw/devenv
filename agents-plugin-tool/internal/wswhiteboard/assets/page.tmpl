{{define "page"}}<!DOCTYPE html>
<html{{if .Full}} data-stamp="{{.StampFile}}" data-seq="{{.Seq}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Whiteboard - {{.ReplyID}}</title>
<style>{{.CSS}}</style></head>
<body class="{{if .Full}}full{{else}}embed{{end}}">{{.Sprite}}<div class="wrap">
{{if .Full}}<div class="banner" id="wb-banner" title="board updated; reload deferred while you answer">{{icon "reload"}}</div>
{{end}}<div class="top"><h1>Whiteboard</h1><span class="meta">{{.ReplyID}} · #{{.Seq}}</span><span class="counts">{{with .CountPolicy}}<span class="chip policy" title="to answer">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAssumed}}<span class="chip assumed" title="assumed">{{icon "arrow"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="to acknowledge">{{icon "check"}}{{.}}</span>{{end}}{{if .Embed}}{{with .CountFresh}}<span class="chip fresh" title="new since the previous embed"><span class="new"></span>{{.}}</span>{{end}}{{end}}</span></div>
{{if .Full}}<div class="grid{{if not .Panels}} solo{{end}}"><main>{{template "board" .}}</main>{{if .Panels}}<aside class="side">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</aside>{{end}}</div>
{{else}}{{template "board" .}}{{if .Panels}}<div class="side flat">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</div>{{end}}
{{end}}</div>
<script>{{.Script}}</script>
{{if .Mermaid}}<script src="{{.MermaidFile}}"></script>
<script>{{.MermaidInit}}</script>
{{end}}</body></html>
{{end}}

{{define "board"}}{{template "now" .}}{{range .Topics}}{{template "topic" ($.TopicOf .)}}{{end}}{{template "reply" .}}{{end}}

{{define "now"}}{{if .Now}}<details class="now{{if not .NowFresh}} stale{{end}}" id="wb-now"{{if .NowFresh}} open{{end}}><summary title="now">{{icon "now"}}<span class="label">NOW</span>{{if and .Embed .NowFresh}}<span class="new" title="new since the previous embed"></span>{{end}}</summary><div class="now-body md">{{.NowHTML}}</div></details>{{end}}{{end}}

{{define "topic"}}<section class="topic{{if .Quiet}} quiet{{end}}{{if .Closed}} closed{{end}}"><div class="tbar"><span class="tname"{{if .Closed}} title="closed"{{end}}>{{.Name}}</span>{{if .Page.Embed}}{{with .Fresh}}<span class="chip fresh" title="new since the previous embed"><span class="new"></span>{{.}}</span>{{end}}{{end}}{{with len .Policy}}<span class="chip policy" title="to answer">{{icon "ask"}}{{.}}</span>{{end}}{{with len .Assumed}}<span class="chip assumed" title="assumed, confirm or correct">{{icon "arrow"}}{{.}}</span>{{end}}{{with len .Acks}}<span class="chip ok" title="to acknowledge">{{icon "check"}}{{.}}</span>{{end}}{{if .Quiet}}{{template "settled" .}}{{end}}</div>{{if not .Quiet}}<div class="tbody">{{range .Policy}}{{template "policy" ($.Page.ItemOf .)}}{{end}}{{range .Assumed}}{{template "assumed" ($.Page.ItemOf .)}}{{end}}{{if .Acks}}<div class="acks">{{range .Acks}}{{template "ack" ($.Page.ItemOf .)}}{{end}}</div>{{end}}{{template "settled" .}}</div>{{end}}</section>
{{end}}

{{define "settled"}}{{if .SettledCount}}<details class="settled"{{if .Expanded}} open{{end}}><summary title="settled">{{icon "list"}}{{.SettledCount}}</summary>{{range .Expanded}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{if .Expanded}}{{with .Collapsed}}<details class="more"><summary title="older settled items">+{{len .}}</summary>{{range .}}{{template "srow" ($.Page.ItemOf .)}}{{end}}</details>{{end}}{{else}}{{range .Collapsed}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{end}}</details>{{end}}{{end}}

{{define "newdot"}}{{if .IsNew}}<span class="new" title="new since the previous embed"></span>{{end}}{{end}}

{{define "text"}}{{range .}}{{if .Ref}}<a href="#item-{{.Ref}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}{{end}}

{{define "ctx"}}{{with .Rationale}}<div class="ctx md">{{$.Page.Block .}}</div>{{end}}{{end}}

{{define "links"}}{{with .Links}}<span class="links">{{range .}}<span class="link">{{icon "link"}}{{template "text" ($.Parts .)}}</span>{{end}}</span>{{end}}{{end}}

{{define "policy"}}<div class="card policy" id="item-{{.ID}}" data-id="{{.Num}}">
  <div class="cbar"><span class="head"><span class="id">{{.Label}}</span><span class="cls">policy</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span><button class="btn mini note-toggle" title="note">{{icon "pen"}}</button></div>
  <div class="cbody">{{template "ctx" .}}{{template "links" .}}{{with .Options}}{{if $.Stacked}}<div class="opts stack">{{range .}}<div class="opt{{if .Recommended}} rec{{end}}" role="button" tabindex="0" data-opt="{{.Letter}}" aria-pressed="false"><span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><div class="md">{{$.Page.Block .Text}}</div></div>{{end}}</div>{{else}}<div class="opts">{{range .}}<button class="opt{{if .Recommended}} rec{{end}}" data-opt="{{.Letter}}" aria-pressed="false"><span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><span>{{$.Page.Block .Text}}</span></button>{{end}}</div>{{end}}{{end}}{{if .RecLetter}}
  <div class="rec-line md" title="recommendation"><b>{{icon "star"}}{{.RecLetter}}</b> {{.Page.Block .RecText}}</div>{{end}}
  <textarea class="note" rows="1" placeholder="✎" title="note" hidden></textarea></div>
</div>{{end}}

{{define "assumed"}}<div class="card assumed" id="item-{{.ID}}" data-id="{{.Num}}">
  <div class="cbar"><span class="head"><span class="id">{{.Label}}</span><span class="cls">assumed</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>
    <span class="actions"><button class="btn mini note-toggle" title="note">{{icon "pen"}}</button><button class="btn mini" data-v="ok" aria-pressed="false" title="confirm">{{icon "check"}}</button><button class="btn mini" data-v="no" aria-pressed="false" title="correct">{{icon "x"}}</button></span></div>
  <div class="cbody">{{template "ctx" .}}{{with .Options}}{{if $.Stacked}}<div class="opts stack">{{range .}}<div class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}"><span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><div class="md">{{$.Page.Block .Text}}</div></div>{{end}}</div>{{else}}<div class="opts">{{range .}}<span class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}"><span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><span>{{$.Page.Block .Text}}</span></span>{{end}}</div>{{end}}{{end}}<div class="read"><span class="lead-read" title="the lead's reading">{{icon "arrow"}}<b>{{if .AnswerLetter}}{{.AnswerLetter}}{{else}}{{template "text" (.Parts .Answer)}}{{end}}</b>{{if .AnswerLetter}}{{with .AnswerText}} {{template "text" ($.Parts .)}}{{end}}{{end}}</span>{{with .AnswerQuote}}<span class="quote" title="your words">“{{.}}”</span>{{end}}</div>{{template "links" .}}
  <textarea class="note" rows="1" placeholder="✎" title="correction" hidden></textarea></div>
</div>{{end}}

{{define "ack"}}<div class="arow" id="item-{{.ID}}" data-id="{{.Num}}"><label class="ack"><input type="checkbox" data-id="{{.Num}}"><span class="atext"><span class="head"><span class="id">{{.Label}}</span><span class="tag {{.Class}}">{{.Class}}</span>{{template "newdot" .}}<span class="title">{{.Page.Inline .Title}}</span></span>{{range lines .Rationale}}<span class="why">{{$.Page.Inline .}}</span>{{end}}{{template "links" .}}</span></label><button class="btn mini note-toggle" title="note">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="note" hidden></textarea></div>{{end}}

{{define "srow"}}<div class="srow{{if .Void}} void{{end}}" id="item-{{.ID}}"><span class="stext"><span class="id"{{if .Void}} title="{{.Status}}"{{end}}>{{.Label}}</span>{{template "newdot" .}}<b>{{.Page.Inline .Title}}</b>{{with .PickedOption}} <span class="pick" title="picked"><span class="k">{{.Letter}}</span>{{$.Page.FirstLine .Text}}</span>{{end}}{{with .Reading}} <span class="ans" title="the lead's reading">{{template "text" ($.Parts .)}}</span>{{end}}{{with .AnswerQuote}} <span class="quote" title="your words">“{{.}}”</span>{{end}}{{template "links" .}}</span></div>{{end}}

{{define "panel"}}<details class="panel" id="p-{{.ID}}"{{if .Page.Full}} open{{end}}><summary>{{icon .IconName}}{{.Title}}{{with .Count}}<span class="chip">{{.}}</span>{{end}}</summary><div class="body">{{with .Lanes}}<div class="lanes">{{range .}}{{template "lane" .}}{{end}}</div>{{end}}{{if .Rows}}<ul class="rows">{{range .Rows}}{{template "row" .}}{{end}}</ul>{{end}}{{with .Folded}}<details class="folded"><summary class="chip" title="done">done {{len .}}</summary><ul class="rows">{{range .}}{{template "row" .}}{{end}}</ul></details>{{end}}</div></details>{{end}}

{{define "lane"}}<section class="lane"><h4><span class="lname">{{.Name}}</span><span class="chip">{{.Count}}</span>{{with .Note}}<span class="lnote">{{.}}</span>{{end}}</h4><ul class="kcards">{{range .Rows}}{{template "card" .}}{{else}}<li class="none">none</li>{{end}}</ul></section>{{end}}

{{define "card"}}<li class="kcard"><span class="ctitle"{{if and (not .Link) .Path}} title="{{.Path}}"{{end}}>{{with .Label}}<span class="chip cat {{.}}">{{.}}</span>{{end}}{{if .Link}}<a href="{{href .Link}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}</span>{{with .Sub}}<span class="csub" title="{{.}}">{{.}}</span>{{end}}</li>{{end}}

{{define "row"}}{{if .State}}<li class="{{.State}}"{{with .Label}} title="{{.}}"{{end}}><span class="box">{{icon (box .State)}}</span><span>{{template "rowtext" .}}</span></li>{{else}}<li class="keyed">{{with .Label}}<code>{{.}}</code>{{end}}<span>{{template "rowtext" .}}</span></li>{{end}}{{end}}

{{define "rowtext"}}{{if .Link}}<a href="{{href .Link}}">{{.Text}}</a>{{else}}{{.Text}}{{with .Path}} <code class="fpath">{{.}}</code>{{end}}{{end}}{{end}}

{{define "reply"}}{{if .Answerable}}<div class="reply{{if not .BulkAck}} solo{{end}}">{{if .BulkAck}}<label class="allok" title="acknowledge every technical/announced item and confirm every assumed one"><input type="checkbox" id="ack-all">{{icon "check"}}{{.CountBulk}}</label>{{end}}<textarea id="reply-text" readonly placeholder="(nn) a; (mm) ok"></textarea><button class="btn primary" id="reply-copy" title="copy answers">{{icon "copy"}}</button><span class="hint" id="reply-hint"></span></div>{{end}}{{end}}
