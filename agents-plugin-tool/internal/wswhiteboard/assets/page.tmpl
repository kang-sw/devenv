{{define "page"}}<!DOCTYPE html>
<html{{if .Full}} data-stamp="{{.StampFile}}" data-seq="{{.Seq}}"{{end}}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Whiteboard - {{.ReplyID}}</title>
<style>{{.CSS}}</style></head>
<body class="{{if .Full}}full{{else}}embed{{end}}">{{.Sprite}}<div class="wrap">
{{if .Full}}<div class="banner" id="wb-banner" title="board updated; reload deferred while you answer">{{icon "reload"}}</div>
{{end}}<div class="top"><h1>Whiteboard</h1><span class="meta">{{.ReplyID}} · #{{.Seq}}</span><span class="counts">{{with .CountPolicy}}<span class="chip policy" title="to answer">{{icon "ask"}}{{.}}</span>{{end}}{{with .CountAssumed}}<span class="chip assumed" title="assumed">{{icon "arrow"}}{{.}}</span>{{end}}{{with .CountAcks}}<span class="chip ok" title="to acknowledge">{{icon "check"}}{{.}}</span>{{end}}{{if .Embed}}{{with .CountFresh}}<span class="chip fresh" title="new since the previous embed"><span class="new"></span>{{.}}</span>{{end}}{{end}}</span></div>
{{if .Full}}<div class="grid{{if not .Panels}} solo{{end}}"><main>{{template "board" .}}</main>{{if .Panels}}<aside class="side">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</aside>{{end}}</div>
{{else}}{{template "board" .}}{{if .Panels}}<div class="side flat">{{range .Panels}}{{template "panel" ($.PanelOf .)}}{{end}}</div>{{end}}
{{end}}</div>
<script>{{.Script}}</script>
</body></html>
{{end}}

{{define "board"}}{{if .NowAbove}}{{template "now" .}}{{end}}{{range .Topics}}{{template "topic" ($.TopicOf .)}}{{end}}{{if .Full}}{{if not .NowAbove}}{{template "now" .}}{{end}}{{template "reply" .}}{{else}}{{template "reply" .}}{{if not .NowAbove}}{{template "now" .}}{{end}}{{end}}{{end}}

{{define "now"}}{{if .Now}}<details class="now" id="wb-now" open><summary title="now">{{icon "now"}}{{if and .Embed .NowAbove}}<span class="new" title="new since the previous embed"></span>{{end}}</summary><div class="now-body">{{.NowHTML}}</div></details>{{end}}{{end}}

{{define "topic"}}<section class="topic{{if .Quiet}} quiet{{end}}{{if .Closed}} closed{{end}}"><div class="tbar"><span class="tname"{{if .Closed}} title="closed"{{end}}>{{.Name}}</span>{{if .Page.Embed}}{{with .Fresh}}<span class="chip fresh" title="new since the previous embed"><span class="new"></span>{{.}}</span>{{end}}{{end}}{{with len .Policy}}<span class="chip policy" title="to answer">{{icon "ask"}}{{.}}</span>{{end}}{{with len .Assumed}}<span class="chip assumed" title="assumed, confirm or correct">{{icon "arrow"}}{{.}}</span>{{end}}{{with len .Acks}}<span class="chip ok" title="to acknowledge">{{icon "check"}}{{.}}</span>{{end}}{{if .Quiet}}{{template "settled" .}}{{end}}</div>{{if not .Quiet}}<div class="tbody">{{range .Policy}}{{template "policy" ($.Page.ItemOf .)}}{{end}}{{range .Assumed}}{{template "assumed" ($.Page.ItemOf .)}}{{end}}{{if .Acks}}<div class="acks">{{range .Acks}}{{template "ack" ($.Page.ItemOf .)}}{{end}}</div>{{end}}{{template "settled" .}}</div>{{end}}</section>
{{end}}

{{define "settled"}}{{if .SettledCount}}<details class="settled"{{if .Expanded}} open{{end}}><summary title="settled">{{icon "list"}}{{.SettledCount}}</summary>{{range .Expanded}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{if .Expanded}}{{with .Collapsed}}<details class="more"><summary title="older settled items">+{{len .}}</summary>{{range .}}{{template "srow" ($.Page.ItemOf .)}}{{end}}</details>{{end}}{{else}}{{range .Collapsed}}{{template "srow" ($.Page.ItemOf .)}}{{end}}{{end}}</details>{{end}}{{end}}

{{define "newdot"}}{{if .IsNew}}<span class="new" title="new since the previous embed"></span>{{end}}{{end}}

{{define "text"}}{{range .}}{{if .Ref}}<a href="#item-{{.Ref}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}{{end}}

{{define "ctx"}}{{with lines .Rationale}}<ul class="ctx">{{range .}}<li>{{template "text" ($.Parts .)}}</li>{{end}}</ul>{{end}}{{end}}

{{define "links"}}{{with .Links}}<span class="links">{{range .}}<span class="link">{{icon "link"}}{{template "text" ($.Parts .)}}</span>{{end}}</span>{{end}}{{end}}

{{define "policy"}}<div class="card policy" id="item-{{.ID}}" data-id="{{.Num}}">
  <div class="cbar"><span class="id">{{.Label}}</span><span class="cls">policy</span>{{template "newdot" .}}<span class="title">{{template "text" (.Parts .Title)}}</span><button class="btn mini note-toggle" title="note">{{icon "pen"}}</button></div>
  <div class="cbody">{{template "ctx" .}}{{template "links" .}}{{with .Options}}<div class="opts">{{range .}}<button class="opt{{if .Recommended}} rec{{end}}" data-opt="{{.Letter}}" aria-pressed="false"><span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><span>{{template "text" ($.Parts .Text)}}</span></button>{{end}}</div>{{end}}{{if .RecLetter}}
  <div class="rec-line" title="recommendation"><b>{{icon "star"}}{{.RecLetter}}</b> {{template "text" (.Parts .RecText)}}</div>{{end}}
  <textarea class="note" rows="1" placeholder="✎" title="note" hidden></textarea></div>
</div>{{end}}

{{define "assumed"}}<div class="card assumed" id="item-{{.ID}}" data-id="{{.Num}}">
  <div class="cbar"><span class="id">{{.Label}}</span><span class="cls">assumed</span>{{template "newdot" .}}<span class="title">{{template "text" (.Parts .Title)}}</span>
    <span class="actions"><button class="btn mini note-toggle" title="note">{{icon "pen"}}</button><button class="btn mini" data-v="ok" aria-pressed="false" title="confirm">{{icon "check"}}</button><button class="btn mini" data-v="no" aria-pressed="false" title="correct">{{icon "x"}}</button></span></div>
  <div class="cbody">{{template "ctx" .}}{{with .Options}}<div class="opts">{{range .}}<span class="opt static{{if .Recommended}} rec{{end}}{{if .Picked}} picked{{end}}"><span class="k">{{.Letter}}{{if .Recommended}}{{icon "star"}}{{end}}</span><span>{{template "text" ($.Parts .Text)}}</span></span>{{end}}</div>{{end}}<div class="read"><span class="lead-read" title="the lead's reading">{{icon "arrow"}}<b>{{if .AnswerLetter}}{{.AnswerLetter}}{{else}}{{template "text" (.Parts .Answer)}}{{end}}</b>{{if .AnswerLetter}}{{with .AnswerText}} {{template "text" ($.Parts .)}}{{end}}{{end}}</span>{{with .AnswerQuote}}<span class="quote" title="your words">“{{.}}”</span>{{end}}</div>{{template "links" .}}
  <textarea class="note" rows="1" placeholder="✎" title="correction" hidden></textarea></div>
</div>{{end}}

{{define "ack"}}<div class="arow" id="item-{{.ID}}" data-id="{{.Num}}"><label class="ack"><input type="checkbox" data-id="{{.Num}}"><span class="id">{{.Label}}</span><span class="tag {{.Class}}">{{.Class}}</span>{{template "newdot" .}}<span class="atext"><span>{{template "text" (.Parts .Title)}}</span>{{range lines .Rationale}}<span class="why">{{template "text" ($.Parts .)}}</span>{{end}}{{template "links" .}}</span></label><button class="btn mini note-toggle" title="note">{{icon "pen"}}</button><textarea class="note" rows="1" placeholder="✎" title="note" hidden></textarea></div>{{end}}

{{define "srow"}}<div class="srow{{if .Void}} void{{end}}" id="item-{{.ID}}"><span class="id"{{if .Void}} title="{{.Status}}"{{end}}>{{.Label}}</span>{{template "newdot" .}}<span class="stext"><b>{{template "text" (.Parts .Title)}}</b>{{with .PickedOption}} <span class="pick" title="picked"><span class="k">{{.Letter}}</span>{{template "text" ($.Parts .Text)}}</span>{{end}}{{with .Reading}} <span class="ans" title="the lead's reading">{{template "text" ($.Parts .)}}</span>{{end}}{{with .AnswerQuote}} <span class="quote" title="your words">“{{.}}”</span>{{end}}{{template "links" .}}</span></div>{{end}}

{{define "panel"}}<details class="panel" id="p-{{.ID}}"{{if .Page.Full}} open{{end}}><summary>{{icon .IconName}}{{.Title}}{{with .Count}}<span class="chip">{{.}}</span>{{end}}</summary><div class="body"><ul class="rows">{{range .Rows}}{{if .State}}<li class="{{.State}}"{{with .Label}} title="{{.}}"{{end}}><span class="box">{{marker .State}}</span><span>{{.Text}}</span></li>{{else}}<li class="keyed">{{with .Label}}<code>{{.}}</code>{{end}}<span>{{.Text}}</span></li>{{end}}{{end}}</ul></div></details>{{end}}

{{define "reply"}}{{if .Answerable}}<div class="reply{{if not .BulkAck}} solo{{end}}">{{if .BulkAck}}<label class="allok" title="acknowledge every technical/announced item and confirm every assumed one"><input type="checkbox" id="ack-all">{{icon "check"}}{{.CountBulk}}</label>{{end}}<textarea id="reply-text" readonly placeholder="(nn) a; (mm) ok"></textarea><button class="btn primary" id="reply-copy" title="copy answers">{{icon "copy"}}</button><span class="hint" id="reply-hint"></span></div>{{end}}{{end}}
