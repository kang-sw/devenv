{
  "name": "ws",
  "version": "0.46.32",
  "description": "Codex-first ws workflow plugin candidate for host-neutral skills and project context.",
  "author": {
    "name": "kang-sw"
  },
  "repository": "https://github.com/kang-sw/devenv",
  "license": "MIT",
  "agents": [
    "./claude-agents/effort-low.md",
    "./claude-agents/effort-medium.md",
    "./claude-agents/effort-high.md",
    "./claude-agents/effort-xhigh.md",
    "./claude-agents/effort-max.md"
  ],
  "mcpServers": {
    "ws": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/ws-mcp-launcher.py",
        "serve",
        "--stdio"
      ],
      "env": {
        "WS_MCP_CLI_NAME": "ws-cli"
      },
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 600
    }
  }
}
