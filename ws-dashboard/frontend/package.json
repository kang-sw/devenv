{
  "name": "ws-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:routes": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/routeBasis.test.js",
    "test:api-error": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/apiError.test.js",
    "test:resource-model": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/resourceModel.test.js && node ./node_modules/.tmp/route-tests/resourceRefresh.test.js && node ./node_modules/.tmp/route-tests/linkedServers.test.js",
    "test:commands": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/commands.test.js",
    "test:root-picker": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/rootPicker.test.js",
    "test:workbench": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/workbench/workbenchModel.test.js && node ./node_modules/.tmp/route-tests/workbench/openRootLookup.test.js && node ./node_modules/.tmp/route-tests/workbench/layoutRestore.test.js",
    "test:work-root-files": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/workRootFiles.test.js",
    "test:work-root-activity": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/workRootActivity.test.js",
    "test:terminals": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/terminalCommandPlan.test.js && node ./node_modules/.tmp/route-tests/terminals.test.js && tsc -p tsconfig.e2e-tests.json && node ./node_modules/.tmp/e2e-tests/e2e/daemonHarness.test.js",
    "test:browser": "npm run build && (cd .. && cargo build -p ws-dashboard-daemon) && playwright test",
    "test:open-work-root": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/openWorkRoot.test.js",
    "test:document-viewer": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/documentViewer.test.js && node ./node_modules/.tmp/route-tests/documentRawEditor.test.js",
    "test:git": "tsc -p tsconfig.route-tests.json && node ./node_modules/.tmp/route-tests/gitToolbar.test.js && node ./node_modules/.tmp/route-tests/gitWorktreeAdd.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockview": "^6.2.2",
    "lucide-react": "^1.16.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "19.2.6",
    "react-aria-components": "^1.17.0",
    "react-dom": "19.2.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  }
}
