{
  "name": "wsflow",
  "version": "0.36.2",
  "description": "Agentless workflow plugin for project context, tickets, specs, docs, and Git tools.",
  "author": {
    "name": "kang-sw"
  },
  "repository": "https://github.com/kang-sw/devenv",
  "license": "MIT",
  "mcpServers": {
    "wsflow": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/ws-mcp-launcher.py",
        "serve",
        "--stdio"
      ],
      "env": {
        "WS_MCP_NO_AGENT": "1",
        "WS_MCP_NAMESPACE": "wsflow",
        "WS_MCP_SETUP_TOOL": "setup"
      },
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 600
    }
  }
}
